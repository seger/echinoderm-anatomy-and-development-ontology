SubClassOf(<http://purl.obolibrary.org/obo/ECAO_1000045> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/ECAO_1000065>))
SubClassOf(<http://purl.obolibrary.org/obo/ECAO_1000045> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000062> <http://purl.obolibrary.org/obo/ECAO_1000043>))
SubClassOf(<http://purl.obolibrary.org/obo/ECAO_1000045> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000062> <http://purl.obolibrary.org/obo/ECAO_1000044>))

