AnnotationAssertion(<http://purl.obolibrary.org/obo/RO_0002175> <http://purl.obolibrary.org/obo/ECAO_2000103> <http://purl.obolibrary.org/obo/NCBITaxon_7656>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/RO_0002175> <http://purl.obolibrary.org/obo/ECAO_2000103> <http://purl.obolibrary.org/obo/NCBITaxon_7668>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/ECAO_2000103> "echinoderm_anatomy")
