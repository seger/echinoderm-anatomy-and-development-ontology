SubClassOf(<http://purl.obolibrary.org/obo/ECAO_2000103> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/ecao#existence_starts_during> <http://purl.obolibrary.org/obo/ECAO_1000047>))
