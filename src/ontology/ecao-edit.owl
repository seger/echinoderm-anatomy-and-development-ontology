SubClassOf(<http://purl.obolibrary.org/obo/ECAO_1000043> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000062> <http://purl.obolibrary.org/obo/ECAO_1000042>))

# Class: <http://purl.obolibrary.org/obo/ECAO_1000044> (very late organogenesis stage)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ECAO_1000044> "Stage at which the embryo displays prominent right and left anterior coelomic pouches, and the posterior enterocoel has enlarged. Pronounced cardiac and developing pyloric constrictions (separating respectively the foregut and midgut, and the midgut and hindgut) are formed, and the gut is thus visibly tripartite, with the posterior enterocoel projecting from the developing stomach (former midgut). The wall of the left anterior coelom is distended at both its anterior and posterior margins, where strands of cells extend to the ectoderm. Muscle bands surrounding the esophagus are apparent. Ridges of thickened ectoderm mark the positions of the future ciliary bands.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/RO_0002161> <http://purl.obolibrary.org/obo/ECAO_1000044> <http://purl.obolibrary.org/obo/NCBITaxon_7632>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/RO_0002161> <http://purl.obolibrary.org/obo/ECAO_1000044> <http://purl.obolibrary.org/obo/NCBITaxon_7654>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/RO_0002161> <http://purl.obolibrary.org/obo/ECAO_1000044> <http://purl.obolibrary.org/obo/NCBITaxon_7656>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/RO_0002161> <http://purl.obolibrary.org/obo/ECAO_1000044> <http://purl.obolibrary.org/obo/NCBITaxon_7668>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/RO_0002175> <http://purl.obolibrary.org/obo/ECAO_1000044> <http://purl.obolibrary.org/obo/NCBITaxon_46514>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/ECAO_1000044> "echinoderm_developmental_stage")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/ECAO_1000044> "VLO")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/ECAO_1000044> "ECAO:1000044")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ECAO_1000044> "very late organogenesis stage")
SubClassOf(<http://purl.obolibrary.org/obo/ECAO_1000044> <http://purl.obolibrary.org/obo/ECAO_1000006>)
SubClassOf(<http://purl.obolibrary.org/obo/ECAO_1000044> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/ECAO_1000014>))
SubClassOf(<http://purl.obolibrary.org/obo/ECAO_1000044> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/ECAO_1000064>))
SubClassOf(<http://purl.obolibrary.org/obo/ECAO_1000044> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000062> <http://purl.obolibrary.org/obo/ECAO_1000043>))

# Class: <http://purl.obolibrary.org/obo/ECAO_1000045> (open mouth stage)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/ECAO_1000045> "Stage that is characterized by the opening of the mouth. The right and left coelomic pouches are prominent and well-separated from the foregut by narrow coelomic constrictions. Pronounced cardiac and developing pyloric constrictions (separating respectively the foregut and midgut, and the midgut and hindgut) are visible; the gut is thus visibly tripartite. The developing stomach (former midgut) is enlarged relative to the other segments of the gut and muscle bands surrounding the esophagus are apparent. The ciliary band(s) is (are) also discernable.")
AnnotationAssertion(<http://purl.obolibrary.org/obo/RO_0002175> <http://purl.obolibrary.org/obo/ECAO_1000045> <http://purl.obolibrary.org/obo/NCBITaxon_46514>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/RO_0002175> <http://purl.obolibrary.org/obo/ECAO_1000045> <http://purl.obolibrary.org/obo/NCBITaxon_7632>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/RO_0002175> <http://purl.obolibrary.org/obo/ECAO_1000045> <http://purl.obolibrary.org/obo/NCBITaxon_7654>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/RO_0002175> <http://purl.obolibrary.org/obo/ECAO_1000045> <http://purl.obolibrary.org/obo/NCBITaxon_7656>)
AnnotationAssertion(<http://purl.obolibrary.org/obo/RO_0002175> <http://purl.obolibrary.org/obo/ECAO_1000045> <http://purl.obolibrary.org/obo/NCBITaxon_7668>)
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/ECAO_1000045> "doi:10.1086/BBLv222n2p105")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/ECAO_1000045> "doi:10.3389/fcell.2022.966408")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/ECAO_1000045> "echinoderm_developmental_stage")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/ECAO_1000045> "OM")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/ECAO_1000045> "early pluteus stage")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym> <http://purl.obolibrary.org/obo/ECAO_1000045> "two-arm plutei with open mouths")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/ECAO_1000045> "ECAO:1000045")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ECAO_1000045> "open mouth stage")
