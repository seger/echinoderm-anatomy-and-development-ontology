AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasOBONamespace> <http://purl.obolibrary.org/obo/ECAO_1000011> "echinoderm_developmental_stage")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#id> <http://purl.obolibrary.org/obo/ECAO_1000011> "ECAO:1000011")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/ECAO_1000011> "cleavage period")
SubClassOf(<http://purl.obolibrary.org/obo/ECAO_1000011> <http://purl.obolibrary.org/obo/ECAO_1000004>)
