[Term]
id: ECAO:2000484
name: presumptive endoderm
def: "The region of the early embryo that will develop into endoderm." []
synonym: "prospective endoderm" RELATED []
xref: UBERON:0006595
is_a: ECAO:2000018 ! embryonic region
relationship: develops_from ECAO:2000147 ! macromere daughter cell tier
relationship: part_of ECAO:2000053 ! vegetal hemisphere

[Term]
id: ECAO:2000485
name: endoderm
def: "The innermost primary germ layer, which forms during gastrulation and will give rise to internal tissues such as the digestive tract." []
xref: UBERON:0000925
is_a: ECAO:2000162 ! germ layer
relationship: develops_from ECAO:2000484 ! presumptive endoderm
relationship: part_of ECAO:2000006 ! multicellular organism

[Term]
id: ECAO:2000486
name: enoderm cell
