format-version: 1.2
import: http://purl.obolibrary.org/obo/ecao/imports/bfo_import.owl
import: http://purl.obolibrary.org/obo/ecao/imports/ro_import.owl
ontology: ecao
property_value: http://purl.org/dc/elements/1.1/title "Echinoderm Anatomy and Development Ontology" xsd:string
property_value: http://purl.org/dc/terms/license https://creativecommons.org/licenses/by/3.0/

[Term]
id: ECAO:1000000
name: Echinoderm anatomy and development

[Term]
id: ECAO:1000001
name: developmental stage
def: "A temporal interval that defines echinoderm life from unfertilized egg to adult stage." []
is_a: ECAO:1000000 ! Echinoderm anatomy and development

[Term]
id: ECAO:1000002
name: life cycle
def: "The entire span of an organism's life." []
is_a: ECAO:1000001 ! developmental stage

[Term]
id: ECAO:1000003
name: life cycle phase
def: "A temporal phase encompassing some part of the life cycle of an organism." []
is_a: ECAO:1000001 ! developmental stage
relationship: BFO:0000050 ECAO:1000002 ! part of life cycle

[Term]
id: ECAO:1000004
name: life cycle period
def: "A temporal period included in a life cycle phase." []
is_a: ECAO:1000001 ! developmental stage
relationship: BFO:0000050 ECAO:1000003 ! part of life cycle phase

[Term]
id: ECAO:1000005
name: life cycle episode
def: "A temporal episode encompassing some part of a life cycle period." []
is_a: ECAO:1000001 ! developmental stage
relationship: BFO:0000050 ECAO:1000004 ! part of life cycle period

[Term]
id: ECAO:1000006
name: life cycle stage
def: "A spatiotemporal region encompassing some part of the life cycle of an organism." []
is_a: ECAO:1000001 ! developmental stage

[Term]
id: ECAO:1000007
name: gametogenesis phase
def: "The phase of the life cycle characterized by the biological process in which certain cells of a female or male individual (parent) are transformed into specialized reproductive cells (gametes) that will initiate development of a progeny individual (offspring) upon fertilization." []
is_a: ECAO:1000003 ! life cycle phase

[Term]
id: ECAO:1000008
name: embryogenesis phase
def: "The phase of the life cycle that begins with fertilization, continues with the formation and maturation of the embryo, and ends with the opening of the mouth, the onset of feeding, and the beginning of the growth of the organism." []
xref: UBERON:0000105
is_a: ECAO:1000003 ! life cycle phase
relationship: BFO:0000062 ECAO:1000007 ! preceded by gametogenesis phase

[Term]
id: ECAO:1000009
name: larval development phase
def: "The phase of the life cycle that begins when the mouth opens and the larva starts to feed, continues through the growth and maturation of the larva, and ends with metamorphosis." []
is_a: ECAO:1000003 ! life cycle phase
relationship: BFO:0000062 ECAO:1000008 ! preceded by embryogenesis phase

[Term]
id: ECAO:1000010
name: adulthood phase
def: "The phase of the life cycle that begins after metamorphosis, continues through the growth and maturation of the juvenile, and culminates in the formation of a sexually mature adult that produces functional gametes." []
is_a: ECAO:1000003 ! life cycle phase
relationship: BFO:0000062 ECAO:1000009 ! preceded by larval development phase

[Term]
id: ECAO:1000011
name: cleavage period
def: "The period that immediately follows fertilization. It is characterized by rapid, synchronous mitotic cell divisions in the absence of cell growth. This period culminates in the formation of a hollow, spherical, multicellular, monolayered embryo (a blastula) with a hollow cavity (the blastocoel) in the center." []
xref: UBERON:0000107
is_a: ECAO:1000004 ! life cycle period
relationship: BFO:0000050 ECAO:1000008 ! part of embryogenesis phase
relationship: BFO:0000062 ECAO:1000017 ! preceded by 1-cell stage

[Term]
id: ECAO:1000012
name: blastula period
def: "The period that immediately follows cleavage and precedes gastrulation. It is characterized by the progressive maturation of the embryo into a hollow sphere, which is one cell layer thick and encompasses a central, fluid-filled cavity (the blastocoel). This period culminates in the formation of the vegetal plate, a placode of elongated, presumptive endomesoderm cells." []
xref: UBERON:0000307
is_a: ECAO:1000004 ! life cycle period
relationship: BFO:0000050 ECAO:1000008 ! part of embryogenesis phase
relationship: BFO:0000062 ECAO:1000011 ! preceded by cleavage period

[Term]
id: ECAO:1000013
name: gastrula period
def: "The period that immediately follows the blastula period and precedes organogenesis. It is characterized by extensive movements of cells in the vegetal region of the embryo. This period culminates in the formation of a multilayered embryo composed of three primary germ layers (ectoderm, mesoderm, and endoderm)." []
xref: UBERON:0000109
is_a: ECAO:1000004 ! life cycle period
relationship: BFO:0000050 ECAO:1000008 ! part of embryogenesis phase
relationship: BFO:0000062 ECAO:1000012 ! preceded by blastula period

[Term]
id: ECAO:1000014
name: organogenesis period
def: "The period that immediately follows the gastrula period. It is characterized by the progressive maturation of tissues and organs. This period culminates in the opening of the mouth." []
is_a: ECAO:1000004 ! life cycle period
relationship: BFO:0000050 ECAO:1000008 ! part of embryogenesis phase
relationship: BFO:0000062 ECAO:1000013 ! preceded by gastrula period

[Term]
id: ECAO:1000015
name: mesenchyme blastula episode
def: "The first episode of the gastrulation period, characterized by the ingression into the blastocoel of the skeletogenic primary mesenchyme cells (PMCs), prior to the invagination of the vegetal plate." []
is_a: ECAO:1000005 ! life cycle episode
relationship: BFO:0000050 ECAO:1000013 ! part of gastrula period
relationship: BFO:0000062 ECAO:1000031 ! preceded by vegetal plate stage

[Term]
id: ECAO:1000016
name: invagination episode
def: "The second episode of the gastrulation period, characterized by the invagination of the vegetal plate into the blastocoel to form the primitive digestive tract (archenteron)." []
is_a: ECAO:1000005 ! life cycle episode
relationship: BFO:0000050 ECAO:1000013 ! part of gastrula period
relationship: BFO:0000062 ECAO:1000015 ! preceded by mesenchyme blastula episode
relationship: BFO:0000062 ECAO:1000031 ! preceded by vegetal plate stage

[Term]
id: ECAO:1000017
name: 1-cell stage
def: "Stage at which fertilization has occurred, but the zygote has not undergone cell division. The embryo is a single diploid cell surrounded by a fertilization envelope." []
xref: UBERON:0000106
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000008 ! part of embryogenesis phase
relationship: BFO:0000050 ECAO:1000047 ! part of stage 1
relationship: BFO:0000062 ECAO:1000007 ! preceded by gametogenesis phase

[Term]
id: ECAO:1000018
name: 2-cell stage
def: "Stage at which the embryo is composed of two cells and is surrounded by a fertilization envelope. The first cleavage division has taken place meridionally (i.e. along the animal-vegetal axis), thereby generating two blastomeres of equal size, each containing both animal and vegetal cytoplasm." []
xref: UBERON:0007232
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000011 ! part of cleavage period
relationship: BFO:0000050 ECAO:1000048 ! part of stage 2
relationship: BFO:0000062 ECAO:1000017 ! preceded by 1-cell stage

[Term]
id: ECAO:1000019
name: 4-cell stage
def: "Stage at which the embryo is composed of four cells and is surrounded by a fertilization envelope. The second cleavage division has taken place meridional and perpendicular to the first cleavage division. This has produced four blastomeres of equal size, all of which contain both animal and vegetal cytoplasm." []
xref: UBERON:0007233
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000011 ! part of cleavage period
relationship: BFO:0000050 ECAO:1000049 ! part of stage 3
relationship: BFO:0000062 ECAO:1000018 ! preceded by 2-cell stage

[Term]
id: ECAO:1000020
name: 8-cell stage
def: "Stage at which the embryo is composed of eight cells and is surrounded by a fertilization envelope. The third cleavage division has taken place equatorial and perpendicular to the first two cleavage divisions." []
xref: UBERON:0007236
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000011 ! part of cleavage period
relationship: BFO:0000050 ECAO:1000050 ! part of stage 4
relationship: BFO:0000062 ECAO:1000019 ! preceded by 4-cell stage

[Term]
id: ECAO:1000021
name: 16-cell stage
def: "Stage at which the embryo is composed of 16 cells and is surrounded by a fertilization envelope." []
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000011 ! part of cleavage period
relationship: BFO:0000050 ECAO:1000051 ! part of stage 5
relationship: BFO:0000062 ECAO:1000020 ! preceded by 8-cell stage

[Term]
id: ECAO:1000022
name: 28-cell stage
def: "Stage at which the embryo is composed of 28 cells and is surrounded by a fertilization envelope." []
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000011 ! part of cleavage period
relationship: BFO:0000050 ECAO:1000052 ! part of stage 6
relationship: BFO:0000062 ECAO:1000021 ! preceded by 16-cell stage
property_value: RO:0002161 NCBITaxon:46514
property_value: RO:0002161 NCBITaxon:7632
property_value: RO:0002175 NCBITaxon:7654
property_value: RO:0002175 NCBITaxon:7656
property_value: RO:0002175 NCBITaxon:7668

[Term]
id: ECAO:1000023
name: 32-cell stage
def: "Stage at which the embryo is composed of 32 cells and is surrounded by a fertilization envelope." []
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000011 ! part of cleavage period
relationship: BFO:0000050 ECAO:1000052 ! part of stage 6
relationship: BFO:0000062 ECAO:1000021 ! preceded by 16-cell stage
relationship: BFO:0000062 ECAO:1000022 ! preceded by 28-cell stage

[Term]
id: ECAO:1000024
name: 56-cell stage
def: "Stage at which the embryo is composed of 56 cells and is surrounded by a fertilization envelope." []
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000011 ! part of cleavage period
relationship: BFO:0000050 ECAO:1000053 ! part of stage 7
relationship: BFO:0000062 ECAO:1000023 ! preceded by 32-cell stage

[Term]
id: ECAO:1000025
name: 60-cell stage
def: "Stage at which the embryo is composed of 60 cells and is surrounded by a fertilization envelope." []
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000011 ! part of cleavage period
relationship: BFO:0000050 ECAO:1000053 ! part of stage 7
relationship: BFO:0000062 ECAO:1000024 ! preceded by 56-cell stage

[Term]
id: ECAO:1000026
name: 64-cell stage
def: "Stage at which the embryo is composed of 64 cells and is surrounded by a fertilization envelope." []
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000011 ! part of cleavage period
relationship: BFO:0000050 ECAO:1000053 ! part of stage 7
relationship: BFO:0000062 ECAO:1000023 ! preceded by 32-cell stage

[Term]
id: ECAO:1000027
name: early blastula stage
def: "Stage at which the embryo is composed of about 100-200 cells and is surrounded by a fertilization envelope. Most blastomeres have completed at least one additional mitotic division since the 60- or 64-cell stage. All cells are approximately the same size and there are no obvious morphological indications of the primary or secondary embryonic axes. All cells have begun to acquire an apical-basal polarity and the embryo is beginning to transform into a hollow sphere with a monolayered epithelial wall and a fluid-filled cavity (the blastocoel) in the center." []
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000012 ! part of blastula period
relationship: BFO:0000050 ECAO:1000054 ! part of stage 8
relationship: BFO:0000062 ECAO:1000025 ! preceded by 60-cell stage
relationship: BFO:0000062 ECAO:1000026 ! preceded by 64-cell stage

[Term]
id: ECAO:1000028
name: mid-blastula stage
def: "Stage at which the embryo is composed of about 200-500 cells and is surrounded by a fertilization envelope. Most cells have completed at least one additional mitotic division since the early blastula stage. The cell divisions are now less synchronous than at earlier stages. The embryo remains spherical in shape and one cell layer thick. It does not display any morphological indications of the embryonic axes or of the vegetal plate. The cells have started to flatten on their inner (basal) surface, further contributing to the enlargement of the blastocoel, which has expanded since the early blastula stage." []
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000012 ! part of blastula period
relationship: BFO:0000050 ECAO:1000055 ! part of stage 9
relationship: BFO:0000062 ECAO:1000027 ! preceded by early blastula stage

[Term]
id: ECAO:1000029
name: motile blastula stage
def: "Stage at which the embryo is composed of 400-500 cells and is no longer surrounded by a fertilization envelope. Most cells have completed at least one additional mitotic division after the early blastula stage and the cell divisions are now less synchronous than at earlier stages. The embryo remains spherical in shape and one cell layer thick. It does not display any morphological indications of the embryonic axes or of the vegetal plate. The cells have started to flatten on their inner (basal) surface, further contributing to the enlargement of the blastocoel, which has expanded since the early blastula stage." []
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000012 ! part of blastula period
relationship: BFO:0000050 ECAO:1000055 ! part of stage 9
relationship: BFO:0000062 ECAO:1000027 ! preceded by early blastula stage

[Term]
id: ECAO:1000030
name: late blastula stage
def: "Stage at which the embryo is composed of about 600-1000 cells. Most cells have completed at least one additional mitotic division since the mid-blastula stage and developed an apical cilium. The embryo is still spherical in shape and one cell layer thick. It still lacks obvious morphological landmarks of the embryonic axes and of the vegetal plate. Cells have further continued to flatten along the apical-basal axis, accentuating the enlargement of the blastocoel. They are also now joined to one another apically by septate and adherens junctions and laterally by desmosomes." []
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000012 ! part of blastula period
relationship: BFO:0000050 ECAO:1000056 ! part of stage 10
relationship: BFO:0000062 ECAO:1000028 ! preceded by mid-blastula stage
relationship: BFO:0000062 ECAO:1000029 ! preceded by motile blastula stage

[Term]
id: ECAO:1000031
name: vegetal plate stage
def: "Stage at which the embryo displays a vegetal epithelial placode, the vegetal plate, that formed at the vegetal pole and thereby provides the first morphological indication of the animal-vegetal axis of the blastula. All cells have developed an apical cilium, although the embryo may or may not have hatched from the fertilization envelope." []
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000012 ! part of blastula period
relationship: BFO:0000050 ECAO:1000057 ! part of stage 11
relationship: BFO:0000062 ECAO:1000030 ! preceded by late blastula stage

[Term]
id: ECAO:1000032
name: early mesenchyme blastula stage
def: "Stage at which skeletogenic primary mesenchyme cells (PMCs) are starting to ingress from the vegetal plate into the blastocoel through an epithelial–to-mesenchymal transition (EMT)." []
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000015 ! part of mesenchyme blastula episode
relationship: BFO:0000050 ECAO:1000058 ! part of stage 12
relationship: BFO:0000062 ECAO:1000031 ! preceded by vegetal plate stage

[Term]
id: ECAO:1000033
name: mid-mesenchyme blastula stage
def: "Stage at which almost all skeletogenic primary mesenchyme cells (PMCs) have ingressed into the blastocoel and remain in a mound on the vegetal plate." []
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000015 ! part of mesenchyme blastula episode
relationship: BFO:0000050 ECAO:1000058 ! part of stage 12
relationship: BFO:0000062 ECAO:1000032 ! preceded by early mesenchyme blastula stage

[Term]
id: ECAO:1000034
name: late mesenchyme blastula stage
def: "Stage at which all skeletogenic primary mesenchyme cells (PMCs) have ingressed into the blastocoel. Many of these cells have extended filopodia and migrated away from the vegetal plate. The cells are found along the blastocoel wall, although they remain concentrated in the vegetal hemisphere of the embryo. The vegetal plate has flattened following the ingression of the PMCs. However, it has not started to invaginate. It is now composed at its center of the 8 small micromere descendants (the germ line) surrounded by non-skeletogenic mesoderm (NSM)." []
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000015 ! part of mesenchyme blastula episode
relationship: BFO:0000050 ECAO:1000058 ! part of stage 12
relationship: BFO:0000062 ECAO:1000033 ! preceded by mid-mesenchyme blastula stage

[Term]
id: ECAO:1000035
name: blastopore formation stage
def: "Stage at which the embryo is characterized morphologically by a slight invagination of the vegetal plate. This invagination has generated the anterior portion of the archenteron (primitive digestive tract) and the blastopore, an opening that will persist as the larval anus." []
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000016 ! part of invagination episode
relationship: BFO:0000050 ECAO:1000058 ! part of stage 12
relationship: BFO:0000062 ECAO:1000031 ! preceded by vegetal plate stage
relationship: BFO:0000062 ECAO:1000034 ! preceded by late mesenchyme blastula stage

[Term]
id: ECAO:1000036
name: early gastrula stage
def: "Stage at which the archenteron (primitive digestive tract) has elongated up to 1/3 of its final length. This elongation has occurred through the inward movement of all non-skeletogenic mesoderm (NSM) cells and part of the endoderm." []
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000016 ! part of invagination episode
relationship: BFO:0000050 ECAO:1000059 ! part of stage 13
relationship: BFO:0000062 ECAO:1000035 ! preceded by blastopore formation stage

[Term]
id: ECAO:1000037
name: mid-gastrula stage
def: "Stage at which the archenteron (primitive digestive tract) has elongated to about half (1/3-2/3) of its final length." []
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000016 ! part of invagination episode
relationship: BFO:0000050 ECAO:1000060 ! part of stage 14
relationship: BFO:0000062 ECAO:1000036 ! preceded by early gastrula stage

[Term]
id: ECAO:1000038
name: late gastrula stage
def: "Stage at which the archenteron (primitive digestive tract) has elongated up to more than 2/3 of its maximal length." []
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000016 ! part of invagination episode
relationship: BFO:0000050 ECAO:1000061 ! part of stage 15
relationship: BFO:0000062 ECAO:1000037 ! preceded by mid-gastrula stage

[Term]
id: ECAO:1000039
name: early prism stage
def: "Stage at which the embryo has a distinctive, angular shape due to the elongation of the skeletal rods. The body rods have elongated toward the apex (posterior end) of the embryo. The dorsoventral connecting rods are elongated, and the postoral rods are still very short although they already support thickened regions of ectoderm that will later form the distal tip of the postoral arms. The archenteron tip is slightly expanded, and its oral surface is directed toward the oral ectoderm. Ingression of secondary mesenchyme cells (SMCs) is complete. The embryo is reddish in color due to the presence of pigment cells within the aboral ectoderm. The animal pole domain (or apical plate) is prominent and the lateral walls of the embryo have thinned. The coelomic pouches and gut constrictions have not yet appeared." []
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000014 ! part of organogenesis period
relationship: BFO:0000050 ECAO:1000062 ! part of stage 16
relationship: BFO:0000062 ECAO:1000038 ! preceded by late gastrula stage

[Term]
id: ECAO:1000040
name: late prism stage
def: "Stage at which the embryo has a distinctive, angular shape due to the elongation of the skeletal rods. The body rods have expended even further compared to earlier stages and the postoral rods support short postoral arm buds. The anterior ends of the dorsoventral connecting rods are also now branched or bent. The archenteron tip is still bent toward the oral ectoderm. At the tip of the archenteron coelomic evaginations start to be apparent, although no gut constrictions are visible yet. The embryo is reddish in color due to the presence of pigment cells within the aboral ectoderm. The animal pole domain is prominent, and it still bears long, immotile cilia." []
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000014 ! part of organogenesis period
relationship: BFO:0000050 ECAO:1000063 ! part of stage 17
relationship: BFO:0000062 ECAO:1000039 ! preceded by early prism stage

[Term]
id: ECAO:1000041
name: early organogenesis stage
def: "Stage at which the embryo is elongated along the animal-vegetal axis and has thus a characteristic oblong shape. The archenteron is fully extended, even though it still does not reach the blastocoel roof. The tip of the archenteron is enlarged, rounded, and smooth, and the archenteron has begun to deflect orally. Mesenchyme cell ingression is complete. However, paired coelomic pouches and gut constrictions have not yet formed." []
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000014 ! part of organogenesis period
relationship: BFO:0000050 ECAO:1000062 ! part of stage 16
relationship: BFO:0000062 ECAO:1000038 ! preceded by late gastrula stage

[Term]
id: ECAO:1000042
name: mid-organogenesis stage
def: "Stage at which the embryo is elongated along the animal-vegetal axis and has thus a characteristic oblong shape. The archenteron is overall deflected orally and its tip is enlarged, rounded, and smooth. The tip of the archenteron is further starting to display filopodia that interact with the ectoderm site where the mouth will form. At the tip of the archenteron, unpaired evaginations of the coelom are also now apparent, even though the stomodeal invagination, gut constrictions, and ciliary band(s) are still not discernable. Mesenchyme cells have dispersed through the blastocoel." []
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000014 ! part of organogenesis period
relationship: BFO:0000050 ECAO:1000063 ! part of stage 17
relationship: BFO:0000062 ECAO:1000041 ! preceded by early organogenesis stage

[Term]
id: ECAO:1000043
name: late organogenesis stage
def: "Stage at which the embryo is characterized by the presence, at the tip of the archenteron, of two well-formed coelomic pouches, separated from the foregut by pronounced constrictions. The cardiac constriction, which separates the foregut and the midgut, has started to form. On the oral side of the embryo, the stomodeal invagination is visible, although the mouth has not yet opened. The ciliary band(s) is (are) not yet visible." []
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000014 ! part of organogenesis period
relationship: BFO:0000050 ECAO:1000064 ! part of stage 18
relationship: BFO:0000062 ECAO:1000040 ! preceded by late prism stage
relationship: BFO:0000062 ECAO:1000042 ! preceded by mid-organogenesis stage

[Term]
id: ECAO:1000044
name: very late organogenesis stage
def: "Stage at which the embryo displays prominent right and left anterior coelomic pouches, and the posterior enterocoel has enlarged. Pronounced cardiac and developing pyloric constrictions (separating respectively the foregut and midgut, and the midgut and hindgut) are formed, and the gut is thus visibly tripartite, with the posterior enterocoel projecting from the developing stomach (former midgut). The wall of the left anterior coelom is distended at both its anterior and posterior margins, where strands of cells extend to the ectoderm. Muscle bands surrounding the esophagus are apparent. Ridges of thickened ectoderm mark the positions of the future ciliary bands." []
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000014 ! part of organogenesis period
relationship: BFO:0000050 ECAO:1000064 ! part of stage 18
relationship: BFO:0000062 ECAO:1000043 ! preceded by late organogenesis stage

[Term]
id: ECAO:1000045
name: open mouth stage
def: "Stage that is characterized by the opening of the mouth. The right and left coelomic pouches are prominent and well-separated from the foregut by narrow coelomic constrictions. Pronounced cardiac and developing pyloric constrictions (separating respectively the foregut and midgut, and the midgut and hindgut) are visible; the gut is thus visibly tripartite. The developing stomach (former midgut) is enlarged relative to the other segments of the gut and muscle bands surrounding the esophagus are apparent. The ciliary band(s) is (are) also discernable." []
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000014 ! part of organogenesis period
relationship: BFO:0000050 ECAO:1000065 ! part of stage 19
relationship: BFO:0000062 ECAO:1000043 ! preceded by late organogenesis stage
relationship: BFO:0000062 ECAO:1000044 ! preceded by very late organogenesis stage

[Term]
id: ECAO:1000046
name: pan-echinoderm life cycle stage
def: "A specific developmental stage common to all echinoderms." []
is_a: ECAO:1000001 ! developmental stage

[Term]
id: ECAO:1000047
name: stage 1
def: "Echinoderm developmental stage at which fertilization has occurred but the zygote has not divided (1-cell stage)." []
is_a: ECAO:1000046 ! pan-echinoderm life cycle stage
relationship: BFO:0000050 ECAO:1000008 ! part of embryogenesis phase
relationship: BFO:0000062 ECAO:1000007 ! preceded by gametogenesis phase

[Term]
id: ECAO:1000048
name: stage 2
def: "Echinoderm developmental stage at which the embryo is composed of 2 cells (2-cell stage)." []
is_a: ECAO:1000046 ! pan-echinoderm life cycle stage
relationship: BFO:0000050 ECAO:1000011 ! part of cleavage period
relationship: BFO:0000062 ECAO:1000047 ! preceded by stage 1

[Term]
id: ECAO:1000049
name: stage 3
def: "Echinoderm developmental stage at which the embryo is composed of 4 cells (4-cell stage)." []
is_a: ECAO:1000046 ! pan-echinoderm life cycle stage
relationship: BFO:0000050 ECAO:1000011 ! part of cleavage period
relationship: BFO:0000062 ECAO:1000048 ! preceded by stage 2

[Term]
id: ECAO:1000050
name: stage 4
def: "Echinoderm developmental stage at which the embryo is composed of 8 cells (8-cell stage)." []
is_a: ECAO:1000046 ! pan-echinoderm life cycle stage
relationship: BFO:0000050 ECAO:1000011 ! part of cleavage period
relationship: BFO:0000062 ECAO:1000049 ! preceded by stage 3

[Term]
id: ECAO:1000051
name: stage 5
def: "Echinoderm developmental stage at which the embryo is composed of 16 cells (16-cell stage)." []
is_a: ECAO:1000046 ! pan-echinoderm life cycle stage
relationship: BFO:0000050 ECAO:1000011 ! part of cleavage period
relationship: BFO:0000062 ECAO:1000050 ! preceded by stage 4

[Term]
id: ECAO:1000052
name: stage 6
def: "Echinoderm developmental stage at which the embryo is composed of 28-32 cells (includes 28- and 32-cell stages)." []
is_a: ECAO:1000046 ! pan-echinoderm life cycle stage
relationship: BFO:0000050 ECAO:1000011 ! part of cleavage period
relationship: BFO:0000062 ECAO:1000051 ! preceded by stage 5

[Term]
id: ECAO:1000053
name: stage 7
def: "Echinoderm developmental stage at which the embryo is composed of 56-64 cells (includes 56-, 60-, and 64-cell stages)." []
is_a: ECAO:1000046 ! pan-echinoderm life cycle stage
relationship: BFO:0000050 ECAO:1000011 ! part of cleavage period
relationship: BFO:0000062 ECAO:1000052 ! preceded by stage 6

[Term]
id: ECAO:1000054
name: stage 8
def: "Echinoderm developmental stage at which the embryo is an early blastula (early blastula stage)." []
is_a: ECAO:1000046 ! pan-echinoderm life cycle stage
relationship: BFO:0000050 ECAO:1000012 ! part of blastula period
relationship: BFO:0000062 ECAO:1000053 ! preceded by stage 7

[Term]
id: ECAO:1000055
name: stage 9
def: "Echinoderm developmental stage at which the embryo is a mid-blastula (includes mid-blastula and motile blastula stages)." []
is_a: ECAO:1000046 ! pan-echinoderm life cycle stage
relationship: BFO:0000050 ECAO:1000012 ! part of blastula period
relationship: BFO:0000062 ECAO:1000054 ! preceded by stage 8

[Term]
id: ECAO:1000056
name: stage 10
def: "Echinoderm developmental stage at which the embryo is a late blastula, it is still spherical, and the vegetal plate has not formed (late blastula stage)." []
is_a: ECAO:1000046 ! pan-echinoderm life cycle stage
relationship: BFO:0000050 ECAO:1000012 ! part of blastula period
relationship: BFO:0000062 ECAO:1000055 ! preceded by stage 9

[Term]
id: ECAO:1000057
name: stage 11
def: "Echinoderm developmental stage at which the embryo, whether or not hatched from the fertilization envelope, has formed a vegetal plate but gastrulation has not begun (vegetal plate stage)." []
is_a: ECAO:1000046 ! pan-echinoderm life cycle stage
relationship: BFO:0000050 ECAO:1000012 ! part of blastula period
relationship: BFO:0000062 ECAO:1000056 ! preceded by stage 10

[Term]
id: ECAO:1000058
name: stage 12
def: "Echinoderm developmental stage at which the embryo has hatched from the fertilization envelope and is undergoing the earliest cell movements of gastrulation (includes early, mid-, and late mesenchyme blastula stages and blastopore formation stage)." []
is_a: ECAO:1000046 ! pan-echinoderm life cycle stage
relationship: BFO:0000050 ECAO:1000013 ! part of gastrula period
relationship: BFO:0000062 ECAO:1000057 ! preceded by stage 11

[Term]
id: ECAO:1000059
name: stage 13
def: "Echinoderm developmental stage at which the embryo is undergoing the first phase of archenteron extension (early gastrula stage)." []
is_a: ECAO:1000046 ! pan-echinoderm life cycle stage
relationship: BFO:0000050 ECAO:1000013 ! part of gastrula period
relationship: BFO:0000062 ECAO:1000058 ! preceded by stage 12

[Term]
id: ECAO:1000060
name: stage 14
def: "Echinoderm developmental stage at which the embryo is undergoing the middle phase of archenteron extension (mid-gastrula stage)." []
is_a: ECAO:1000046 ! pan-echinoderm life cycle stage
relationship: BFO:0000050 ECAO:1000013 ! part of gastrula period
relationship: BFO:0000062 ECAO:1000059 ! preceded by stage 13

[Term]
id: ECAO:1000061
name: stage 15
def: "Echinoderm developmental stage at which the embryo is undergoing the last phase of archenteron extension (late gastrula stage)." []
is_a: ECAO:1000046 ! pan-echinoderm life cycle stage
relationship: BFO:0000050 ECAO:1000013 ! part of gastrula period
relationship: BFO:0000062 ECAO:1000060 ! preceded by stage 14

[Term]
id: ECAO:1000062
name: stage 16
def: "Echinoderm developmental stage at which the embryo has completed archenteron elongation and mesenchyme cell ingression is complete (includes early prism and early organogenesis stages)." []
is_a: ECAO:1000046 ! pan-echinoderm life cycle stage
relationship: BFO:0000050 ECAO:1000014 ! part of organogenesis period
relationship: BFO:0000062 ECAO:1000061 ! preceded by stage 15

[Term]
id: ECAO:1000063
name: stage 17
def: "Echinoderm developmental stage at which the embryo has paired coelomic evaginations at the tip of the archenteron but lacks a stomodeal invagination and gut constrictions (includes late prism and mid-organogenesis stages)." []
is_a: ECAO:1000046 ! pan-echinoderm life cycle stage
relationship: BFO:0000050 ECAO:1000014 ! part of organogenesis period
relationship: BFO:0000062 ECAO:1000062 ! preceded by stage 16

[Term]
id: ECAO:1000064
name: stage 18
def: "Echinoderm developmental stage at which the embryo has paired coelomic pouches along with a stomodeal invagination and gut constrictions (includes late and very late organogenesis stages)." []
is_a: ECAO:1000046 ! pan-echinoderm life cycle stage
relationship: BFO:0000050 ECAO:1000014 ! part of organogenesis period
relationship: BFO:0000062 ECAO:1000063 ! preceded by stage 17

[Term]
id: ECAO:1000065
name: stage 19
def: "Echinoderm developmental stage at which the embryo has an open mouth (open mouth stage)." []
is_a: ECAO:1000046 ! pan-echinoderm life cycle stage
relationship: BFO:0000050 ECAO:1000014 ! part of organogenesis period
relationship: BFO:0000062 ECAO:1000064 ! preceded by stage 18

[Term]
id: ECAO:1000066
name: oogenesis period
def: "Period during which female gametes (or oocytes, or eggs) develop and mature from primordial female germ cells to generate cells competent to further development upon fertilization by a mature spermatozoid." []
is_a: ECAO:1000004 ! life cycle period
relationship: BFO:0000050 ECAO:1000007 ! part of gametogenesis phase

[Term]
id: ECAO:1000067
name: spermatogenesis period
def: "Period during which male gametes (or spermatozoa, or spermatozoid) develop and mature from primordial male germ cells to generate cells competent to further development upon fertilization of a mature oocyte." []
is_a: ECAO:1000004 ! life cycle period
relationship: BFO:0000050 ECAO:1000007 ! part of gametogenesis phase

[Term]
id: ECAO:1000068
name: previtellogenic primary oocyte stage
def: "Stage at which the female gamete is small in size, i.e. about 10 micrometer in diameter, and is in the previtellogenic state." []
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000066 ! part of oogenesis period

[Term]
id: ECAO:1000069
name: not fully grown oocyte stage
def: "Stage at which the developing female gamete has started growing in size by accumulation of yolk proteins, and is characterized by the presence of a large nucleus, the germinal vesicle, which contains a prominent nucleolus and occupies most of the cytoplasm." []
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000066 ! part of oogenesis period
relationship: BFO:0000062 ECAO:1000068 ! preceded by previtellogenic primary oocyte stage

[Term]
id: ECAO:1000070
name: fully grown oocyte with centered germinal vesicle stage
def: "Stage at which the developing female gamete has reached its full size. It has grown up to ten times its original size, i.e. 80 to 100 micrometers. It also displays a large germinal vesicle that is centered, but it is still not competent for fertilization." []
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000066 ! part of oogenesis period
relationship: BFO:0000062 ECAO:1000069 ! preceded by not fully grown oocyte stage

[Term]
id: ECAO:1000071
name: fully grown oocyte with off-centered germinal vesicle stage
def: "Stage at which the developing female gamete has reached its full size and whose germinal vesicle has moved asymmetrically to the cell periphery. The germinal vesicle is now close to the animal pole." []
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000066 ! part of oogenesis period
relationship: BFO:0000062 ECAO:1000070 ! preceded by fully grown oocyte with centered germinal vesicle stage

[Term]
id: ECAO:1000072
name: fully grown oocyte with no nucleus stage
def: "Stage of the developing female gamete in which the germinal vesicle has broken down. The germinal vesicle is no longer visible. However, the female gamete is still not mature. It is undergoing meiotic maturation, extruding successively a first and a second polar body." []
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000066 ! part of oogenesis period
relationship: BFO:0000062 ECAO:1000071 ! preceded by fully grown oocyte with off-centered germinal vesicle stage

[Term]
id: ECAO:1000073
name: mature oocyte stage
def: "Stage at which the mature female gamete has achieved its meiotic maturation and whose female pronucleus is visible. The mature oocyte is arrested in G1 phase and its average size is 80 to 100 micrometers. It is surrounded by a transparent jelly coat that is about 30 micrometers thick. It is competent to fertilization and is located in the female gonad where it may be stored for weeks to months before its release in sea water by spawning. In the P. lividus species, the mature female gametes are characterized by the presence of pigment granules concentrated in a subequatorial band. This band is classically called the pigment band and allows visualization of the first embryonic axis, i.e. the animal-vegetal axis, which is perpendicular to the band." []
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000066 ! part of oogenesis period
relationship: BFO:0000062 ECAO:1000072 ! preceded by fully grown oocyte with no nucleus stage

[Term]
id: ECAO:1000074
name: developing spermatozoa stage
def: "Stage at which the developing, immature male gamete is undergoing mitosis and meiosis to ultimately produce mature spermatozoa." []
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000067 ! part of spermatogenesis period

[Term]
id: ECAO:1000075
name: mature spermatozoid stage
def: "Stage at which the mature male gamete is composed of a head, encompassing a compact nucleus, a neck, a middle piece, and a tail (or flagellum) that propels it towards the oocyte upon spawning." []
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000067 ! part of spermatogenesis period
relationship: BFO:0000062 ECAO:1000074 ! preceded by developing spermatozoa stage

[Term]
id: ECAO:1000076
name: 4-arm pluteus larva stage
def: "Stage at which the larva is characterized by the presence, on the ventral side, of four extended arms (two anterolateral arms at the level of the oral hood and two postoral arms) and on the dorsal side by a sleeked apex. The larva now possesses a completely tripartite and functional digestive tract composed of an esophagus, a stomach, and an intestine, respectively limited by a cardiac sphincter, a pyloric sphincter, and an anal sphincter." []
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000009 ! part of larval development phase
relationship: BFO:0000062 ECAO:1000045 ! preceded by open mouth stage

[Term]
id: ECAO:1000077
name: 6-arm pluteus larva stage
def: "Stage at which the larva is characterized by the presence on the ventral side of six arms, and by the development, on the anterior midline of the esophagus, of the dorsal arch." []
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000009 ! part of larval development phase
relationship: BFO:0000062 ECAO:1000076 ! preceded by 4-arm pluteus larva stage

[Term]
id: ECAO:1000078
name: 8-arm pluteus larva stage
def: "Stage at which the larva is characterized by the presence on the ventral side of eight arms and by the development within the larva, on the left side of the stomach, of the adult rudiment. This stage is relatively long. It includes distinct changes occurring to the larva as well as within the larva, although the larva consistently exhibits 8 arms." []
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000009 ! part of larval development phase
relationship: BFO:0000062 ECAO:1000077 ! preceded by 6-arm pluteus larva stage

[Term]
id: ECAO:1000079
name: competent pluteus larva stage
def: "Stage at which the larva is characterized by the presence, within the larva, on the left side of its stomach, of the adult rudiment. The rudiment is now the size of or even bigger than the stomach and harbors five long primary podia (i.e. tube feet) and five quartets of definitive spines. Under the right environemental cue, the larva is competent to undergo metamorphosis." []
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000009 ! part of larval development phase
relationship: BFO:0000062 ECAO:1000078 ! preceded by 8-arm pluteus larva stage

[Term]
id: ECAO:1000080
name: metamorphic larva stage
def: "Stage at which the larva essentially undergoes metamorphsis. The larva goes through drastic morphological changes to transofrm the bilateral, planctonic larva into a benthic, pentaradial juvenile." []
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000009 ! part of larval development phase
relationship: BFO:0000062 ECAO:1000079 ! preceded by competent pluteus larva stage

[Term]
id: ECAO:1000081
name: juvenile period
def: "Period during which a young benthic individual, posing as a small adult, grows but remains unable to reproduce." []
is_a: ECAO:1000004 ! life cycle period
relationship: BFO:0000050 ECAO:1000010 ! part of adulthood phase
relationship: BFO:0000062 ECAO:1000009 ! preceded by larval development phase

[Term]
id: ECAO:1000082
name: early juvenile stage
def: "Stage at which the animal is morphologically similar to a miniature sea urchin adult. It harbors primary podia (or tube feet) and definitive spines, along with other appendages (e.g., immature spines, pedicellariae). Compare to the adult, however, it is smaller in size, deprived of a functional digestive system, and is sexually immature." []
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000081 ! part of juvenile period
relationship: BFO:0000062 ECAO:1000080 ! preceded by metamorphic larva stage

[Term]
id: ECAO:1000083
name: late juvenile stage
def: "Stage at which the animal still looks like a small adult. Its digestive tract is now functional. However, the late juvenile remains sexually immature." []
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000081 ! part of juvenile period
relationship: BFO:0000062 ECAO:1000082 ! preceded by early juvenile stage

[Term]
id: ECAO:1000084
name: adult period
def: "Period during which the animal reaches sexual maturity." []
is_a: ECAO:1000004 ! life cycle period
relationship: BFO:0000050 ECAO:1000010 ! part of adulthood phase
relationship: BFO:0000062 ECAO:1000081 ! preceded by juvenile period

[Term]
id: ECAO:1000085
name: adult stage
def: "Stage which corresponds to a fully formed pentaradial sea urchin individual that has reached sexual maturity. The gonads have developed within the perivisceral cavity and are connected to the outside by the genital pores pierced into the genital plates." []
is_a: ECAO:1000006 ! life cycle stage
relationship: BFO:0000050 ECAO:1000084 ! part of adult period
relationship: BFO:0000062 ECAO:1000083 ! preceded by late juvenile stage

[Term]
id: ECAO:2000000
name: anatomy
def: "A biological entity that is either an individual member of a biological species or constitutes the structural organization of an individual member of a biological species." []
synonym: "echinoderm anatomical entity" RELATED []
xref: UBERON:0001062
is_a: ECAO:1000000 ! Echinoderm anatomy and development

[Term]
id: ECAO:2000001
name: anatomical structure
def: "A material anatomical entity that is a single structure with inherent 3D shape generated by coordinated expression of the organism's own genome." []
xref: UBERON:0000061
is_a: ECAO:2000000 ! anatomy

[Term]
id: ECAO:2000002
name: anatomical system
def: "A multicellular, connected anatomical structure composed of multiple organs that work together to achieve some shared function." []
synonym: "organ system" RELATED []
synonym: "body system" RELATED []
xref: UBERON:0000467
is_a: ECAO:2000000 ! anatomy

[Term]
id: ECAO:2000003
name: anatomical region
def: "An anatomical structure that is a subdivision of a tissue, a germ layer, or an organ of the whole organism but without well-defined morphological boundaries." []
synonym: "organism subdivision" RELATED []
xref: UBERON:0000475
is_a: ECAO:2000000 ! anatomy

[Term]
id: ECAO:2000004
name: anatomical space
def: "A non-material anatomical entity of three dimensions, that is generated by morphogenetic or other physiologic processes, that is surrounded by one or more anatomical structures and may contain one or more organism substances or anatomical structures." []
xref: UBERON:0000464
is_a: ECAO:2000000 ! anatomy

[Term]
id: ECAO:2000005
name: anatomical element
def: "An anatomical structure that is a subdivision of a tissue, a germ layer, or an organ of the whole organism but with well-defined morphological boundaries." []
synonym: "anatomical object" RELATED []
is_a: ECAO:2000000 ! anatomy

[Term]
id: ECAO:2000006
name: multicellular organism
def: "An anatomical structure that is an individual member of a species and consists of more than one cell. It includes all forms during all life cycle phases (embryogenesis, larval development, and adulthood)." []
synonym: "whole organism" RELATED []
synonym: "body" RELATED []
xref: UBERON:0000468
is_a: ECAO:2000001 ! anatomical structure

[Term]
id: ECAO:2000007
name: zygote
def: "A diploid cell produced by the fusion of a male and a female gamete at fertilization. It constitutes the first stage of the embryogenesis life cycle phase." []
synonym: "fertilized egg" RELATED []
synonym: "1-cell" RELATED []
xref: CL_0010017
is_a: ECAO:2000058 ! cell

[Term]
id: ECAO:2000008
name: embryo
def: "A multicellular organism at an early stage of development characterized by cleavage, formation of a hollow sphere, or morphogenetic movements. It includes all forms of the embryogenesis life cycle phase." []
xref: UBERON:0000922
is_a: ECAO:2000006 ! multicellular organism
relationship: develops_from ECAO:2000007 ! zygote

[Term]
id: ECAO:2000009
name: cleavage embryo
def: "A multicellular organism at an early stage of development characterized by cleavage. It includes all forms of the cleavage period during the embryogenesis life cycle phase (i.e., from first cleavage to before the formation of the blastula)." []
synonym: "cleaving embryo" RELATED []
xref: UBERON:0007010
is_a: ECAO:2000008 ! embryo
relationship: develops_from ECAO:2000007 ! zygote
relationship: part_of ECAO:2000006 ! multicellular organism

[Term]
id: ECAO:2000010
name: blastula
def: "A multicellular organism at an early stage of development corresponding to a hollow, spherical, multicellular, monolayered embryo with a hollow cavity (the blastocoel) in the center. It includes all forms of the blastula period during the embryogenesis life cycle phase." []
synonym: "morula" RELATED []
xref: UBERON:0000307
is_a: ECAO:2000008 ! embryo
relationship: develops_from ECAO:2000009 ! cleavage embryo
relationship: part_of ECAO:2000006 ! multicellular organism

[Term]
id: ECAO:2000011
name: gastrula
def: "A multicellular organism at an early stage of development characterized by morphogenetic movements. It includes all forms of the gastrula period during the embryogenesis life cycle phase." []
synonym: "gastrulating embryo" RELATED []
xref: UBERON:0004734
is_a: ECAO:2000008 ! embryo
relationship: develops_from ECAO:2000010 ! blastula
relationship: part_of ECAO:2000006 ! multicellular organism

[Term]
id: ECAO:2000012
name: larva
def: "A multicellular organism form, which many animals undergo before metamorphosing into adults. It includes all forms of the larval development life cycle phase." []
xref: UBERON:0002548
is_a: ECAO:2000006 ! multicellular organism
relationship: develops_from ECAO:2000008 ! embryo

[Term]
id: ECAO:2000013
name: pre-metamorphic organism
def: "A multicellular organism the existence of which starts at fertilization and ends with metamorphosis. It includes all forms during the embryogenesis and larval development life cycle phases." []
synonym: "pre-metamorphosing organism" RELATED []
is_a: ECAO:2000006 ! multicellular organism
relationship: develops_from ECAO:2000007 ! zygote

[Term]
id: ECAO:2000014
name: post-embryonic organism
def: "A multicellular organism the existence of which starts upon the opening of the mouth and ends with death. It includes all forms during the larval development and adulthood life cycle phases." []
is_a: ECAO:2000006 ! multicellular organism
relationship: develops_from ECAO:2000008 ! embryo

[Term]
id: ECAO:2000015
name: adult
def: "A multicellular organism the existence of which starts at metamorphosis and ends with death. It includes all forms during the adulthood life cycle phase." []
xref: UBERON:0007023
is_a: ECAO:2000006 ! multicellular organism
relationship: develops_from ECAO:2000012 ! larva

[Term]
id: ECAO:2000016
name: juvenile
def: "A multicellular organism the existence of which starts at metamorphosis and ends with gamete production." []
xref: UBERON:0034919
is_a: ECAO:2000006 ! multicellular organism
relationship: develops_from ECAO:2000012 ! larva

[Term]
id: ECAO:2000017
name: mature adult
def: "A multicellular organism the existence of which starts with gamete production and ends with death." []
synonym: "sexually mature adult" RELATED []
synonym: "post-juvenile adult" RELATED []
xref: UBERON:0000113
is_a: ECAO:2000006 ! multicellular organism
relationship: develops_from ECAO:2000016 ! juvenile

[Term]
id: ECAO:2000018
name: embryonic region
def: "A portion of an embryo (or a population of embryonic cells) that is characterized by a common developmental fate or a common gene expression program but lacks any clear morphological boundaries." []
synonym: "embryonic territory" RELATED []
is_a: ECAO:2000003 ! anatomical region
relationship: part_of ECAO:2000008 ! embryo

[Term]
id: ECAO:2000019
name: larval region
def: "A portion of a larva (or a population of larval cells) that is characterized by a common developmental fate or a common gene expression program but lacks any clear morphological boundaries." []
synonym: "larval territory" RELATED []
is_a: ECAO:2000003 ! anatomical region
relationship: part_of ECAO:2000012 ! larva

[Term]
id: ECAO:2000020
name: pre-metamorphic organism region
def: "A population of cells that, throughout the embryogenesis and larval development life cycle phases, is characterized by a common developmental fate or a common gene expression program but lacks any clear morphological boundaries." []
synonym: "pre-metamorphic territory" RELATED []
is_a: ECAO:2000003 ! anatomical region
relationship: part_of ECAO:2000013 ! pre-metamorphic organism

[Term]
id: ECAO:2000021
name: tissue
def: "A multicellular anatomical structure composed an aggregate of many similar cells that perform a unique, specific function." []
xref: UBERON:0000479
is_a: ECAO:2000001 ! anatomical structure
relationship: part_of ECAO:2000006 ! multicellular organism

[Term]
id: ECAO:2000022
name: organ
def: "A multicellular anatomical structure made of several tissues, performing a specific function or group of functions." []
xref: UBERON:0000062
is_a: ECAO:2000005 ! anatomical element
relationship: part_of ECAO:2000002 ! anatomical system

[Term]
id: ECAO:2000023
name: embryonic tissue
def: "A tissue that is present in an embryo." []
xref: UBERON:0005291
is_a: ECAO:2000021 ! tissue
relationship: part_of ECAO:2000008 ! embryo

[Term]
id: ECAO:2000024
name: larval tissue
def: "A tissue that is present in a larva." []
is_a: ECAO:2000021 ! tissue
relationship: part_of ECAO:2000012 ! larva

[Term]
id: ECAO:2000025
name: pre-metamorphic organism tissue
def: "A tissue that is present in a pre-metamorphic organism." []
is_a: ECAO:2000021 ! tissue
relationship: part_of ECAO:2000013 ! pre-metamorphic organism

[Term]
id: ECAO:2000026
name: embryonic structure
def: "An anatomical structure that is part of an embryo." []
xref: UBERON:0002050
is_a: ECAO:2000001 ! anatomical structure
relationship: part_of ECAO:2000008 ! embryo

[Term]
id: ECAO:2000027
name: larval structure
def: "An anatomical structure that is part of a larva." []
is_a: ECAO:2000001 ! anatomical structure
relationship: part_of ECAO:2000012 ! larva

[Term]
id: ECAO:2000028
name: pre-metamorphic organism structure
def: "An anatomical structure that is part of a pre-metamorphic organism." []
is_a: ECAO:2000001 ! anatomical structure
relationship: part_of ECAO:2000013 ! pre-metamorphic organism

[Term]
id: ECAO:2000029
name: digestive system
def: "An anatomical system that has as its parts the organs devoted to the ingestion, digestion, and assimilation of food and the discharge of residual wastes." []
xref: UBERON:0001007
is_a: ECAO:2000002 ! anatomical system
relationship: part_of ECAO:2000014 ! post-embryonic organism

[Term]
id: ECAO:2000030
name: digestive system element
def: "Any of the organs or elements that are part of the digestive system." []
synonym: "digestive system organ" RELATED []
xref: UBERON:0013765
is_a: ECAO:2000005 ! anatomical element
relationship: part_of ECAO:2000029 ! digestive system

[Term]
id: ECAO:2000031
name: larval digestive system
def: "An anatomical system responsible in a larva for food uptake and processing." []
is_a: ECAO:2000029 ! digestive system
relationship: part_of ECAO:2000012 ! larva

[Term]
id: ECAO:2000032
name: immune system
def: "An anatomical system that protects the body from foreign substances, cells, and tissues by producing the appropriate immune response." []
xref: UBERON:0002405
is_a: ECAO:2000002 ! anatomical system
relationship: part_of ECAO:2000006 ! multicellular organism

[Term]
id: ECAO:2000033
name: embryonic immune system
def: "The immune system of an embryo." []
is_a: ECAO:2000032 ! immune system
relationship: part_of ECAO:2000008 ! embryo

[Term]
id: ECAO:2000034
name: larval immune system
def: "The immune system of a larva." []
xref: XAO:0003153
is_a: ECAO:2000032 ! immune system
relationship: part_of ECAO:2000012 ! larva

[Term]
id: ECAO:2000035
name: pre-metamorphic organism immune system
def: "The immune system of a pre-metamorphic organism." []
is_a: ECAO:2000032 ! immune system
relationship: part_of ECAO:2000013 ! pre-metamorphic organism

[Term]
id: ECAO:2000036
name: reproductive system
def: "An anatomical system that has as its parts the organs concerned with reproduction." []
xref: UBERON:0000990
is_a: ECAO:2000002 ! anatomical system
relationship: part_of ECAO:2000017 ! mature adult

[Term]
id: ECAO:2000037
name: female reproductive system
def: "An anatomical reproductive system that is present in a female multicellular organism." []
xref: UBERON_0000474
is_a: ECAO:2000036 ! reproductive system
relationship: part_of ECAO:2000006 ! multicellular organism

[Term]
id: ECAO:2000038
name: male reproductive system
def: "An anatomical reproductive system that is present in a male multicellular organism." []
xref: UBERON:0000079
is_a: ECAO:2000036 ! reproductive system
relationship: part_of ECAO:2000006 ! multicellular organism

[Term]
id: ECAO:2000039
name: nervous system
def: "An anatomical system containing predominantly neurons and glial cells. Its main functions are to regulate and control body functions, as well as to generate behavior" []
xref: UBERON:0001016
is_a: ECAO:2000002 ! anatomical system
relationship: part_of ECAO:2000006 ! multicellular organism

[Term]
id: ECAO:2000040
name: embryonic nervous system
def: "The neurons and glial cells constituting the nervous system of an embryo." []
is_a: ECAO:2000039 ! nervous system
relationship: part_of ECAO:2000008 ! embryo

[Term]
id: ECAO:2000041
name: larval nervous system
def: "The neurons and glial cells constituting the nervous system of a larva." []
is_a: ECAO:2000039 ! nervous system
relationship: part_of ECAO:2000012 ! larva

[Term]
id: ECAO:2000042
name: pre-metamorphic organism nervous system
def: "The neurons and glial cells constituting the nervous system of a pre-metamorphic organism." []
is_a: ECAO:2000039 ! nervous system
relationship: part_of ECAO:2000013 ! pre-metamorphic organism

[Term]
id: ECAO:2000043
name: muscular system
def: "An anatomical system that has as its parts all muscles of the body." []
synonym: "musculature of the body" RELATED []
synonym: "muscle system" RELATED []
xref: UBERON:0000383
is_a: ECAO:2000002 ! anatomical system
relationship: part_of ECAO:2000006 ! multicellular organism

[Term]
id: ECAO:2000044
name: larval muscular system
def: "The muscular system of a larva." []
is_a: ECAO:2000043 ! muscular system
relationship: part_of ECAO:2000012 ! larva

[Term]
id: ECAO:2000045
name: endoskeleton
def: "An anatomical system composed of mineralized tissue and consisting of the internal support structure (internal skeleton) of an animal providing shape, support, and protection to the body." []
xref: UBERON:0001434
is_a: ECAO:2000002 ! anatomical system
relationship: part_of ECAO:2000006 ! multicellular organism

[Term]
id: ECAO:2000046
name: embryonic endoskeleton
def: "The endoskeleton of an embryo." []
synonym: "embryonic skeleton" RELATED []
is_a: ECAO:2000045 ! endoskeleton
relationship: part_of ECAO:2000008 ! embryo

[Term]
id: ECAO:2000047
name: larval endoskeleton
def: "The endoskeleton of a larva." []
synonym: "larval skeleton" RELATED []
is_a: ECAO:2000045 ! endoskeleton
relationship: part_of ECAO:2000012 ! larva

[Term]
id: ECAO:2000048
name: pre-metamorphic organism endoskeleton
def: "The endoskeleton of a pre-metamorphic organism." []
synonym: "pre-metamorphic organism skeleton" RELATED []
is_a: ECAO:2000045 ! endoskeleton
relationship: part_of ECAO:2000013 ! pre-metamorphic organism

[Term]
id: ECAO:2000049
name: skeletal element
def: "An organ or anatomical element consisting of skeletal tissue. In echinoderms, skeletal elements include for example ossicles, spicules, skeletal rods, teeth, and plates of the adult shell." []
xref: UBERON:0004765
is_a: ECAO:2000005 ! anatomical element
relationship: part_of ECAO:2000045 ! endoskeleton

[Term]
id: ECAO:2000050
name: skeletal tissue
def: "A specialized form of connective tissue in which the extracellular matrix is mineralized and that functions in mechanical and structural support." []
xref: UBERON:0004755
is_a: ECAO:2000021 ! tissue
relationship: part_of ECAO:2000045 ! endoskeleton

[Term]
id: ECAO:2000051
name: embryonic hemisphere
def: "One of two hemispheres of an embryo." []
synonym: "hemisphere of embryo" RELATED []
xref: UBERON:0012286
is_a: ECAO:2000026 ! embryonic structure

[Term]
id: ECAO:2000052
name: animal hemisphere
def: "An anatomical region that corresponds to the upper half of an embryo. Among echinoderms, in euechinoids, during the cleavage period, it is composed of the mesomeres and ultimately encompasses the presumptive ectoderm." []
synonym: "animal half" RELATED []
synonym: "upper half" RELATED []
synonym: "upper hemisphere" RELATED []
xref: UBERON:0012284
is_a: ECAO:2000051 ! embryonic hemisphere
relationship: part_of ECAO:2000008 ! embryo

[Term]
id: ECAO:2000053
name: vegetal hemisphere
def: "An anatomical region that corresponds to the lower half of an embryo. Among echinoderms, in euechinoids, during the cleavage period, it is composed of the macromeres and the micromeres and ultimately encompasses the presumptive endoderm and mesoderm." []
synonym: "vegetal half" RELATED []
synonym: "lower half" RELATED []
synonym: "lower hemisphere" RELATED []
xref: UBERON:0012285
is_a: ECAO:2000051 ! embryonic hemisphere
relationship: part_of ECAO:2000008 ! embryo

[Term]
id: ECAO:2000054
name: cell tier
def: "A layer of blastomeres perpendicular to the animal-vegetal axis of an embryo." []
synonym: "blastomere tier" RELATED []
is_a: ECAO:2000026 ! embryonic structure
relationship: part_of ECAO:2000008 ! embryo

[Term]
id: ECAO:2000055
name: animal cell tier
def: "A cell tier present in the animal hemisphere of an embryo." []
synonym: "animal blastomere tier" RELATED []
is_a: ECAO:2000054 ! cell tier
relationship: part_of ECAO:2000052 ! animal hemisphere

[Term]
id: ECAO:2000056
name: vegetal cell tier
def: "A cell tier present in the vegetal hemisphere of an embryo." []
synonym: "vegetal blastomere tier" RELATED []
is_a: ECAO:2000054 ! cell tier
relationship: part_of ECAO:2000053 ! vegetal hemisphere

[Term]
id: ECAO:2000057
name: cell body
def: "The portion of a cell bearing surface projections such as axons, filopodia, dendrites, cilia, or flagella that includes the nucleus, but excludes all cell projections." []
xref: GO:0044297
is_a: ECAO:2000001 ! anatomical structure
relationship: part_of ECAO:2000058 ! cell

[Term]
id: ECAO:2000058
name: cell
def: "An anatomical structure that has as its parts a maximally connected cell compartment surrounded by a plasma membrane." []
xref: CL:0000000
is_a: ECAO:2000001 ! anatomical structure
relationship: part_of ECAO:2000006 ! multicellular organism

[Term]
id: ECAO:2000059
name: germ line cell
def: "A cell that is within the developmental lineage of gametes and is able to pass along its genetic material to offspring." []
synonym: "germ line stem cell" RELATED []
synonym: "germline cell" RELATED []
xref: CL:0000039
is_a: ECAO:2000058 ! cell
relationship: part_of ECAO:2000036 ! reproductive system

[Term]
id: ECAO:2000060
name: germ cell
def: "A generic term for a reproductive cell of a multicellular organism. It can be diploid and immature or haploid and mature." []
synonym: "germinal cell" RELATED []
xref: CL:0000586
is_a: ECAO:2000058 ! cell
relationship: develops_from ECAO:2000059 ! germ line cell
relationship: part_of ECAO:2000036 ! reproductive system

[Term]
id: ECAO:2000061
name: female germ cell
def: "A germ cell that supports female gamete production." []
xref: CL_0000021
is_a: ECAO:2000060 ! germ cell
relationship: part_of ECAO:2000037 ! female reproductive system

[Term]
id: ECAO:2000062
name: male germ cell
def: "A germ cell that supports male gamete production." []
xref: CL_0000015
is_a: ECAO:2000060 ! germ cell
relationship: part_of ECAO:2000038 ! male reproductive system

[Term]
id: ECAO:2000063
name: primordial germ cell
def: "An immature diploid germ cell precursor that transiently exists in the embryo before entering into close association with the somatic cells of the gonad and becoming irreversibly committed as a germ cell." []
synonym: "PGC" RELATED []
synonym: "primitive germ cell" RELATED []
xref: CL:0000670
is_a: ECAO:2000059 ! germ line cell
relationship: part_of ECAO:2000036 ! reproductive system

[Term]
id: ECAO:2000064
name: mature germ cell
def: "The reproductive haploid, mature sexual reproductive cell of a multicellular organism." []
synonym: "gamete" RELATED []
is_a: ECAO:2000060 ! germ cell
relationship: develops_from ECAO:2000063 ! primordial germ cell
relationship: part_of ECAO:2000036 ! reproductive system

[Term]
id: ECAO:2000065
name: oocyte
def: "A female germ cell that has entered meiosis." []
xref: CL:0000023
is_a: ECAO:2000061 ! female germ cell
relationship: part_of ECAO:2000037 ! female reproductive system

[Term]
id: ECAO:2000066
name: primary oocyte
def: "An immature oocyte that is diploid and has not completed female meiosis I." []
xref: CL:0000654
is_a: ECAO:2000063 ! primordial germ cell
relationship: part_of ECAO:2000037 ! female reproductive system

[Term]
id: ECAO:2000067
name: secondary oocyte
def: "An immature oocyte that is haploid but has not completed female meiosis II." []
is_a: ECAO:2000063 ! primordial germ cell
relationship: develops_from ECAO:2000066 ! primary oocyte
relationship: part_of ECAO:2000037 ! female reproductive system

[Term]
id: ECAO:2000068
name: mature oocyte
def: "A haploid oocyte that has advanced through meiosis to the stage at which it can be fertilized successfully by sperm. Mature echinoderm eggs have completed meiosis." []
synonym: "egg" RELATED []
synonym: "unfertilized egg" RELATED []
synonym: "female gamete" RELATED []
synonym: "ovum" RELATED []
is_a: ECAO:2000064 ! mature germ cell
relationship: develops_from ECAO:2000067 ! secondary oocyte
relationship: part_of ECAO:2000037 ! female reproductive system

[Term]
id: ECAO:2000069
name: spermatogonium
def: "An euploid male germ cell of an early stage of spermatogenesis. It is morphologically unlike spermatocytes and spermatids." []
xref: CL_0000020
is_a: ECAO:2000063 ! primordial germ cell
relationship: part_of ECAO:2000038 ! male reproductive system

[Term]
id: ECAO:2000070
name: spermatocyte
def: "A male germ cell that develops from spermatogonia." []
xref: CL_0000017
is_a: ECAO:2000063 ! primordial germ cell
relationship: develops_from ECAO:2000069 ! spermatogonium
relationship: part_of ECAO:2000038 ! male reproductive system

[Term]
id: ECAO:2000071
name: spermatid
def: "A male germ cell that develops from spermatocytes." []
xref: CL:0000018
is_a: ECAO:2000063 ! primordial germ cell
relationship: develops_from ECAO:2000070 ! spermatocyte
relationship: part_of ECAO:2000038 ! male reproductive system

[Term]
id: ECAO:2000072
name: spermatozoid
def: "A mature male germ cell that develops from a spermatid." []
synonym: "sperm" RELATED []
synonym: "spermatozoa" RELATED []
synonym: "spermatozoon" RELATED []
synonym: "male gamete" RELATED []
synonym: "mature sperm cell" RELATED []
xref: CL:0000019
is_a: ECAO:2000064 ! mature germ cell
relationship: develops_from ECAO:2000071 ! spermatid
relationship: part_of ECAO:2000038 ! male reproductive system

[Term]
id: ECAO:2000073
name: spermatozoid part
def: "Any constituent part of a spermatozoid." []
synonym: "sperm part" RELATED []
xref: GO:0097223
is_a: ECAO:2000080 ! cellular anatomical entity
relationship: part_of ECAO:2000072 ! spermatozoid

[Term]
id: ECAO:2000074
name: spermatozoid head
def: "The part of the spermatozoid that contains the nucleus and acrosome." []
synonym: "sperm head" RELATED []
xref: GO:0061827
is_a: ECAO:2000073 ! spermatozoid part
relationship: part_of ECAO:2000072 ! spermatozoid

[Term]
id: ECAO:2000075
name: acrosomal vesicle
def: "A structure in the head of a spermatozoid that contains acid hydrolases, and is concerned with the breakdown of the outer membrane of the ovum during fertilization." []
synonym: "acrosome" RELATED []
xref: GO:0001669
is_a: ECAO:2000116 ! secretory vesicle
relationship: part_of ECAO:2000074 ! spermatozoid head

[Term]
id: ECAO:2000076
name: spermatozoid flagellum
def: "A microtubule-based flagellum (or cilium) that is part of a spermatozoid." []
synonym: "sperm tail" RELATED []
synonym: "sperm cilium" RELATED []
xref: GO:0036126
is_a: ECAO:2000073 ! spermatozoid part
relationship: part_of ECAO:2000072 ! spermatozoid

[Term]
id: ECAO:2000077
name: spermatozoid entry point
def: "The point on the surface of the ovum where the spermatozoid enters." []
synonym: "sperm entry point" RELATED []
xref: XAO:0000274
is_a: ECAO:2000080 ! cellular anatomical entity
relationship: part_of ECAO:2000007 ! zygote

[Term]
id: ECAO:2000078
name: spermatozoid nucleus
def: "An intracellular anatomical structure in which the male chromosomes are housed." []
synonym: "sperm nucleus" RELATED []
synonym: "male germ cell nucleus" RELATED []
xref: GO_0001673
is_a: ECAO:2000093 ! nucleus
relationship: part_of ECAO:2000072 ! spermatozoid

[Term]
id: ECAO:2000079
name: oocyte nucleus
def: "An intracellular anatomical structure in which the female chromosomes are housed." []
synonym: "female nucleus" RELATED []
synonym: "female germ cell nucleus" RELATED []
xref: GO_0001674
is_a: ECAO:2000093 ! nucleus
relationship: part_of ECAO:2000065 ! oocyte

[Term]
id: ECAO:2000080
name: cellular anatomical entity
def: "Any constituent part of a cell that is either an immaterial entity or a material entity with granularity above the level of a protein complex but below that of an anatomical structure." []
synonym: "cell part" RELATED []
xref: GO:0110165
is_a: ECAO:2000001 ! anatomical structure
relationship: part_of ECAO:2000058 ! cell

[Term]
id: ECAO:2000081
name: intracellular anatomical structure
def: "A component of a cell contained within (but not including) the plasma membrane. It includes as examples the nucleus, mitochondria, vesicles, and the cytoskeleton." []
synonym: "intracellular part" RELATED []
synonym: "organelle" RELATED []
xref: GO:0005622
is_a: ECAO:2000080 ! cellular anatomical entity
relationship: part_of ECAO:2000058 ! cell

[Term]
id: ECAO:2000082
name: cell-cell junction
def: "A cell junction that forms a connection between two or more cells of a multicellular organism." []
xref: GO:0005911
is_a: ECAO:2000080 ! cellular anatomical entity
relationship: part_of ECAO:2000058 ! cell

[Term]
id: ECAO:2000083
name: desmosome
def: "A strong cell-cell junction usually found in tissue that experience intense mechanical stress." []
synonym: "spot desmosome" RELATED []
xref: GO:0030057
is_a: ECAO:2000082 ! cell-cell junction
relationship: part_of ECAO:2000058 ! cell

[Term]
id: ECAO:2000084
name: septate junction
def: "A cell-cell junction that forms a continuous band around each cell in an epithelium." []
synonym: "spetate desmosome" RELATED []
xref: GO:0005918
is_a: ECAO:2000082 ! cell-cell junction
relationship: part_of ECAO:2000058 ! cell

[Term]
id: ECAO:2000085
name: adherens junction
def: "A cell-cell junction composed of the epithelial cadherin-catenin complex." []
xref: GO:0005912
is_a: ECAO:2000082 ! cell-cell junction
relationship: part_of ECAO:2000058 ! cell

[Term]
id: ECAO:2000086
name: cleavage furrow
def: "The indentation of the plasma membrane at the cell division site." []
xref: GO:0032154
is_a: ECAO:2000080 ! cellular anatomical entity
relationship: part_of ECAO:2000133 ! plasma membrane

[Term]
id: ECAO:2000087
name: cytoskeleton
def: "A complex, dynamic network of interlinking protein filaments present in the cytoplasm of a cell." []
xref: GO:0005856
is_a: ECAO:2000081 ! intracellular anatomical structure
relationship: part_of ECAO:2000095 ! cytoplasm

[Term]
id: ECAO:2000088
name: microtubule cytoskeleton
def: "The part of the cytoskeleton composed of microtubules and associated proteins." []
xref: GO:0015630
is_a: ECAO:2000087 ! cytoskeleton
relationship: part_of ECAO:2000058 ! cell

[Term]
id: ECAO:2000089
name: actin cytoskeleton
def: "The part of the cytoskeleton composed of actin and associated proteins. Includes actin cytoskeleton-associated complexes." []
xref: GO:0015629
is_a: ECAO:2000087 ! cytoskeleton
relationship: part_of ECAO:2000058 ! cell

[Term]
id: ECAO:2000090
name: filament
def: "A component of a cytoskeleton consisting of a homo or heteropolymeric fiber constructed from an indeterminate number of protein subunits." []
synonym: "protein filament" RELATED []
synonym: "fiber" RELATED []
synonym: "polymeric cytoskeletal fiber" RELATED []
xref: GO:0099513
is_a: ECAO:2000081 ! intracellular anatomical structure
relationship: part_of ECAO:2000087 ! cytoskeleton

[Term]
id: ECAO:2000091
name: microtubule
def: "A polymer of tubulin that forms part of the cytoskeleton and provides structure and shape to cells." []
xref: GO:0005874
is_a: ECAO:2000090 ! filament
relationship: part_of ECAO:2000088 ! microtubule cytoskeleton

[Term]
id: ECAO:2000092
name: actin filament
def: "A filamentous structure formed of a two-stranded helical polymer of the protein actin and associated proteins." []
synonym: "actin microfilament" RELATED []
xref: GO:0005884
is_a: ECAO:2000090 ! filament
relationship: part_of ECAO:2000089 ! actin cytoskeleton

[Term]
id: ECAO:2000093
name: nucleus
def: "A membrane-bounded organelle of in which chromosomes are housed and replicated." []
xref: GO:0005634
is_a: ECAO:2000081 ! intracellular anatomical structure
relationship: part_of ECAO:2000058 ! cell

[Term]
id: ECAO:2000094
name: germinal vesicle
def: "The enlarged, fluid filled nucleus of an oocyte." []
synonym: "oocyte nucleus" RELATED []
xref: GO:0042585
is_a: ECAO:2000093 ! nucleus
relationship: part_of ECAO:2000065 ! oocyte

[Term]
id: ECAO:2000095
name: cytoplasm
def: "All the contents of a cell excluding the plasma membrane and nucleus, but including all other subcellular structures." []
xref: GO:0005737
is_a: ECAO:2000081 ! intracellular anatomical structure
relationship: part_of ECAO:2000058 ! cell

[Term]
id: ECAO:2000096
name: centrosome
def: "An organelle in an animal cell that serves as the main microtubule organizing center and as a regulator of cell-cycle progression." []
xref: GO:0005813
is_a: ECAO:2000081 ! intracellular anatomical structure
relationship: part_of ECAO:2000088 ! microtubule cytoskeleton

[Term]
id: ECAO:2000097
name: mitotic spindle
def: "A cytoskeletal structure that forms during mitotic cell division." []
xref: GO:0072686
is_a: ECAO:2000081 ! intracellular anatomical structure
relationship: part_of ECAO:2000088 ! microtubule cytoskeleton

[Term]
id: ECAO:2000098
name: meiotic spindle
def: "A cytoskeletal structure that forms during meiotic cell division." []
xref: GO:0072687
is_a: ECAO:2000081 ! intracellular anatomical structure
relationship: part_of ECAO:2000088 ! microtubule cytoskeleton

[Term]
id: ECAO:2000099
name: spindle pole
def: "The either end of a spindle, from where the spindle microtubules emanate." []
xref: GO:0000922
is_a: ECAO:2000081 ! intracellular anatomical structure
relationship: part_of ECAO:2000088 ! microtubule cytoskeleton

[Term]
id: ECAO:2000100
name: cell cortex
def: "The region of a cell that lies just beneath the plasma membrane." []
xref: GO:0005938
is_a: ECAO:2000080 ! cellular anatomical entity
relationship: part_of ECAO:2000058 ! cell

[Term]
id: ECAO:2000101
name: animal cortex
def: "The cell cortex specifically associated with the animal hemisphere of an oocyte or a zygote." []
is_a: ECAO:2000100 ! cell cortex
relationship: part_of ECAO:2000052 ! animal hemisphere

[Term]
id: ECAO:2000102
name: vegetal cortex
def: "The cell cortex specifically associated with the vegetal hemisphere of an oocyte or a zygote." []
is_a: ECAO:2000100 ! cell cortex
relationship: part_of ECAO:2000053 ! vegetal hemisphere

[Term]
id: ECAO:2000103
name: animal pole
def: "The most apical region of the animal hemisphere. Among echinoderms, in euechinoids, it is characterized by the presence of long, immotile cilia constituting the apical tuft initially and then, in all echinoderms, by te presence of the oral hood and where the serotonergic neurons form." []
is_a: ECAO:2000003 ! anatomical region
relationship: part_of ECAO:2000052 ! animal hemisphere

[Term]
id: ECAO:2000104
name: vegetal pole
def: "The most apical region of the vegetal hemisphere. Among echinoderms, in euechinoids, once cleavages have started, the vegetal pole is characterized by the presence of the micromeres initially and then that of the small micromeres. Subsequently, it is marked by the site of ingression of the primary mesenchyme cells (PMCs), and finally in all echinoderms by the site of invagination and presence of the blastopore." []
is_a: ECAO:2000003 ! anatomical region
relationship: part_of ECAO:2000053 ! vegetal hemisphere

[Term]
id: ECAO:2000105
name: equator region
def: "The middle region of an oocyte or a zygote, which comprises the most basal portion of the animal and vegetal hemispheres." []
synonym: "equator" RELATED []
is_a: ECAO:2000003 ! anatomical region
relationship: part_of ECAO:2000008 ! embryo

[Term]
id: ECAO:2000106
name: equatorial pigment band
def: "An accumulation of pigment granules defining a band (the so-called ‘pigment band’) located in the vegetal hemisphere of mature oocytes or early stage embryos just beneath the equator. When present, it constitutes an unambiguous marker of animal-vegetal polarity." []
synonym: "pigment band" RELATED []
synonym: "pigmented band" RELATED []
is_a: ECAO:2000081 ! intracellular anatomical structure
relationship: part_of ECAO:2000053 ! vegetal hemisphere

[Term]
id: ECAO:2000107
name: fertilization envelope
def: "A structure that lies outside the plasma membrane and surrounds the fertilized eggs and early embryos. The fertilization envelope forms from the vitelline membrane after fertilization as a result of cortical granule release. It persists until hatching." []
synonym: "fertilization membrane" RELATED []
xref: GO:0060387
is_a: ECAO:2000080 ! cellular anatomical entity
relationship: part_of ECAO:2000008 ! embryo

[Term]
id: ECAO:2000108
name: vitelline membrane
def: "A structure directly adjacent to the outer surface of the plasma membrane of an ovum. It is composed mostly of protein fibers, with protein receptors needed for sperm binding. The species-specificity of these receptors contributes to prevention of breeding between different species." []
synonym: "vitelline layer" RELATED []
synonym: "vitelline envelope" RELATED []
xref: GO:0060388
is_a: ECAO:2000080 ! cellular anatomical entity
relationship: part_of ECAO:2000065 ! oocyte

[Term]
id: ECAO:2000109
name: cortical granule
def: "A secretory vesicle that is stored under the cell membrane of an egg. These vesicles fuse with the egg plasma membrane as part of egg activation and are part of the block to polyspermy." []
synonym: "cortical vesicle" RELATED []
xref: GO:0060473
is_a: ECAO:2000116 ! secretory vesicle
relationship: part_of ECAO:2000095 ! cytoplasm

[Term]
id: ECAO:2000110
name: aster
def: "An array of microtubules arranged radially that emanates from a spindle pole and is not connect to kinetochores." []
synonym: "spindle aster" RELATED []
synonym: "mitotic aster" RELATED []
xref: GO:0005818
is_a: ECAO:2000081 ! intracellular anatomical structure
relationship: part_of ECAO:2000088 ! microtubule cytoskeleton

[Term]
id: ECAO:2000111
name: kinetochore
def: "A multisubunit complex that is located on chromosomes and provides an attachment point for the spindle microtubules." []
xref: GO:0000776
is_a: ECAO:2000080 ! cellular anatomical entity
relationship: part_of ECAO:2000131 ! chromosome

[Term]
id: ECAO:2000112
name: extracellular matrix
def: "A structure lying external to one or more cells, which provides structural support, biochemical or biomechanical cues for cells or tissues." []
xref: GO:0031012
is_a: ECAO:2000080 ! cellular anatomical entity
relationship: part_of ECAO:2000006 ! multicellular organism

[Term]
id: ECAO:2000113
name: hyaline layer
def: "A multilayered extraembryonic matrix that functions as a substrate for cell adhesion through early development. It forms initially from molecules secreted from cortical granules at fertilization and is modified through the secretion of additional material during later development. The principal component of the hyaline layer is the protein, hyalin." []
synonym: "hyaline membrane" RELATED []
xref: GO:0033166
is_a: ECAO:2000080 ! cellular anatomical entity
relationship: part_of ECAO:2000112 ! extracellular matrix

[Term]
id: ECAO:2000114
name: apical lamina
def: "A fibrous, extracellular network that forms the inner part of the hyaline layer. The apical lamina persists after the biochemical removal of hyalin and is thought to be principally composed of the glycoproteins fibropellins." []
synonym: "fibropellin layer" RELATED []
xref: GO:0032579
is_a: ECAO:2000080 ! cellular anatomical entity
relationship: part_of ECAO:2000113 ! hyaline layer

[Term]
id: ECAO:2000115
name: microvillus
def: "A thin cylindrical membrane-covered projection on the surface of a cell containing a core bundle of actin filaments." []
xref: GO:0005902
is_a: ECAO:2000080 ! cellular anatomical entity
relationship: part_of ECAO:2000058 ! cell

[Term]
id: ECAO:2000116
name: secretory vesicle
def: "A cytoplasmic, membrane bound vesicle that is capable of fusing to the plasma membrane and to release its contents into the extracellular space." []
xref: GO:0099503
is_a: ECAO:2000081 ! intracellular anatomical structure
relationship: part_of ECAO:2000095 ! cytoplasm

[Term]
id: ECAO:2000117
name: cilium
def: "A specialized organelle that consists of a filiform extrusion of the cell surface and of some cytoplasmic parts. Each cilium is largely bounded by an extrusion of the cytoplasmic (plasma) membrane, and contains a regular longitudinal array of microtubules, anchored to a basal body." []
synonym: "flagellum" RELATED []
xref: GO:0005929
is_a: ECAO:2000081 ! intracellular anatomical structure
relationship: part_of ECAO:2000058 ! cell

[Term]
id: ECAO:2000118
name: apical cilium
def: "A cilium that develops on the apical surface of a cell." []
is_a: ECAO:2000117 ! cilium
relationship: part_of ECAO:2000006 ! multicellular organism

[Term]
id: ECAO:2000119
name: short motile cilium
def: "A cilium of short size exhibiting motility thanks to the molecular motors it contains. In echinoderms, short motile cilia are encountered on the outer surface of the developing embryo as well as in the developing and developed digestive tract of embryos and larvae." []
xref: GO:0031514
is_a: ECAO:2000117 ! cilium
relationship: part_of ECAO:2000013 ! pre-metamorphic organism

[Term]
id: ECAO:2000120
name: long immotile cilium
def: "A cilium of long size that does not contain molecular motors and as such does not exhibit any beating movement. In some echinoderms, long immotile cilia are found, when present, at the animal pole of embryos and constitute the apical tuft." []
synonym: "long non-motile cilium" RELATED []
synonym: "elongated cilium" RELATED []
xref: GO:0097730
is_a: ECAO:2000117 ! cilium
relationship: part_of ECAO:2000227 ! apical tuft

[Term]
id: ECAO:2000121
name: filopodium
def: "A thin, stiff, actin-based protrusion extended by the leading edge of a motile cell such as an ingressing or crawling mesenchyme cell." []
synonym: "pseudopod" RELATED []
xref: GO:0030175
is_a: ECAO:2000080 ! cellular anatomical entity
relationship: part_of ECAO:2000058 ! cell

[Term]
id: ECAO:2000122
name: filopodial cable
def: "A sheet-like cellular projection that is supported by an ordered network of actin filaments and that is involved in cellular motility and syncytium formation." []
synonym: "lamellipodia" RELATED []
xref: NCIT:C32914
is_a: ECAO:2000080 ! cellular anatomical entity
relationship: part_of ECAO:2000058 ! cell

[Term]
id: ECAO:2000123
name: basal lamina
def: "An acellular anatomical structure that consists of a thin sheet of fibrous proteins that underlie and support the cells of an epithelium. It separates the cells of an epithelium from any underlying tissue." []
xref: UBERON:0000482
is_a: ECAO:2000080 ! cellular anatomical entity
relationship: part_of ECAO:2000058 ! cell

[Term]
id: ECAO:2000124
name: basal laminar vesicle
def: "A secretory vesicle containing molecules that will be secreted and incorporated into the basal lamina." []
synonym: "basal lamina vesicle" RELATED []
synonym: "basal vesicle" RELATED []
is_a: ECAO:2000116 ! secretory vesicle
relationship: part_of ECAO:2000058 ! cell

[Term]
id: ECAO:2000125
name: apical vesicle
def: "A secretory vesicle found near the outer (apical) surface of an oocyte, a spermatozoid head, or an early blastomere, and that contains molecules that will be incorporated into the hyaline layer after secretion." []
is_a: ECAO:2000116 ! secretory vesicle
relationship: part_of ECAO:2000058 ! cell

[Term]
id: ECAO:2000126
name: echinonectin vesicle
def: "A secretory vesicle that contains echinonectin." []
synonym: "nectosome" RELATED []
synonym: "echinonectin granule" RELATED []
synonym: "EN-vesicle" RELATED []
is_a: ECAO:2000116 ! secretory vesicle
relationship: part_of ECAO:2000058 ! cell

[Term]
id: ECAO:2000127
name: mitochondrion
def: "A semiautonomous, self-replicating organelle that occurs in varying numbers, shapes, and sizes in the cytoplasm of the cells. It is notably the site of tissue respiration." []
synonym: "mitochondria" RELATED []
xref: GO:0005739
is_a: ECAO:2000081 ! intracellular anatomical structure
relationship: part_of ECAO:2000095 ! cytoplasm

[Term]
id: ECAO:2000128
name: nucleoplasm
def: "The portion of the nuclear content that is not the chromosomes or the nucleolus." []
xref: GO:0005654
is_a: ECAO:2000081 ! intracellular anatomical structure
relationship: part_of ECAO:2000093 ! nucleus

[Term]
id: ECAO:2000129
name: nuclear envelope
def: "A double lipid bilayer enclosing the nucleus and separating its contents from the rest of the cytoplasm." []
xref: GO:0005635
is_a: ECAO:2000081 ! intracellular anatomical structure
relationship: part_of ECAO:2000093 ! nucleus

[Term]
id: ECAO:2000130
name: nucleolus
def: "A small, dense body present in the nucleus of cells and that is rich in RNA and protein, not bounded by a limiting membrane, and not seen during mitosis." []
xref: GO:0005730
is_a: ECAO:2000081 ! intracellular anatomical structure
relationship: part_of ECAO:2000093 ! nucleus

[Term]
id: ECAO:2000131
name: chromosome
def: "A structure composed of a very long molecule of DNA and associated proteins (e.g. histones) that carries hereditary information." []
xref: GO:0005694
is_a: ECAO:2000081 ! intracellular anatomical structure
relationship: part_of ECAO:2000093 ! nucleus

[Term]
id: ECAO:2000132
name: endoplasmic reticulum
def: "A continuous membrane structure present in the cytoplasm and that fulfills multiple functions." []
xref: GO:0005783
is_a: ECAO:2000081 ! intracellular anatomical structure
relationship: part_of ECAO:2000095 ! cytoplasm

[Term]
id: ECAO:2000133
name: plasma membrane
def: "The membrane surrounding a cell and separating the cell from its external environment. It consists of a phospholipid bilayer and associated proteins." []
synonym: "cell membrane" RELATED []
xref: GO:0005886
is_a: ECAO:2000080 ! cellular anatomical entity
relationship: part_of ECAO:2000058 ! cell

[Term]
id: ECAO:2000134
name: polar body
def: "One of two small cells formed by the first and second meiotic division of oocytes." []
xref: CL:0002090
is_a: ECAO:2000058 ! cell
relationship: part_of ECAO:2000061 ! female germ cell

[Term]
id: ECAO:2000135
name: embryonic cell
def: "A cell in an embryo." []
xref: CL:0002321
is_a: ECAO:2000058 ! cell
relationship: develops_from ECAO:2000007 ! zygote
relationship: part_of ECAO:2000008 ! embryo

[Term]
id: ECAO:2000136
name: blastomere
def: "An undifferentiated cell produced by early cleavages of the fertilized egg (zygote)." []
synonym: "blastoderm cell" RELATED []
xref: CL:0000353
is_a: ECAO:2000135 ! embryonic cell
relationship: part_of ECAO:2000008 ! embryo

[Term]
id: ECAO:2000137
name: animal blastomere
def: "An undifferentiated cell part of the animal hemisphere of an embryo." []
is_a: ECAO:2000136 ! blastomere
relationship: part_of ECAO:2000052 ! animal hemisphere

[Term]
id: ECAO:2000138
name: vegetal blastomere
def: "An undifferentiated cell part of the vegetal hemisphere of an embryo." []
is_a: ECAO:2000136 ! blastomere
relationship: part_of ECAO:2000053 ! vegetal hemisphere

[Term]
id: ECAO:2000139
name: mesomere
def: "An intermediate size blastomere constituting the animal hemisphere of a 16-cell stage euechinoid embryo." []
synonym: "Mes" RELATED []
is_a: ECAO:2000137 ! animal blastomere
relationship: develops_from ECAO:2000148 ! animal quartet
relationship: part_of ECAO:2000052 ! animal hemisphere

[Term]
id: ECAO:2000140
name: macromere
def: "A large blastomere located in the vegetal hemisphere of a 16-cell stage euechinoid embryo." []
synonym: "Mac" RELATED []
is_a: ECAO:2000138 ! vegetal blastomere
relationship: develops_from ECAO:2000149 ! vegetal quartet
relationship: part_of ECAO:2000053 ! vegetal hemisphere

[Term]
id: ECAO:2000141
name: micromere
def: "A small blastomere located at the vegetal pole of a 16- and 28-cell stage euechinoid embryo." []
synonym: "Mic" RELATED []
is_a: ECAO:2000138 ! vegetal blastomere
relationship: develops_from ECAO:2000149 ! vegetal quartet
relationship: part_of ECAO:2000053 ! vegetal hemisphere

[Term]
id: ECAO:2000142
name: large micromere
def: "The largest of the two daughter cells of a micromere." []
synonym: "Lmic" RELATED []
is_a: ECAO:2000138 ! vegetal blastomere
relationship: develops_from ECAO:2000141 ! micromere
relationship: part_of ECAO:2000053 ! vegetal hemisphere

[Term]
id: ECAO:2000143
name: small micromere
def: "The smallest of the two daughter cells of a micromere." []
synonym: "SM" RELATED []
synonym: "sMic" RELATED []
is_a: ECAO:2000138 ! vegetal blastomere
relationship: develops_from ECAO:2000141 ! micromere
relationship: part_of ECAO:2000053 ! vegetal hemisphere

[Term]
id: ECAO:2000144
name: large micromere descendant cell
def: "A cell derived from a large micromere through cell division." []
synonym: "large micromere progeny" RELATED []
synonym: "presumptive PMC" RELATED []
synonym: "presumptive skeletogenic mesenchyme cell" RELATED []
synonym: "presumptive primary mesenchyme cell" RELATED []
synonym: "large micromere descendant" RELATED []
is_a: ECAO:2000135 ! embryonic cell
relationship: develops_from ECAO:2000142 ! large micromere
relationship: part_of ECAO:2000053 ! vegetal hemisphere

[Term]
id: ECAO:2000145
name: small micromere descendant cell
def: "A cell derived from a small micromere through cell division." []
synonym: "presumptive primordial germ cell" RELATED []
synonym: "germ line" RELATED []
is_a: ECAO:2000059 ! germ line cell
relationship: develops_from ECAO:2000143 ! small micromere
relationship: part_of ECAO:2000053 ! vegetal hemisphere

[Term]
id: ECAO:2000146
name: macromere descendant cell
def: "A cell derived from a macromere through cell division." []
is_a: ECAO:2000135 ! embryonic cell
relationship: develops_from ECAO:2000140 ! macromere
relationship: part_of ECAO:2000053 ! vegetal hemisphere

[Term]
id: ECAO:2000147
name: macromere daughter cell tier
def: "A tier of cells in the vegetal region of an euechinoid cleaving embryo that is composed of the 8 daughter cells of the macromeres." []
is_a: ECAO:2000056 ! vegetal cell tier
relationship: develops_from ECAO:2000140 ! macromere
relationship: part_of ECAO:2000053 ! vegetal hemisphere

[Term]
id: ECAO:2000148
name: animal quartet
def: "A group of four cells of equal size forming the animal hemisphere of an 8-cell stage embryo." []
synonym: "quartet of animal cell" RELATED []
is_a: ECAO:2000055 ! animal cell tier
relationship: part_of ECAO:2000052 ! animal hemisphere

[Term]
id: ECAO:2000149
name: vegetal quartet
def: "A group of four cells of equal size forming the vegetal hemisphere of an 8-cell stage embryo." []
synonym: "quartet of vegetal cell" RELATED []
is_a: ECAO:2000056 ! vegetal cell tier
relationship: part_of ECAO:2000053 ! vegetal hemisphere

[Term]
id: ECAO:2000150
name: animal tier 1
def: "A cell tier derived from the mesomeres through cell division. This cell tier is composed of the animal-most daughter cells of the mesomeres and encompasses 8 cells marking the animal pole of the euechinoid 32- and 64-cell stage embryo." []
synonym: "an1" RELATED []
is_a: ECAO:2000055 ! animal cell tier
relationship: develops_from ECAO:2000139 ! mesomere
relationship: part_of ECAO:2000052 ! animal hemisphere

[Term]
id: ECAO:2000151
name: animal tier 2
def: "A cell tier derived from the mesomeres through cell division. This cell tier is composed of the vegetal-most daughter cells of the mesomeres and encompasses 8 cells located adjacent to and on the vegetal side of the an1 tier of the euechinoid 32- and 64-cell stage embryo." []
synonym: "an2" RELATED []
is_a: ECAO:2000055 ! animal cell tier
relationship: develops_from ECAO:2000139 ! mesomere
relationship: part_of ECAO:2000052 ! animal hemisphere

[Term]
id: ECAO:2000152
name: vegetal tier 1
def: "A cell tier derived from the macromere daughter tier through cell division. The veg1 tier is composed of the animal-most daughter cells of the macromere daughter tier and is located adjacent to and on the vegetal side of the an2 tier of the euechinoid 56- and 64-cell stage embryo." []
synonym: "veg1" RELATED []
synonym: "ectoendoderm" RELATED []
is_a: ECAO:2000056 ! vegetal cell tier
relationship: develops_from ECAO:2000147 ! macromere daughter cell tier
relationship: part_of ECAO:2000053 ! vegetal hemisphere

[Term]
id: ECAO:2000153
name: vegetal tier 2
def: "A cell tier derived from the macromere daughter tier through cell division. The veg2 tier is composed of the vegetal-most daughter cells of the macromere daughter tier and is located adjacent to and on the vegetal side of the veg1 tier of the euechinoid 56- and 64-cell stage embryo." []
synonym: "veg2" RELATED []
synonym: "endomesoderm" RELATED []
is_a: ECAO:2000056 ! vegetal cell tier
relationship: develops_from ECAO:2000147 ! macromere daughter cell tier
relationship: part_of ECAO:2000053 ! vegetal hemisphere

[Term]
id: ECAO:2000154
name: vegetal tier 1 upper
def: "A cell tier derived from the veg1 tier through cell division. The veg1 upper tier is composed of the animal-most daughter cells of the veg1 tier and is located adjacent to and on the vegetal side of the an2 tier of euechinoid embryos." []
synonym: "veg1U" RELATED []
synonym: "veg1 upper" RELATED []
is_a: ECAO:2000056 ! vegetal cell tier
relationship: develops_from ECAO:2000152 ! vegetal tier 1
relationship: part_of ECAO:2000053 ! vegetal hemisphere

[Term]
id: ECAO:2000155
name: vegetal tier 1 lower
def: "A cell tier derived from the veg1 tier through cell division. The veg1 lower tier is composed of the vegetal-most daughter cells of the veg1 tier and is located adjacent to and on the vegetal side of the veg1 upper tier of euechinoid embryos." []
synonym: "veg1L" RELATED []
synonym: "veg1 lower" RELATED []
is_a: ECAO:2000056 ! vegetal cell tier
relationship: develops_from ECAO:2000152 ! vegetal tier 1
relationship: part_of ECAO:2000053 ! vegetal hemisphere

[Term]
id: ECAO:2000156
name: vegetal tier 2 upper
def: "A cell tier derived from the veg2 tier through cell division. The veg2 upper tier is composed of the animal-most daughter cells of the veg2 tier and is located adjacent to and on the vegetal side of the veg1 lower tier of euechinoid embryos." []
synonym: "veg2U" RELATED []
synonym: "veg2 upper" RELATED []
is_a: ECAO:2000056 ! vegetal cell tier
relationship: develops_from ECAO:2000153 ! vegetal tier 2
relationship: part_of ECAO:2000053 ! vegetal hemisphere

[Term]
id: ECAO:2000157
name: vegetal tier 2 lower
def: "A cell tier derived from the veg2 tier through cell division. The veg2 lower tier is composed of the vegetal-most daughter cells of the veg2 tier and is located adjacent to and on the vegetal side of the veg2 upper tier of euechinoid embryos." []
synonym: "veg2L" RELATED []
synonym: "veg2 lower" RELATED []
is_a: ECAO:2000056 ! vegetal cell tier
relationship: develops_from ECAO:2000153 ! vegetal tier 2
relationship: part_of ECAO:2000053 ! vegetal hemisphere

[Term]
id: ECAO:2000158
name: presumptive blastocoel
def: "The inner, extracellular space between blastomeres of the cleavage stage embryos that will gradually expand and form the blastocoel." []
is_a: ECAO:2000004 ! anatomical space
relationship: part_of ECAO:2000008 ! embryo

[Term]
id: ECAO:2000159
name: blastocoel
def: "The inner, extracellular cavity of the embryo that arises at the blastula stage." []
xref: XAO:0000294
is_a: ECAO:2000004 ! anatomical space
relationship: develops_from ECAO:2000158 ! presumptive blastocoel
relationship: part_of ECAO:2000008 ! embryo

[Term]
id: ECAO:2000160
name: blastocoel roof
def: "The most apical region of the blastocoel." []
is_a: ECAO:2000018 ! embryonic region
relationship: part_of ECAO:2000159 ! blastocoel

[Term]
id: ECAO:2000161
name: blastocoel wall
def: "The region of the blastocoel comprised in the middle region of the embryo, below the blastocoel roof." []
is_a: ECAO:2000018 ! embryonic region
relationship: part_of ECAO:2000159 ! blastocoel

[Term]
id: ECAO:2000162
name: germ layer
def: "A layer of cells produced during the early development of an embryo and that is distinct from other such layers of cells, as an early step of cell differentiation." []
synonym: "primary germ layer" RELATED []
xref: UBERON_0000923
is_a: ECAO:2000021 ! tissue
relationship: part_of ECAO:2000008 ! embryo

[Term]
id: ECAO:2000163
name: presumptive ectoderm
def: "The region of the early embryo that will develop into ectoderm." []
synonym: "embryonic presumptive ectoderm" RELATED []
xref: UBERON:0006601
is_a: ECAO:2000018 ! embryonic region
relationship: develops_from ECAO:2000139 ! mesomere
relationship: part_of ECAO:2000052 ! animal hemisphere

[Term]
id: ECAO:2000164
name: ectoderm
def: "The outermost primary germ layer, which forms during gastrulation and will give rise to tissues such as epithelium and nervous system." []
xref: UBERON:0000924
is_a: ECAO:2000162 ! germ layer
relationship: develops_from ECAO:2000163 ! presumptive ectoderm
relationship: part_of ECAO:2000006 ! multicellular organism

[Term]
id: ECAO:2000165
name: ectoderm cell
def: "A cell part of the ectoderm germ layer." []
synonym: "ectodermal cell" RELATED []
xref: CL:0000221
is_a: ECAO:2000058 ! cell
relationship: part_of ECAO:2000164 ! ectoderm

[Term]
id: ECAO:2000166
name: epidermis
def: "An epithelium derived from ectoderm and constituting the outermost protective layer of an embryo, a larva, or an adult." []
is_a: ECAO:2000021 ! tissue
relationship: develops_from ECAO:2000164 ! ectoderm
relationship: part_of ECAO:2000006 ! multicellular organism

[Term]
id: ECAO:2000167
name: epithelium
def: "A tissue that consists of one or more layers of epithelial cells connected to each other by cell junctions and which is underlain by a basal lamina." []
xref: UBERON:0000483
is_a: ECAO:2000021 ! tissue
relationship: part_of ECAO:2000006 ! multicellular organism

[Term]
id: ECAO:2000168
name: embryonic ectoderm
def: "The ectoderm that is specifically present in an embryo" []
is_a: ECAO:2000164 ! ectoderm
relationship: develops_from ECAO:2000163 ! presumptive ectoderm
relationship: part_of ECAO:2000008 ! embryo

[Term]
id: ECAO:2000169
name: larval ectoderm
def: "The ectoderm that is specifically present in a larva." []
is_a: ECAO:2000164 ! ectoderm
relationship: develops_from ECAO:2000168 ! embryonic ectoderm
relationship: part_of ECAO:2000012 ! larva

[Term]
id: ECAO:2000170
name: pre-metamorphic organism ectoderm
def: "The ectoderm that is specifically present in an embryo and a larva but not in an adult." []
is_a: ECAO:2000164 ! ectoderm
relationship: part_of ECAO:2000013 ! pre-metamorphic organism

[Term]
id: ECAO:2000171
name: animal ectoderm
def: "The ectoderm that develops in the animal hemisphere of the embryo and is located above the ectoendoderm." []
is_a: ECAO:2000163 ! presumptive ectoderm
relationship: develops_from ECAO:2000148 ! animal quartet
relationship: part_of ECAO:2000052 ! animal hemisphere

[Term]
id: ECAO:2000172
name: vegetal tier 1  ectoderm
def: "The ectoderm that specifically derives from cells of the veg1 tier." []
synonym: "veg1 ecto" RELATED []
synonym: "veg1 ectoderm" RELATED []
is_a: ECAO:2000163 ! presumptive ectoderm
relationship: develops_from ECAO:2000192 ! ectoendoderm
relationship: part_of ECAO:2000008 ! embryo

[Term]
id: ECAO:2000173
name: non-apical ectoderm
def: "The ectoderm that is part of the animal ectoderm but located below the apical pole domain ectoderm." []
is_a: ECAO:2000163 ! presumptive ectoderm
relationship: part_of ECAO:2000171 ! animal ectoderm

[Term]
id: ECAO:2000174
name: apical pole domain
def: "A thickened region at the animal hemisphere, located at the animal pole, and that contains developing neurons and cells with elongated cilia." []
synonym: "animal pole domain" RELATED []
synonym: "apical plate" RELATED []
synonym: "animal plate" RELATED []
is_a: ECAO:2000018 ! embryonic region
relationship: part_of ECAO:2000008 ! embryo

[Term]
id: ECAO:2000175
name: apical pole domain ectoderm
def: "The ectoderm that is part of the animal ectoderm and is specifically restricted to the apical pole domain." []
synonym: "apical ectoderm" RELATED []
is_a: ECAO:2000171 ! animal ectoderm
relationship: part_of ECAO:2000174 ! apical pole domain

[Term]
id: ECAO:2000176
name: presumptive oral ectoderm
def: "The portion of the presumptive ectoderm that is located on the oral side of the embryo (which will later generate the ventral side of the larva)." []
is_a: ECAO:2000018 ! embryonic region
relationship: part_of ECAO:2000163 ! presumptive ectoderm

[Term]
id: ECAO:2000177
name: oral ectoderm
def: "The portion of the embryonic ectoderm that is located on the oral side of the embryo and will give rise to ventral ectoderm of the larva." []
is_a: ECAO:2000163 ! presumptive ectoderm
relationship: develops_from ECAO:2000176 ! presumptive oral ectoderm
relationship: part_of ECAO:2000008 ! embryo

[Term]
id: ECAO:2000178
name: ventral ectoderm
def: "The portion of the ectoderm that is on the ventral side of the larva." []
synonym: "oral ectoderm" RELATED []
synonym: "oral animal ectoderm" RELATED []
is_a: ECAO:2000019 ! larval region
relationship: develops_from ECAO:2000177 ! oral ectoderm
relationship: part_of ECAO:2000169 ! larval ectoderm

[Term]
id: ECAO:2000179
name: presumptive aboral ectoderm
def: "The portion of the presumptive ectoderm that is located on the aboral side of the embryo (which will later generate the dorsal side of the larva)." []
synonym: "lateral-aboral pre-state ectoderm" RELATED []
is_a: ECAO:2000018 ! embryonic region
relationship: part_of ECAO:2000163 ! presumptive ectoderm

[Term]
id: ECAO:2000180
name: aboral ectoderm
def: "The portion of the embryonic ectoderm that is located on the aboral side of the embryo and will give rise to dorsal ectoderm of the larva." []
is_a: ECAO:2000163 ! presumptive ectoderm
relationship: develops_from ECAO:2000179 ! presumptive aboral ectoderm
relationship: part_of ECAO:2000008 ! embryo

[Term]
id: ECAO:2000181
name: dorsal ectoderm
def: "The portion of the ectoderm that is located on the dorsal side of the larva." []
synonym: "aboral ectoderm" RELATED []
synonym: "animal aboral ectoderm" RELATED []
is_a: ECAO:2000019 ! larval region
relationship: develops_from ECAO:2000181 ! dorsal ectoderm
relationship: part_of ECAO:2000169 ! larval ectoderm

[Term]
id: ECAO:2000182
name: lateral ectoderm
def: "The portion of the ectoderm that is located between the oral and aboral ectoderm of an embryo or the ventral and dorsal ectoderm of a larva." []
synonym: "lateral animal ectoderm" RELATED []
synonym: "ciliary band ectoderm" RELATED []
is_a: ECAO:2000003 ! anatomical region
relationship: develops_from ECAO:2000163 ! presumptive ectoderm

[Term]
id: ECAO:2000183
name: equatorial ectoderm
def: "A transient territory of the embryonic presumptive ectoderm that is located between the apical pole domain ectoderm and the endomesoderm." []
is_a: ECAO:2000018 ! embryonic region
relationship: part_of ECAO:2000163 ! presumptive ectoderm

[Term]
id: ECAO:2000184
name: border ectoderm
def: "A circumferential band of embryonic presumptive ectoderm or ectoderm located near the equator of the embryo, immediately anterior to the presumptive endoderm or endoderm." []
synonym: "BE" RELATED []
synonym: "posterior ectoderm" RELATED []
synonym: "veg1 ectoderm" RELATED []
is_a: ECAO:2000018 ! embryonic region
relationship: develops_from ECAO:2000192 ! ectoendoderm
relationship: part_of ECAO:2000183 ! equatorial ectoderm

[Term]
id: ECAO:2000185
name: central ectoderm
def: "A region of the presumptive ectoderm derived from the animal hemisphere and that is located below the near-apical ectoderm and above the veg1 ectoderm." []
is_a: ECAO:2000018 ! embryonic region
relationship: part_of ECAO:2000173 ! non-apical ectoderm

[Term]
id: ECAO:2000186
name: near apical ectoderm
def: "A region of the presumptive ectoderm derived from the animal hemisphere and located between below the animal pole domain ectoderm and above the central ectoderm." []
is_a: ECAO:2000018 ! embryonic region
relationship: part_of ECAO:2000173 ! non-apical ectoderm

[Term]
id: ECAO:2000187
