is_a: ECAO:2000058 ! cell
relationship: part_of ECAO:2000485 ! endoderm

[Term]
id: ECAO:2000487
name: vegetal tier 1 endoderm
def: "The presumptive endoderm that develops specifically from the cells of the vegetal tier 1." []
synonym: "veg1 endo" RELATED []
synonym: "veg1 endoderm" RELATED []
is_a: ECAO:2000484 ! presumptive endoderm
relationship: develops_from ECAO:2000192 ! ectoendoderm
relationship: part_of ECAO:2000053 ! vegetal hemisphere

[Term]
id: ECAO:2000488
