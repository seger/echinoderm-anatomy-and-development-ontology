relationship: develops_from ECAO:2000504 ! midgut
relationship: part_of ECAO:2000012 ! larva

[Term]
id: ECAO:2000525
name: larval esophagus
def: "The esophagus of a larva." []
is_a: ECAO:2000521 ! esophagus
relationship: develops_from ECAO:2000505 ! foregut
relationship: part_of ECAO:2000012 ! larva

[Term]
id: ECAO:2000526
name: larval intestine
def: "The intestine of a larva." []
is_a: ECAO:2000523 ! intestine
relationship: develops_from ECAO:2000503 ! hindgut
relationship: part_of ECAO:2000012 ! larva

[Term]
id: ECAO:2000527
name: coelom
def: "A mesodermally lined cavity that in adult is positioned inside the body to surround and contain the digestive tract and other organs, while in embryos and larvae it forms from the tip of the archenteron and lie between the gut and the outer body wall." []
xref: UBERON:0011997
is_a: ECAO:2000001 ! anatomical structure
relationship: part_of ECAO:2000006 ! multicellular organism

[Term]
id: ECAO:2000528
name: coelomic evagination
def: "The outpocketing of the mesoderm constituting the tip of the archenteron and forming a bilobed bag (or pouch) lying on the top of the archenteron roof." []
synonym: "unpaired coelomic pouch" RELATED []
synonym: "unpaired coelomic rudiment" RELATED []
synonym: "unpaired coelomic outpocketing" RELATED []
synonym: "unpaired coelomic evaginations" RELATED []
synonym: "unpaire evagination of the coelom" RELATED []
is_a: ECAO:2000001 ! anatomical structure
relationship: develops_from ECAO:2000495 ! archenteron tip
relationship: part_of ECAO:2000008 ! embryo

[Term]
id: ECAO:2000529
name: coelomic pouch
def: "A mesodermally lined pouch (or pocket) lying between the anterior tip of the archenteron and the outer body wall." []
is_a: ECAO:2000527 ! coelom
relationship: develops_from ECAO:2000495 ! archenteron tip
relationship: part_of ECAO:2000013 ! pre-metamorphic organism

[Term]
id: ECAO:2000530
name: right coelomic pouch
def: "The coelomic pouch present on the right side of the embryo or the larva." []
synonym: "right coelomic sac" RELATED []
is_a: ECAO:2000529 ! coelomic pouch
relationship: develops_from ECAO:2000528 ! coelomic evagination
relationship: part_of ECAO:2000013 ! pre-metamorphic organism

[Term]
id: ECAO:2000531
name: left coelomic pouch
def: "The coelomic pouch present on the left side of the embryo or the larva." []
synonym: "left coelomic sac" RELATED []
is_a: ECAO:2000529 ! coelomic pouch
relationship: develops_from ECAO:2000528 ! coelomic evagination
relationship: part_of ECAO:2000013 ! pre-metamorphic organism

[Term]
id: ECAO:2000532
name: constriction
def: "A narrowing (or shrinking) within a tissue or organ to delineate different regions with different fates." []
is_a: ECAO:2000005 ! anatomical element
relationship: part_of ECAO:2000006 ! multicellular organism

[Term]
id: ECAO:2000533
name: coelomic constriction
def: "A constriction taking place at the level of a coelom. It can either separate the coelom from the archenteron or lead to the compartmentalization  of the coelom into distinct regions." []
synonym: "coelom constriction" RELATED []
is_a: ECAO:2000532 ! constriction
relationship: part_of ECAO:2000527 ! coelom

[Term]
id: ECAO:2000534
name: right coelomic constriction
def: "A constriction that takes place within a right coelomic pouch." []
is_a: ECAO:2000533 ! coelomic constriction
relationship: part_of ECAO:2000530 ! right coelomic pouch

[Term]
id: ECAO:2000535
name: left coelomic constriction
def: "A constriction that takes place within a left coelomic pouch." []
is_a: ECAO:2000533 ! coelomic constriction
relationship: part_of ECAO:2000531 ! left coelomic pouch

[Term]
id: ECAO:2000536
name: anterior coelomic pouch
def: "In species with a posterior enterocoel, the anterior coelomic pouch is the one that develops from the unpaired coelomic evaginations at the tip of the archenteron." []
is_a: ECAO:2000529 ! coelomic pouch
relationship: develops_from ECAO:2000528 ! coelomic evagination
relationship: part_of ECAO:2000012 ! larva

[Term]
id: ECAO:2000537
name: left anterior coelomic pouch
def: "In species with a posterior enterocoel, it is the coelomic pouch that develops at the tip of the archenteron on the left side of the embryo." []
synonym: "left anterior coelom" RELATED []
is_a: ECAO:2000536 ! anterior coelomic pouch
relationship: part_of ECAO:2000013 ! pre-metamorphic organism

[Term]
id: ECAO:2000538
name: right anterior coelomic pouch
def: "In species with a posterior enterocoel, it is the coelomic pouch that develops at the tip of the archenteron on the right side of the embryo." []
synonym: "right anterior coelom" RELATED []
is_a: ECAO:2000536 ! anterior coelomic pouch
relationship: part_of ECAO:2000013 ! pre-metamorphic organism

[Term]
id: ECAO:2000539
name: posterior enterocoel
def: "An evagination of the midgut that will contribute to the development of the adult body." []
synonym: "PE" RELATED []
is_a: ECAO:2000527 ! coelom
relationship: develops_from ECAO:2000504 ! midgut
relationship: part_of ECAO:2000013 ! pre-metamorphic organism

[Term]
id: ECAO:2000540
name: larval epidermis
def: "An epidermal tissue present in the larva." []
is_a: ECAO:2000021 ! tissue
relationship: develops_from ECAO:2000164 ! ectoderm
relationship: part_of ECAO:2000012 ! larva

[Term]
id: ECAO:2000541
name: ventral epiderms
def: "The epidermal tissue of the larva that surrounds the mouth." []
synonym: "oral epidermis" RELATED []
synonym: "circumoral epithelium" RELATED []
synonym: "circumoral ectoderm" RELATED []
is_a: ECAO:2000540 ! larval epidermis
relationship: develops_from ECAO:2000178 ! ventral ectoderm
relationship: part_of ECAO:2000012 ! larva

[Term]
id: ECAO:2000542
name: dorsal epidermis
def: "The epidermal tissue of the larva that is on the side opposite to the mouth." []
synonym: "aboral epidermis" RELATED []
is_a: ECAO:2000540 ! larval epidermis
relationship: develops_from ECAO:2000181 ! dorsal ectoderm
relationship: part_of ECAO:2000012 ! larva

[Term]
id: ECAO:2000543
name: primary pore canal rudiment
def: "A strand of mesenchyme cells that extends from the left (or left anterior) coelom towards the ectoderm and will give rise to the primary pore canal." []
synonym: "presumptive hydropore canal" RELATED []
synonym: "hydropore canal rudiment" RELATED []
is_a: ECAO:2000001 ! anatomical structure
relationship: develops_from ECAO:2000531 ! left coelomic pouch
relationship: part_of ECAO:2000008 ! embryo

[Term]
id: ECAO:2000544
name: primary pore canal
def: "A slender, tube-like extending between the left (or left anterior) coelom and the hydropore." []
synonym: "hydropore canal" RELATED []
is_a: ECAO:2000001 ! anatomical structure
relationship: develops_from ECAO:2000543 ! primary pore canal rudiment
relationship: part_of ECAO:2000014 ! post-embryonic organism

[Term]
id: ECAO:2000545
name: hydropore
def: "The orifice at the end of the primary pore canal making the connection between the canal and the external environment." []
synonym: "primary pore" RELATED []
is_a: ECAO:2000001 ! anatomical structure
relationship: develops_from ECAO:2000543 ! primary pore canal rudiment
relationship: part_of ECAO:2000014 ! post-embryonic organism

[Term]
id: ECAO:2000546
name: presumptive mesoderm
def: "The region of the early embryo that will develop into mesoderm." []
synonym: "prospective mesoderm" RELATED []
xref: UBERON:0006603
is_a: ECAO:2000018 ! embryonic region
relationship: part_of ECAO:2000053 ! vegetal hemisphere

[Term]
id: ECAO:2000547
name: mesoderm
def: "The middle primary germ layer, which forms during gastrulation and will give rise to tissues such as muscle, immune cells, and the skeleton." []
xref: UBERON:0000926
is_a: ECAO:2000162 ! germ layer
relationship: develops_from ECAO:2000546 ! presumptive mesoderm
relationship: part_of ECAO:2000006 ! multicellular organism

[Term]
id: ECAO:2000548
name: mesenchyme
def: "A tissue composed of mesenchymal cells." []
xref: UBERON:0003104
is_a: ECAO:2000021 ! tissue
relationship: develops_from ECAO:2000547 ! mesoderm
relationship: part_of ECAO:2000006 ! multicellular organism

[Term]
id: ECAO:2000549
name: mesenchyme cell
def: "A cell that has undergone epithelial to mesenchymal transition and is capable of migration." []
synonym: "mesenchymal cell" RELATED []
synonym: "motile cell" RELATED []
synonym: "migratory cell" RELATED []
xref: CL:0008019
is_a: ECAO:2000058 ! cell
relationship: develops_from ECAO:2000547 ! mesoderm
relationship: part_of ECAO:2000548 ! mesenchyme

[Term]
id: ECAO:2000550
name: presumptive skeletogenic mesoderm
def: "The region of the early embryo that will develop into skeletogenic mesoderm." []
is_a: ECAO:2000546 ! presumptive mesoderm
relationship: develops_from ECAO:2000547 ! mesoderm
relationship: part_of ECAO:2000008 ! embryo

[Term]
id: ECAO:2000551
name: skeletogenic mesoderm
def: "The subset of the mesoderm germ layer that will exclusively give rise to the endoskeleton." []
is_a: ECAO:2000021 ! tissue
relationship: develops_from ECAO:2000550 ! presumptive skeletogenic mesoderm
relationship: part_of ECAO:2000547 ! mesoderm

[Term]
id: ECAO:2000552
name: skeletogenic mesoderm cell
def: "A cell that has the potential of developing into a skeletogenic mesenchyme cell (or skeletal cell)." []
synonym: "skeletogenic cell" RELATED []
xref: CL:0007001
is_a: ECAO:2000058 ! cell
relationship: part_of ECAO:2000551 ! skeletogenic mesoderm

[Term]
id: ECAO:2000553
name: skeletogenic mesenchyme
def: "The portion of the mesenchyme tissue that constitutes the endoskeleton." []
is_a: ECAO:2000021 ! tissue
relationship: develops_from ECAO:2000551 ! skeletogenic mesoderm
relationship: part_of ECAO:2000548 ! mesenchyme

[Term]
id: ECAO:2000554
name: skeletogenic mesenchyme cell
def: "A cell that after having undergone epithelial to mesenchymal transition participates in constituting the endoskeleton." []
synonym: "skeletal cell" RELATED []
is_a: ECAO:2000058 ! cell
relationship: part_of ECAO:2000553 ! skeletogenic mesenchyme

[Term]
id: ECAO:2000555
name: embryonic skeletogenic mesenchyme
def: "The skeletogenic mesenchyme that  is specifically present in an embryo and produces the embryonic endoskeleton." []
synonym: "skeletogenic mesenchyme" RELATED []
synonym: "SM" RELATED []
synonym: "primary mesenchyme" RELATED []
is_a: ECAO:2000553 ! skeletogenic mesenchyme
relationship: part_of ECAO:2000008 ! embryo

[Term]
id: ECAO:2000556
name: embryonic skeletogenic mesenchyme cell
def: "A cell that is part of the embryonic skeletogenic mesenchyme and constitutes the embryonic endoskeleton." []
synonym: "PMC" RELATED []
synonym: "primary mesenchyme cell" RELATED []
synonym: "skeletogenic primary mesenchyme cell" RELATED []
synonym: "skeletogenic mesenchyme cell" RELATED []
synonym: "SM cell" RELATED []
is_a: ECAO:2000554 ! skeletogenic mesenchyme cell
relationship: part_of ECAO:2000555 ! embryonic skeletogenic mesenchyme

[Term]
id: ECAO:2000557
name: larval skeletogenic mesenchyme
def: "The skeletogenic mesenchyme that emerges during the larval development phase and participates in the elaboration of the larval endoskeleton." []
is_a: ECAO:2000553 ! skeletogenic mesenchyme
relationship: part_of ECAO:2000012 ! larva

[Term]
id: ECAO:2000558
name: larval skeletogenic mesenchyme cell
def: "A cell that is part of the larval skeletogenic mesenchyme and constitutes the larval endoskeleton." []
is_a: ECAO:2000554 ! skeletogenic mesenchyme cell
relationship: part_of ECAO:2000557 ! larval skeletogenic mesenchyme

[Term]
id: ECAO:2000559
name: syncytium
def: "A multinculeated cell formed by the fusion of individual cells." []
synonym: "multinucleate cell" RELATED []
synonym: "multinucleated cell" RELATED []
synonym: "syncitium" RELATED []
synonym: "syncytial cell" RELATED []
synonym: "syncytial network" RELATED []
xref: CL:0000228
is_a: ECAO:2000058 ! cell
relationship: develops_from ECAO:2000549 ! mesenchyme cell
relationship: part_of ECAO:2000006 ! multicellular organism

[Term]
id: ECAO:2000560
name: syncytial filipodial cable
def: "A filopodial cable that participates in the establishment of a syncytium." []
synonym: "syncytial lamellipodia" RELATED []
synonym: "syncytial cable" RELATED []
is_a: ECAO:2000026 ! embryonic structure
relationship: part_of ECAO:2000559 ! syncytium

[Term]
id: ECAO:2000561
name: embryonic skeletogenic mesenchyme syncytium
def: "A syncytium that is composed of skeletogenic mesenchyme cells that have fused to form an interconnected network." []
is_a: ECAO:2000559 ! syncytium
relationship: develops_from ECAO:2000555 ! embryonic skeletogenic mesenchyme
relationship: part_of ECAO:2000008 ! embryo

[Term]
id: ECAO:2000562
name: subequatorial skeletogenic mesenchyme ring
def: "The circumferential, syncytial network of embryonic skeletogenic mesenchyme cells that forms between the equator and the vegetal pole of the embryo during gastrulation and surrounds the developing digestive tract." []
synonym: "SM ring" RELATED []
synonym: "subequatorial SM ring" RELATED []
synonym: "PMC ring" RELATED []
synonym: "subequatorial PMC ring" RELATED []
synonym: "primary mesenchyme cell ring" RELATED []
synonym: "subequatorial primary mesenchyme cell ring" RELATED []
is_a: ECAO:2000026 ! embryonic structure
relationship: part_of ECAO:2000561 ! embryonic skeletogenic mesenchyme syncytium

[Term]
id: ECAO:2000563
name: chain of skeletogenic mesenchyme cell
def: "A straight, syncitial network that either links the two ventrolateral skeletogenic mesenchyme clusters within the subequatorial skeletogenic mesenchyme ring or extends from the ventrolateral skeletogenic mesenchyme clusters towards the animal pole domain." []
is_a: ECAO:2000026 ! embryonic structure
relationship: develops_from ECAO:2000555 ! embryonic skeletogenic mesenchyme
relationship: part_of ECAO:2000562 ! subequatorial skeletogenic mesenchyme ring

[Term]
id: ECAO:2000564
name: oral chain of skeletogenic mesenchyme cell
def: "The chain of skeletogenic mesenchyme cell that within the subequatorial skeletogenic mesenchyme ring links the two ventrolateral skeletogenic mesenchyme clusters on the oral side of the embryo. The ventral transverse rods will be deposited along this cellular strand." []
synonym: "ventral chain of PMCs" RELATED []
synonym: "oral chain of PMCs" RELATED []
synonym: "ventral skeletogenic mesenchyme chain" RELATED []
is_a: ECAO:2000563 ! chain of skeletogenic mesenchyme cell
relationship: develops_from ECAO:2000555 ! embryonic skeletogenic mesenchyme
relationship: part_of ECAO:2000562 ! subequatorial skeletogenic mesenchyme ring

[Term]
id: ECAO:2000565
name: aboral chain of skeletogenic mesenchyme cell
def: "The chain of skeletogenic mesenchyme cell that within the subequatorial skeletogenic mesenchyme ring links the two ventrolateral skeletogenic mesenchyme clusters on the aboral side of the embryo. The body rods will be deposited along this cellular strand." []
synonym: "dorsal chain of PMCs" RELATED []
synonym: "aboral chain of PMCs" RELATED []
synonym: "dorsal skeletogenic mesenchyme chain" RELATED []
is_a: ECAO:2000563 ! chain of skeletogenic mesenchyme cell
relationship: develops_from ECAO:2000555 ! embryonic skeletogenic mesenchyme
relationship: part_of ECAO:2000562 ! subequatorial skeletogenic mesenchyme ring

[Term]
id: ECAO:2000566
name: skeletogenic mesenchyme cluster
def: "A cluster of skeletogenic mesenchyme cells that aggregates before any calcification event whether in the embryo, the larva, or the adult." []
is_a: ECAO:2000001 ! anatomical structure
relationship: part_of ECAO:2000006 ! multicellular organism

[Term]
id: ECAO:2000567
name: ventrolateral skeletogenic mesenchyme cluster
def: "A skeletogenic mesenchyme cluster that forms in the ventrolateral region of the subequatorial skeletogenic mesenchyme ring of an embryo and will be the seat of a triradiate spicule rudiment." []
synonym: "ventrolateral cluster" RELATED []
synonym: "ventrolateral cluster of skeletogenic mesenchyme cells" RELATED []
is_a: ECAO:2000026 ! embryonic structure
relationship: develops_from ECAO:2000555 ! embryonic skeletogenic mesenchyme
relationship: part_of ECAO:2000562 ! subequatorial skeletogenic mesenchyme ring

[Term]
id: ECAO:2000568
name: right ventrolateral skeletogenic mesenchyme cluster
def: "A skeletogenic mesenchyme cluster that forms in the right, ventrolateral region of the embryo." []
is_a: ECAO:2000567 ! ventrolateral skeletogenic mesenchyme cluster
relationship: develops_from ECAO:2000555 ! embryonic skeletogenic mesenchyme
relationship: part_of ECAO:2000562 ! subequatorial skeletogenic mesenchyme ring

[Term]
id: ECAO:2000569
name: left ventrolateral skeletogenic mesenchyme cluster
def: "A skeletogenic mesenchyme cluster that forms in the left, ventrolateral region of the embryo." []
is_a: ECAO:2000567 ! ventrolateral skeletogenic mesenchyme cluster
relationship: develops_from ECAO:2000555 ! embryonic skeletogenic mesenchyme
relationship: part_of ECAO:2000562 ! subequatorial skeletogenic mesenchyme ring

[Term]
id: ECAO:2000570
name: lateral chain of skeletogenic mesenchyme cell
def: "A chain of skeletogenic mesenchyme cell that extends from a ventrolateral cluster toward the animal pole. A dorsoventral connecting rod will be deposited along this cellular strand." []
synonym: "lateral chain of PMCs" RELATED []
is_a: ECAO:2000563 ! chain of skeletogenic mesenchyme cell
relationship: develops_from ECAO:2000556 ! embryonic skeletogenic mesenchyme cell
relationship: part_of ECAO:2000561 ! embryonic skeletogenic mesenchyme syncytium

[Term]
id: ECAO:2000571
name: right lateral chain of skeletogenic mesenchyme cell
def: "The lateral chain that forms on the right side of the embryo from the right ventrolateral cluster." []
synonym: "right lateral chain of PMCs" RELATED []
is_a: ECAO:2000570 ! lateral chain of skeletogenic mesenchyme cell
relationship: part_of ECAO:2000561 ! embryonic skeletogenic mesenchyme syncytium

[Term]
id: ECAO:2000572
name: left lateral chain of skeletogenic mesenchyme cell
def: "The lateral chain that forms on the left side of the embryo from the left ventrolateral cluster." []
synonym: "left lateral chain of PMCs" RELATED []
is_a: ECAO:2000570 ! lateral chain of skeletogenic mesenchyme cell
relationship: part_of ECAO:2000561 ! embryonic skeletogenic mesenchyme syncytium

[Term]
id: ECAO:2000573
name: spicule granule
def: "A very small, punctate deposit of calcite; i.e., the biomineralized primordium for spicule formation. It will undergo growth and often branching to produce a complex skeletal element." []
synonym: "spicule primordium" RELATED []
synonym: "spicule rudiment" RELATED []
synonym: "small granules of calcite" RELATED []
synonym: "spicule dot" RELATED []
synonym: "spicule crystal" RELATED []
synonym: "amorphous calcium carbonate-containing granule" RELATED []
synonym: "rhombohedral calcite crystal" RELATED []
synonym: "rhombohedral crystal" RELATED []
