relationship: part_of ECAO:2000045 ! endoskeleton

[Term]
id: ECAO:2000574
name: triradiate spicule rudiment
def: "A skeletal, calcified structure composed of three short radii extending from a central point, the radii being separated by angles of 120 degrees." []
synonym: "spicule rudiment" RELATED []
synonym: "triradiate element with elongating skeletal rods" RELATED []
is_a: ECAO:2000049 ! skeletal element
relationship: develops_from ECAO:2000573 ! spicule granule
relationship: part_of ECAO:2000045 ! endoskeleton

[Term]
id: ECAO:2000575
name: triradiate spicule
def: "A skeletal, calcified structure composed of three elongated skeletal rods." []
synonym: "triradiate element" RELATED []
is_a: ECAO:2000049 ! skeletal element
relationship: develops_from ECAO:2000574 ! triradiate spicule rudiment
relationship: part_of ECAO:2000045 ! endoskeleton

[Term]
id: ECAO:2000576
name: ventrolateral spicule granule
def: "A spicule granule that forms within a ventrolateral cluster of skeletogenic mesenchyme cells." []
is_a: ECAO:2000573 ! spicule granule
relationship: develops_from ECAO:2000567 ! ventrolateral skeletogenic mesenchyme cluster
relationship: part_of ECAO:2000046 ! embryonic endoskeleton

[Term]
id: ECAO:2000577
name: right ventrolateral spicule granule
def: "A ventrolateral spicule granule that forms on the right side of the embryo." []
is_a: ECAO:2000576 ! ventrolateral spicule granule
relationship: develops_from ECAO:2000568 ! right ventrolateral skeletogenic mesenchyme cluster
relationship: part_of ECAO:2000046 ! embryonic endoskeleton

[Term]
id: ECAO:2000578
name: left ventrolateral spicule granule
def: "A ventrolateral spicule granule that forms on the left side of the embryo." []
is_a: ECAO:2000576 ! ventrolateral spicule granule
relationship: develops_from ECAO:2000569 ! left ventrolateral skeletogenic mesenchyme cluster
relationship: part_of ECAO:2000046 ! embryonic endoskeleton

[Term]
id: ECAO:2000579
name: ventrolateral triradiate spicule rudiment
def: "A triradiate spicule rudiment that forms within a ventrolateral cluster of skeletogenic mesenchyme cells." []
is_a: ECAO:2000574 ! triradiate spicule rudiment
relationship: develops_from ECAO:2000576 ! ventrolateral spicule granule
relationship: part_of ECAO:2000046 ! embryonic endoskeleton

[Term]
id: ECAO:2000580
name: right ventrolateral triradiate spicule rudiment
def: "A ventrolateral triradiate spicule rudiment that forms on the right side of embryo. This rudiment elongates its radii between the vegetal pole and the equator of the embryo along and away from the oral wall of the blastocoel." []
is_a: ECAO:2000579 ! ventrolateral triradiate spicule rudiment
relationship: develops_from ECAO:2000577 ! right ventrolateral spicule granule
relationship: part_of ECAO:2000046 ! embryonic endoskeleton

[Term]
id: ECAO:2000581
name: left ventrolateral triradiate spicule rudiment
def: "A ventrolateral triradiate spicule rudiment that forms on the left side of embryo. This rudiment elongates its radii between the vegetal pole and the equator of the embryo along and away from the oral wall of the blastocoel." []
is_a: ECAO:2000579 ! ventrolateral triradiate spicule rudiment
relationship: develops_from ECAO:2000578 ! left ventrolateral spicule granule
relationship: part_of ECAO:2000046 ! embryonic endoskeleton

[Term]
id: ECAO:2000582
name: presumptive non-skeletogenic mesoderm
