property_value: RO:0002175 NCBITaxon:7668

[Term]
id: ECAO:1000008
name: embryogenesis phase
namespace: echinoderm_developmental_stage
def: "The phase of the life cycle that begins with fertilization, continues with the formation and maturation of the embryo, and ends with the opening of the mouth, the onset of feeding, and the beginning of the growth of the organism." []
synonym: "embryonic phase" RELATED []
xref: UBERON:0000105
