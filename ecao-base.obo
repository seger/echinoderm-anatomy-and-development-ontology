[Term]
id: ECAO:1000009
name: larval development phase
namespace: echinoderm_developmental_stage
def: "The phase of the life cycle that begins when the mouth opens and the larva starts to feed, continues through the growth and maturation of the larva, and ends with metamorphosis." []
is_a: BFO:0000003
is_a: ECAO:1000003 ! life cycle phase
relationship: BFO:0000062 ECAO:1000008 ! embryogenesis phase
