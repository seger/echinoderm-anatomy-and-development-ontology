[Term]
id: ECAO:1000016
name: invagination episode
namespace: echinoderm_developmental_stage
def: "The second episode of the gastrulation period, characterized by the invagination of the vegetal plate into the blastocoel to form the primitive digestive tract (archenteron)." []
