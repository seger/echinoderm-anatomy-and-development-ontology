            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Echinoderm developmental stage at which the embryo is a late blastula, it is still spherical, and the vegetal plate has not formed (late blastula stage).</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000056</oboInOwl:id>
        <rdfs:label>stage 10</rdfs:label>
    </owl:Class>
    


