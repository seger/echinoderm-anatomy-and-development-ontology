                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000062"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000063"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Echinoderm developmental stage at which the embryo has paired coelomic pouches along with a stomodeal invagination and gut constrictions (includes late and very late organogenesis stages).</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000064</oboInOwl:id>
        <rdfs:label>stage 18</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_1000065 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000065">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000046"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000014"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000062"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000064"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Echinoderm developmental stage at which the embryo has an open mouth (open mouth stage).</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000065</oboInOwl:id>
        <rdfs:label>stage 19</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_1000066 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000066">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000007"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Period during which female gametes (or oocytes, or eggs) develop and mature from primordial female germ cells to generate cells competent to further development upon fertilization by a mature spermatozoid.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000066</oboInOwl:id>
        <rdfs:label>oogenesis period</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_1000067 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000067">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000007"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Period during which male gametes (or spermatozoa, or spermatozoid) develop and mature from primordial male germ cells to generate cells competent to further development upon fertilization of a mature oocyte.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000067</oboInOwl:id>
        <rdfs:label>spermatogenesis period</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_1000068 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000068">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000006"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000066"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Stage at which the female gamete is small in size, i.e. about 10 micrometer in diameter, and is in the previtellogenic state.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000068</oboInOwl:id>
        <rdfs:label>previtellogenic primary oocyte stage</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_1000069 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000069">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000006"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000066"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000062"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000068"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Stage at which the developing female gamete has started growing in size by accumulation of yolk proteins, and is characterized by the presence of a large nucleus, the germinal vesicle, which contains a prominent nucleolus and occupies most of the cytoplasm.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000069</oboInOwl:id>
        <rdfs:label>not fully grown oocyte stage</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_1000070 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000070">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000006"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000066"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000062"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000069"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Stage at which the developing female gamete has reached its full size. It has grown up to ten times its original size, i.e. 80 to 100 micrometers. It also displays a large germinal vesicle that is centered, but it is still not competent for fertilization.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000070</oboInOwl:id>
        <rdfs:label>fully grown oocyte with centered germinal vesicle stage</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_1000071 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000071">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000006"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000066"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000062"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000070"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Stage at which the developing female gamete has reached its full size and whose germinal vesicle has moved asymmetrically to the cell periphery. The germinal vesicle is now close to the animal pole.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000071</oboInOwl:id>
        <rdfs:label>fully grown oocyte with off-centered germinal vesicle stage</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_1000072 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000072">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000006"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000066"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000062"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000071"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Stage of the developing female gamete in which the germinal vesicle has broken down. The germinal vesicle is no longer visible. However, the female gamete is still not mature. It is undergoing meiotic maturation, extruding successively a first and a second polar body.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000072</oboInOwl:id>
        <rdfs:label>fully grown oocyte with no nucleus stage</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_1000073 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000073">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000006"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000066"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000062"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000072"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Stage at which the mature female gamete has achieved its meiotic maturation and whose female pronucleus is visible. The mature oocyte is arrested in G1 phase and its average size is 80 to 100 micrometers. It is surrounded by a transparent jelly coat that is about 30 micrometers thick. It is competent to fertilization and is located in the female gonad where it may be stored for weeks to months before its release in sea water by spawning. In the P. lividus species, the mature female gametes are characterized by the presence of pigment granules concentrated in a subequatorial band. This band is classically called the pigment band and allows visualization of the first embryonic axis, i.e. the animal-vegetal axis, which is perpendicular to the band.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000073</oboInOwl:id>
        <rdfs:label>mature oocyte stage</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_1000074 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000074">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000006"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000067"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Stage at which the developing, immature male gamete is undergoing mitosis and meiosis to ultimately produce mature spermatozoa.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000074</oboInOwl:id>
        <rdfs:label>developing spermatozoa stage</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_1000075 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000075">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000006"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000067"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000062"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000074"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Stage at which the mature male gamete is composed of a head, encompassing a compact nucleus, a neck, a middle piece, and a tail (or flagellum) that propels it towards the oocyte upon spawning.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000075</oboInOwl:id>
        <rdfs:label>mature spermatozoid stage</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_1000076 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000076">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000006"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000009"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000062"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000045"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Stage at which the larva is characterized by the presence, on the ventral side, of four extended arms (two anterolateral arms at the level of the oral hood and two postoral arms) and on the dorsal side by a sleeked apex. The larva now possesses a completely tripartite and functional digestive tract composed of an esophagus, a stomach, and an intestine, respectively limited by a cardiac sphincter, a pyloric sphincter, and an anal sphincter.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000076</oboInOwl:id>
        <rdfs:label>4-arm pluteus larva stage</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_1000077 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000077">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000006"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000009"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000062"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000076"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Stage at which the larva is characterized by the presence on the ventral side of six arms, and by the development, on the anterior midline of the esophagus, of the dorsal arch.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000077</oboInOwl:id>
        <rdfs:label>6-arm pluteus larva stage</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_1000078 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000078">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000006"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000009"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000062"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000077"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Stage at which the larva is characterized by the presence on the ventral side of eight arms and by the development within the larva, on the left side of the stomach, of the adult rudiment. This stage is relatively long. It includes distinct changes occurring to the larva as well as within the larva, although the larva consistently exhibits 8 arms.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000078</oboInOwl:id>
        <rdfs:label>8-arm pluteus larva stage</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_1000079 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000079">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000006"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000009"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000062"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000078"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Stage at which the larva is characterized by the presence, within the larva, on the left side of its stomach, of the adult rudiment. The rudiment is now the size of or even bigger than the stomach and harbors five long primary podia (i.e. tube feet) and five quartets of definitive spines. Under the right environemental cue, the larva is competent to undergo metamorphosis.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000079</oboInOwl:id>
        <rdfs:label>competent pluteus larva stage</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_1000080 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000080">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000006"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000009"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000062"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000079"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Stage at which the larva essentially undergoes metamorphsis. The larva goes through drastic morphological changes to transofrm the bilateral, planctonic larva into a benthic, pentaradial juvenile.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000080</oboInOwl:id>
        <rdfs:label>metamorphic larva stage</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_1000081 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000081">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000010"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000062"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000009"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Period during which a young benthic individual, posing as a small adult, grows but remains unable to reproduce.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000081</oboInOwl:id>
        <rdfs:label>juvenile period</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_1000082 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000082">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000006"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000081"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000062"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000080"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Stage at which the animal is morphologically similar to a miniature sea urchin adult. It harbors primary podia (or tube feet) and definitive spines, along with other appendages (e.g., immature spines, pedicellariae). Compare to the adult, however, it is smaller in size, deprived of a functional digestive system, and is sexually immature.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000082</oboInOwl:id>
        <rdfs:label>early juvenile stage</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_1000083 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000083">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000006"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000081"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000062"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000082"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Stage at which the animal still looks like a small adult. Its digestive tract is now functional. However, the late juvenile remains sexually immature.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000083</oboInOwl:id>
        <rdfs:label>late juvenile stage</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_1000084 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000084">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000010"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000062"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000081"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Period during which the animal reaches sexual maturity.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000084</oboInOwl:id>
        <rdfs:label>adult period</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_1000085 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000085">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000006"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000084"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000062"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000083"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Stage which corresponds to a fully formed pentaradial sea urchin individual that has reached sexual maturity. The gonads have developed within the perivisceral cavity and are connected to the outside by the genital pores pierced into the genital plates.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000085</oboInOwl:id>
        <rdfs:label>adult stage</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000000 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000000">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000000"/>
        <obo:IAO_0000115>A biological entity that is either an individual member of a biological species or constitutes the structural organization of an individual member of a biological species.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UBERON:0001062</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>echinoderm anatomical entity</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000000</oboInOwl:id>
        <rdfs:label>anatomy</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000000"/>
        <obo:IAO_0000115>A material anatomical entity that is a single structure with inherent 3D shape generated by coordinated expression of the organism&apos;s own genome.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UBERON:0000061</oboInOwl:hasDbXref>
        <oboInOwl:id>ECAO:2000001</oboInOwl:id>
        <rdfs:label>anatomical structure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000000"/>
        <obo:IAO_0000115>A multicellular, connected anatomical structure composed of multiple organs that work together to achieve some shared function.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UBERON:0000467</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>body system</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>organ system</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000002</oboInOwl:id>
        <rdfs:label>anatomical system</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000003 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000000"/>
        <obo:IAO_0000115>An anatomical structure that is a subdivision of a tissue, a germ layer, or an organ of the whole organism but without well-defined morphological boundaries.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UBERON:0000475</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>organism subdivision</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000003</oboInOwl:id>
        <rdfs:label>anatomical region</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000004 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000000"/>
        <obo:IAO_0000115>A non-material anatomical entity of three dimensions, that is generated by morphogenetic or other physiologic processes, that is surrounded by one or more anatomical structures and may contain one or more organism substances or anatomical structures.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UBERON:0000464</oboInOwl:hasDbXref>
        <oboInOwl:id>ECAO:2000004</oboInOwl:id>
        <rdfs:label>anatomical space</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000005 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000005">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000000"/>
        <obo:IAO_0000115>An anatomical structure that is a subdivision of a tissue, a germ layer, or an organ of the whole organism but with well-defined morphological boundaries.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>anatomical object</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000005</oboInOwl:id>
        <rdfs:label>anatomical element</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000006 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000006">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000001"/>
        <obo:IAO_0000115>An anatomical structure that is an individual member of a species and consists of more than one cell. It includes all forms during all life cycle phases (embryogenesis, larval development, and adulthood).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UBERON:0000468</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>body</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>whole organism</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000006</oboInOwl:id>
        <rdfs:label>multicellular organism</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000007 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000007">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000058"/>
        <obo:IAO_0000115>A diploid cell produced by the fusion of a male and a female gamete at fertilization. It constitutes the first stage of the embryogenesis life cycle phase.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>CL_0010017</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>1-cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>fertilized egg</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000007</oboInOwl:id>
        <rdfs:label>zygote</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000008 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000008">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000006"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#develops_from"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000007"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A multicellular organism at an early stage of development characterized by cleavage, formation of a hollow sphere, or morphogenetic movements. It includes all forms of the embryogenesis life cycle phase.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UBERON:0000922</oboInOwl:hasDbXref>
        <oboInOwl:id>ECAO:2000008</oboInOwl:id>
        <rdfs:label>embryo</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000009 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000009">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000008"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000006"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A multicellular organism at an early stage of development characterized by cleavage. It includes all forms of the cleavage period during the embryogenesis life cycle phase (i.e., from first cleavage to before the formation of the blastula).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UBERON:0007010</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>cleaving embryo</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000009</oboInOwl:id>
        <rdfs:label>cleavage embryo</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000010 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000010">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000008"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#develops_from"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000009"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000006"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A multicellular organism at an early stage of development corresponding to a hollow, spherical, multicellular, monolayered embryo with a hollow cavity (the blastocoel) in the center. It includes all forms of the blastula period during the embryogenesis life cycle phase.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UBERON:0000307</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>morula</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000010</oboInOwl:id>
        <rdfs:label>blastula</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000011 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000011">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000008"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#develops_from"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000010"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000006"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A multicellular organism at an early stage of development characterized by morphogenetic movements. It includes all forms of the gastrula period during the embryogenesis life cycle phase.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UBERON:0004734</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>gastrulating embryo</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000011</oboInOwl:id>
        <rdfs:label>gastrula</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000012 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000012">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000006"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#develops_from"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000008"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A multicellular organism form, which many animals undergo before metamorphosing into adults. It includes all forms of the larval development life cycle phase.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UBERON:0002548</oboInOwl:hasDbXref>
        <oboInOwl:id>ECAO:2000012</oboInOwl:id>
        <rdfs:label>larva</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000013 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000013">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000006"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#develops_from"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000007"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A multicellular organism the existence of which starts at fertilization and ends with metamorphosis. It includes all forms during the embryogenesis and larval development life cycle phases.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>pre-metamorphosing organism</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000013</oboInOwl:id>
        <rdfs:label>pre-metamorphic organism</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000014 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000014">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000006"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#develops_from"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000008"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A multicellular organism the existence of which starts upon the opening of the mouth and ends with death. It includes all forms during the larval development and adulthood life cycle phases.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000014</oboInOwl:id>
        <rdfs:label>post-embryonic organism</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000015 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000015">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000006"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#develops_from"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000012"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A multicellular organism the existence of which starts at metamorphosis and ends with death. It includes all forms during the adulthood life cycle phase.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UBERON:0007023</oboInOwl:hasDbXref>
        <oboInOwl:id>ECAO:2000015</oboInOwl:id>
        <rdfs:label>adult</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000016 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000016">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000006"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#develops_from"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000012"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A multicellular organism the existence of which starts at metamorphosis and ends with gamete production.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UBERON:0034919</oboInOwl:hasDbXref>
        <oboInOwl:id>ECAO:2000016</oboInOwl:id>
        <rdfs:label>juvenile</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000017 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000017">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000006"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#develops_from"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000016"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A multicellular organism the existence of which starts with gamete production and ends with death.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UBERON:0000113</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>post-juvenile adult</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>sexually mature adult</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000017</oboInOwl:id>
        <rdfs:label>mature adult</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000018 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000018">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000003"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000008"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A portion of an embryo (or a population of embryonic cells) that is characterized by a common developmental fate or a common gene expression program but lacks any clear morphological boundaries.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>embryonic territory</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000018</oboInOwl:id>
        <rdfs:label>embryonic region</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000019 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000019">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000003"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000012"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A portion of a larva (or a population of larval cells) that is characterized by a common developmental fate or a common gene expression program but lacks any clear morphological boundaries.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>larval territory</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000019</oboInOwl:id>
        <rdfs:label>larval region</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000020 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000003"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000013"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A population of cells that, throughout the embryogenesis and larval development life cycle phases, is characterized by a common developmental fate or a common gene expression program but lacks any clear morphological boundaries.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>pre-metamorphic territory</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000020</oboInOwl:id>
        <rdfs:label>pre-metamorphic organism region</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000021 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000021">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000001"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000006"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A multicellular anatomical structure composed an aggregate of many similar cells that perform a unique, specific function.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UBERON:0000479</oboInOwl:hasDbXref>
        <oboInOwl:id>ECAO:2000021</oboInOwl:id>
        <rdfs:label>tissue</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000022 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000022">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000005"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000002"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A multicellular anatomical structure made of several tissues, performing a specific function or group of functions.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UBERON:0000062</oboInOwl:hasDbXref>
        <oboInOwl:id>ECAO:2000022</oboInOwl:id>
        <rdfs:label>organ</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000023 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000023">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000021"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000008"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A tissue that is present in an embryo.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UBERON:0005291</oboInOwl:hasDbXref>
        <oboInOwl:id>ECAO:2000023</oboInOwl:id>
        <rdfs:label>embryonic tissue</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000024 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000024">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000021"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000012"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A tissue that is present in a larva.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000024</oboInOwl:id>
        <rdfs:label>larval tissue</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000025 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000025">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000021"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000013"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A tissue that is present in a pre-metamorphic organism.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000025</oboInOwl:id>
        <rdfs:label>pre-metamorphic organism tissue</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000026 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000026">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000001"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000008"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An anatomical structure that is part of an embryo.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UBERON:0002050</oboInOwl:hasDbXref>
        <oboInOwl:id>ECAO:2000026</oboInOwl:id>
        <rdfs:label>embryonic structure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000027 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000027">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000001"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000012"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An anatomical structure that is part of a larva.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000027</oboInOwl:id>
        <rdfs:label>larval structure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000028 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000028">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000001"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000013"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An anatomical structure that is part of a pre-metamorphic organism.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000028</oboInOwl:id>
        <rdfs:label>pre-metamorphic organism structure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000029 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000029">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000002"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000014"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An anatomical system that has as its parts the organs devoted to the ingestion, digestion, and assimilation of food and the discharge of residual wastes.</obo:IAO_0000115>
