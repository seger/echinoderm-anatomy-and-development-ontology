                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000173"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A region of the presumptive ectoderm derived from the animal hemisphere and located between below the animal pole domain ectoderm and above the central ectoderm.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000186</oboInOwl:id>
        <rdfs:label>near apical ectoderm</rdfs:label>
    </owl:Class>
    


