            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A cell tier present in the animal hemisphere of an embryo.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>animal blastomere tier</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000055</oboInOwl:id>
        <rdfs:label>animal cell tier</rdfs:label>
    </owl:Class>
    


