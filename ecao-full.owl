            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000013"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The ectoderm that is specifically present in an embryo and a larva but not in an adult.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000170</oboInOwl:id>
        <rdfs:label>pre-metamorphic organism ectoderm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000171 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000171">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000163"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#develops_from"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The ectoderm that develops in the animal hemisphere of the embryo and is located above the ectoendoderm.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000171</oboInOwl:id>
        <rdfs:label>animal ectoderm</rdfs:label>
    </owl:Class>
    


