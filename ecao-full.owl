        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000005"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
