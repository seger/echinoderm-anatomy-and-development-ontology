                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000052"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The region of the early embryo that will develop into ectoderm.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UBERON:0006601</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>embryonic presumptive ectoderm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000163</oboInOwl:id>
        <rdfs:label>presumptive ectoderm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000164 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000164">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000162"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#develops_from"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000163"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The outermost primary germ layer, which forms during gastrulation and will give rise to tissues such as epithelium and nervous system.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UBERON:0000924</oboInOwl:hasDbXref>
        <oboInOwl:id>ECAO:2000164</oboInOwl:id>
        <rdfs:label>ectoderm</rdfs:label>
    </owl:Class>
    


