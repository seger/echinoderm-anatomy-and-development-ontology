    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000063">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000059"/>
        <obo:IAO_0000115>An immature diploid germ cell precursor that transiently exists in the embryo before entering into close association with the somatic cells of the gonad and becoming irreversibly committed as a germ cell.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>CL:0000670</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>PGC</oboInOwl:hasRelatedSynonym>
