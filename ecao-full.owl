            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The invaginated tube of a gastrula embryo that will give rise to the larval digestive tract.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UBERON:0004735</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>embryonic gut</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>primitive digestive tract</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>primitive gut</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>primordial digestive tube</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000494</oboInOwl:id>
        <rdfs:label>archenteron</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000495 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000495">
