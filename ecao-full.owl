            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Echinoderm developmental stage at which the embryo has hatched from the fertilization envelope and is undergoing the earliest cell movements of gastrulation (includes early, mid-, and late mesenchyme blastula stages and blastopore formation stage).</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000058</oboInOwl:id>
        <rdfs:label>stage 12</rdfs:label>
    </owl:Class>
    


