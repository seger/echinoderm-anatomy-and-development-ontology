            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A thickened region (or placode) at the vegetal pole of the blastula that contains prospective mesoderm and endoderm. The cells of the vegetal plate will be internalized during gastrulation.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>VgP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000492</oboInOwl:id>
        <rdfs:label>vegetal plate</rdfs:label>
    </owl:Class>
    


