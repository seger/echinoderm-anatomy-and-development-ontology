        <oboInOwl:id>ECAO:2000160</oboInOwl:id>
        <rdfs:label>blastocoel roof</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000161 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000161">
