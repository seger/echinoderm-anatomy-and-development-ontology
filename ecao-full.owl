        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000536"/>
        <obo:IAO_0000115>In species with a posterior enterocoel, it is the coelomic pouch that develops at the tip of the archenteron on the left side of the embryo.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>left anterior coelom</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000537</oboInOwl:id>
        <rdfs:label>left anterior coelomic pouch</rdfs:label>
    </owl:Class>
    


