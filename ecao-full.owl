        <obo:IAO_0000115>A group of four cells of equal size forming the vegetal hemisphere of an 8-cell stage embryo.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>quartet of vegetal cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000149</oboInOwl:id>
        <rdfs:label>vegetal quartet</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000150 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000150">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000055"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#develops_from"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000139"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A cell tier derived from the mesomeres through cell division. This cell tier is composed of the animal-most daughter cells of the mesomeres and encompasses 8 cells marking the animal pole of the euechinoid 32- and 64-cell stage embryo.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>an1</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000150</oboInOwl:id>
        <rdfs:label>animal tier 1</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000151 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000151">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000055"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#develops_from"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000139"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A cell tier derived from the mesomeres through cell division. This cell tier is composed of the vegetal-most daughter cells of the mesomeres and encompasses 8 cells located adjacent to and on the vegetal side of the an1 tier of the euechinoid 32- and 64-cell stage embryo.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>an2</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000151</oboInOwl:id>
        <rdfs:label>animal tier 2</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000152 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000152">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000056"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#develops_from"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000147"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A cell tier derived from the macromere daughter tier through cell division. The veg1 tier is composed of the animal-most daughter cells of the macromere daughter tier and is located adjacent to and on the vegetal side of the an2 tier of the euechinoid 56- and 64-cell stage embryo.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>ectoendoderm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>veg1</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000152</oboInOwl:id>
        <rdfs:label>vegetal tier 1</rdfs:label>
    </owl:Class>
    


