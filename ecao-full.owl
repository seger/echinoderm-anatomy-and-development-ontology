    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000051">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000026"/>
        <obo:IAO_0000115>One of two hemispheres of an embryo.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UBERON:0012286</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>hemisphere of embryo</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000051</oboInOwl:id>
        <rdfs:label>embryonic hemisphere</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000052 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000052">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000051"/>
        <obo:IAO_0000115>An anatomical region that corresponds to the upper half of an embryo. Among echinoderms, in euechinoids, during the cleavage period, it is composed of the mesomeres and ultimately encompasses the presumptive ectoderm.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UBERON:0012284</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>animal half</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>upper half</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>upper hemisphere</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000052</oboInOwl:id>
        <rdfs:label>animal hemisphere</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000053 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000053">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000051"/>
        <obo:IAO_0000115>An anatomical region that corresponds to the lower half of an embryo. Among echinoderms, in euechinoids, during the cleavage period, it is composed of the macromeres and the micromeres and ultimately encompasses the presumptive endoderm and mesoderm.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UBERON:0012285</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>lower half</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>lower hemisphere</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>vegetal half</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000053</oboInOwl:id>
        <rdfs:label>vegetal hemisphere</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000054 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000054">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000026"/>
        <obo:IAO_0000115>A layer of blastomeres perpendicular to the animal-vegetal axis of an embryo.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>blastomere tier</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000054</oboInOwl:id>
        <rdfs:label>cell tier</rdfs:label>
    </owl:Class>
    


