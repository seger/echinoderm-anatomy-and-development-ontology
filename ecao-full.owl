            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000553"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A cell that after having undergone epithelial to mesenchymal transition participates in constituting the endoskeleton.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>skeletal cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000554</oboInOwl:id>
        <rdfs:label>skeletogenic mesenchyme cell</rdfs:label>
    </owl:Class>
    


