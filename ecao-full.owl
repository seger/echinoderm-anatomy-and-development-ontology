            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The posterior region of the animal digestive tract that extends from the stomach to the anus.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UBERON:0000160</oboInOwl:hasDbXref>
        <oboInOwl:id>ECAO:2000523</oboInOwl:id>
        <rdfs:label>intestine</rdfs:label>
    </owl:Class>
    


