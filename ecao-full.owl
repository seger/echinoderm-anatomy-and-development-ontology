    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000168">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000164"/>
        <obo:IAO_0000115>The ectoderm that is specifically present in an embryo</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000168</oboInOwl:id>
        <rdfs:label>embryonic ectoderm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000169 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000169">
