        <oboInOwl:hasRelatedSynonym>inner ANE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>inner animal pole domain</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>inner apical pole domain</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000195</oboInOwl:id>
        <rdfs:label>inner anterior neuroectoderm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000196 -->

