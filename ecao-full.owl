            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The orifice at the end of the primary pore canal making the connection between the canal and the external environment.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>primary pore</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000545</oboInOwl:id>
