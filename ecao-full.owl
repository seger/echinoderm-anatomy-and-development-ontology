            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Echinoderm developmental stage at which the embryo is undergoing the first phase of archenteron extension (early gastrula stage).</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000059</oboInOwl:id>
        <rdfs:label>stage 13</rdfs:label>
    </owl:Class>
    


