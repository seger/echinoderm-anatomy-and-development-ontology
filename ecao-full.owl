            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000557"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A cell that is part of the larval skeletogenic mesenchyme and constitutes the larval endoskeleton.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000558</oboInOwl:id>
        <rdfs:label>larval skeletogenic mesenchyme cell</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000559 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000559">
