        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000262"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#develops_from"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000576"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
