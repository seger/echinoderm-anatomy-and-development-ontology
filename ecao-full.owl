        <rdfs:label>immaterial anatomical entity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/CARO_0030000 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/CARO_0030000">
