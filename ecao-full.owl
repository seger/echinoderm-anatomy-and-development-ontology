            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Stage at which the embryo is composed of 32 cells and is surrounded by a fertilization envelope.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000023</oboInOwl:id>
