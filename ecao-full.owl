            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#develops_from"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000176"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The portion of the embryonic ectoderm that is located on the oral side of the embryo and will give rise to ventral ectoderm of the larva.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000177</oboInOwl:id>
        <rdfs:label>oral ectoderm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000178 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000178">
