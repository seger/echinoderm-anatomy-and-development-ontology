            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>In species with a posterior enterocoel, the anterior coelomic pouch is the one that develops from the unpaired coelomic evaginations at the tip of the archenteron.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000536</oboInOwl:id>
        <rdfs:label>anterior coelomic pouch</rdfs:label>
    </owl:Class>
    


