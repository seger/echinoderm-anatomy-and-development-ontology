        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000008"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The skeletogenic mesenchyme that  is specifically present in an embryo and produces the embryonic endoskeleton.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>SM</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>primary mesenchyme</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>skeletogenic mesenchyme</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000555</oboInOwl:id>
        <rdfs:label>embryonic skeletogenic mesenchyme</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000556 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000556">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000554"/>
