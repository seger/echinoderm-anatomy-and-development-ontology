            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Echinoderm developmental stage at which the embryo is undergoing the last phase of archenteron extension (late gastrula stage).</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000061</oboInOwl:id>
        <rdfs:label>stage 15</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_1000062 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000062">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000046"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
