                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000183"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A circumferential band of embryonic presumptive ectoderm or ectoderm located near the equator of the embryo, immediately anterior to the presumptive endoderm or endoderm.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>BE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>posterior ectoderm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>veg1 ectoderm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000184</oboInOwl:id>
        <rdfs:label>border ectoderm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000185 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000185">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000018"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000173"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A region of the presumptive ectoderm derived from the animal hemisphere and that is located below the near-apical ectoderm and above the veg1 ectoderm.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000185</oboInOwl:id>
        <rdfs:label>central ectoderm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000186 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000186">
