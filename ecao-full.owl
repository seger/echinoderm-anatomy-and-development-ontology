            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The anterior end of the animal digestive tract that connects the mouth to the stomach.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UBERON:0001043</oboInOwl:hasDbXref>
        <oboInOwl:id>ECAO:2000521</oboInOwl:id>
        <rdfs:label>esophagus</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000522 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000522">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000030"/>
