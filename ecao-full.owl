        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#develops_from"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000153"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A cell tier derived from the veg2 tier through cell division. The veg2 lower tier is composed of the vegetal-most daughter cells of the veg2 tier and is located adjacent to and on the vegetal side of the veg2 upper tier of euechinoid embryos.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>veg2 lower</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>veg2L</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000157</oboInOwl:id>
        <rdfs:label>vegetal tier 2 lower</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000158 -->

