            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The central region of the animal digestive tract that serves as a digestive organ.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UBERON:0000945</oboInOwl:hasDbXref>
        <oboInOwl:id>ECAO:2000522</oboInOwl:id>
