        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000171"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The ectoderm that is part of the animal ectoderm but located below the apical pole domain ectoderm.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000173</oboInOwl:id>
        <rdfs:label>non-apical ectoderm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000174 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000174">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000018"/>
        <obo:IAO_0000115>A thickened region at the animal hemisphere, located at the animal pole, and that contains developing neurons and cells with elongated cilia.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>animal plate</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>animal pole domain</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>apical plate</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000174</oboInOwl:id>
        <rdfs:label>apical pole domain</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000175 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000175">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000171"/>
