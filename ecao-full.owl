            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A constriction that takes place within a left coelomic pouch.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000535</oboInOwl:id>
        <rdfs:label>left coelomic constriction</rdfs:label>
    </owl:Class>
    


