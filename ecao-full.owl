        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000174"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A cluster of long, immotile cilia associated with the cells constituting the apical pole domain.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000227</oboInOwl:id>
        <rdfs:label>apical tuft</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000228 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000228">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000018"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000164"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A specific embryonic ectodermal territory comprises between the oral and aboral ectoderm and that will give rise to the ciliary band.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>presumptive ciliated band</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>prospective ciliary band</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ridge of thickened ectoderm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000228</oboInOwl:id>
        <rdfs:label>presumptive ciliary band</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000229 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000229">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000018"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000164"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A specific embryonic or larval ectodermal territory located on the oral side and that will give rise to the oral hood ciliary band.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>pre-oral ciliary band</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000229</oboInOwl:id>
        <rdfs:label>presumptive oral ciliary band</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000230 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000230">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000027"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#develops_from"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000228"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A sinuous row of compact, elongated, ciliated, ectodermal cells that is located between the ventral and the dorsal ectoderm and lies on the larval arms.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>ciliated band</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000230</oboInOwl:id>
        <rdfs:label>ciliary band</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000231 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000231">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000058"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#develops_from"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000164"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000228"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A cell that expresses molecular markers of the presumptive ciliary band and will contribute to the ciliary band.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000231</oboInOwl:id>
        <rdfs:label>presumptive ciliary band cell</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000232 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000232">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000058"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000230"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A cell that composes the ciliary band.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000232</oboInOwl:id>
        <rdfs:label>ciliary band cell</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000233 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000233">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000230"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#develops_from"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000229"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The portion of the ciliary band located along the edge of the oral hood, anterior to the mouth.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000233</oboInOwl:id>
        <rdfs:label>oral hood ciliary band</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000234 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000234">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000058"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000233"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A cell that composes the oral hood ciliary band.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000234</oboInOwl:id>
        <rdfs:label>oral hood ciliary band cell</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000235 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000235">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000228"/>
        <obo:IAO_0000115>The portion of the ciliary band that covers the arm buds.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000235</oboInOwl:id>
        <rdfs:label>arm bud ciliary band</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000236 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000236">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000230"/>
        <obo:IAO_0000115>The portion of the ciliary band that outlines a larval arm.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000236</oboInOwl:id>
        <rdfs:label>arm ciliary band</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000237 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000237">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000236"/>
        <obo:IAO_0000115>The portion of the arm ciliary band that covers the arm distal tip.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000237</oboInOwl:id>
        <rdfs:label>arm distal tip ciliary band</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000238 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000238">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000236"/>
        <obo:IAO_0000115>The portion of the arm ciliary band that covers the arm proximal tip.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000238</oboInOwl:id>
        <rdfs:label>arm proximal tip ciliary band</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000239 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000239">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000236"/>
        <obo:IAO_0000115>The portion of the arm ciliary band that covers the region of the arm between the distal and proximal tips.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000239</oboInOwl:id>
        <rdfs:label>arm middle portion ciliary band</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000240 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000240">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000230"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000230"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The portion of the ciliary located between a postoral arm and the oral hood.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000240</oboInOwl:id>
        <rdfs:label>lateral ciliary band</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000241 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000241">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000228"/>
        <obo:IAO_0000115>The portion of the presumptive ciliary band that overlaps with the animal pole domain.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000241</oboInOwl:id>
        <rdfs:label>animal presumptive ciliary band</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000242 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000242">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000228"/>
        <obo:IAO_0000115>The portion of the presumptive ciliary band  located close to the vegetal pole.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000242</oboInOwl:id>
        <rdfs:label>vegetal presumtive ciliary band</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000243 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000243">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000228"/>
        <obo:IAO_0000115>The portion of the presumptive ciliary located between the animal and the vegetal presumptive ciliary bands.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000243</oboInOwl:id>
        <rdfs:label>lateral presumptive ciliary band</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000244 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000244">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000228"/>
        <obo:IAO_0000115>In species with two separate ciliary bands, a specific embryonic territory that will develop into the preoral ciliary band.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000244</oboInOwl:id>
        <rdfs:label>preoral presumptive ciliary band</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000245 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000245">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000228"/>
        <obo:IAO_0000115>In species with two separate ciliary bands, a specific embryonic territory that will develop into the postoral ciliary band.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000245</oboInOwl:id>
        <rdfs:label>postoral presumptive ciliary band</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000246 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000246">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000230"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#develops_from"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000244"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>In species with two separate ciliary bands, a short ciliary band contained in the postoral ciliary band and that encircles the oral hood region, anterior to the mouth.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>anterior ciliary band loop</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000246</oboInOwl:id>
        <rdfs:label>preoral ciliary band</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000247 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000247">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000230"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#develops_from"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000245"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>In species with two separate ciliary bands, a ciliary band that surrounds the entire ventral region of the larva, posterior to the mouth.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>posterior ciliary band loop</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000247</oboInOwl:id>
        <rdfs:label>postoral ciliary band</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000248 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000248">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000001"/>
        <obo:IAO_0000115>A specific ectodermal territory located on the oral side of the embryo or the larva and that will give rise to the oral hood.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>preoral hood</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>preoral lobe</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000248</oboInOwl:id>
        <rdfs:label>pre-oral hood</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000249 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000249">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000001"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000012"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A shelf-like projection on the ventral side of the larva, anterior to the mouth.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>PL</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>oh</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>preoral lobe</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000249</oboInOwl:id>
        <rdfs:label>oral hood</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000250 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000250">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000001"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000012"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>In species with an extensive embryonic skeleton, the apex is the region at tip of the larva on the opposite side of the mouth and where the body rods terminate. In some species it can be marked by the presence of the scheitel.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000250</oboInOwl:id>
        <rdfs:label>apex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000251 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000251">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000001"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000008"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An embryonic region that will develop into an arm.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000251</oboInOwl:id>
        <rdfs:label>arm bud</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000252 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000252">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000001"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000012"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An elongated extension of the larva on the ventral side, supported by a simple smooth or fenestrated skeletal rod and often covered in part by larval epidermis and a ciliary band. Arms develop in all echinoid species in bilaterally symmetrical pairs.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000252</oboInOwl:id>
        <rdfs:label>arm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000253 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000253">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000003"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000252"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The distal extremity of a larval arm, i.e. the further away from the larval body</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000253</oboInOwl:id>
        <rdfs:label>arm distal tip</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000254 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000254">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000003"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000252"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The proximal extremity of a larval arm, i.e. the closest to the larval body</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000254</oboInOwl:id>
        <rdfs:label>arm proximal tip</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000255 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000255">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000003"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000252"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The portion of a larval arm comprised between the distal and proximal tips of the arm.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000255</oboInOwl:id>
        <rdfs:label>arm middle portion</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000256 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000256">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000164"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#develops_from"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000184"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000251"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The thickened ectodermal region that outlines the arm bud.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000256</oboInOwl:id>
        <rdfs:label>arm bud ectoderm</rdfs:label>
