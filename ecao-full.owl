            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A slender, tube-like extending between the left (or left anterior) coelom and the hydropore.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>hydropore canal</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000544</oboInOwl:id>
        <rdfs:label>primary pore canal</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000545 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000545">
