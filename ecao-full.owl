            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The stomach of a larva. In echinoderms, it is the central,  morphologically enlarged compartment of the larval gut.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000524</oboInOwl:id>
        <rdfs:label>larval stomach</rdfs:label>
    </owl:Class>
    


