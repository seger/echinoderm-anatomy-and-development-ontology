        <oboInOwl:hasRelatedSynonym>outer apical pole domain</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000196</oboInOwl:id>
        <rdfs:label>outer anterior neuroectoderm</rdfs:label>
    </owl:Class>
    


