                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000169"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The portion of the ectoderm that is located on the dorsal side of the larva.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>aboral ectoderm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>animal aboral ectoderm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000181</oboInOwl:id>
        <rdfs:label>dorsal ectoderm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000182 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000182">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000003"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#develops_from"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000163"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The portion of the ectoderm that is located between the oral and aboral ectoderm of an embryo or the ventral and dorsal ectoderm of a larva.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>ciliary band ectoderm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>lateral animal ectoderm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000182</oboInOwl:id>
        <rdfs:label>lateral ectoderm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000183 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000183">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000018"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000163"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A transient territory of the embryonic presumptive ectoderm that is located between the apical pole domain ectoderm and the endomesoderm.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000183</oboInOwl:id>
        <rdfs:label>equatorial ectoderm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000184 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000184">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000018"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#develops_from"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000192"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
