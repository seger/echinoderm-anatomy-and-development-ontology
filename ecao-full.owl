        <rdfs:label>macromere descendant cell</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000147 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000147">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000056"/>
