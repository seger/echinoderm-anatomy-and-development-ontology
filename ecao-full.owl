                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000006"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A narrowing (or shrinking) within a tissue or organ to delineate different regions with different fates.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000532</oboInOwl:id>
        <rdfs:label>constriction</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000533 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000533">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000532"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000527"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A constriction taking place at the level of a coelom. It can either separate the coelom from the archenteron or lead to the compartmentalization  of the coelom into distinct regions.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>coelom constriction</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000533</oboInOwl:id>
        <rdfs:label>coelomic constriction</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000534 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000534">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000533"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000530"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A constriction that takes place within a right coelomic pouch.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000534</oboInOwl:id>
        <rdfs:label>right coelomic constriction</rdfs:label>
    </owl:Class>
    


