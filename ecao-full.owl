                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000012"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The skeletogenic mesenchyme that emerges during the larval development phase and participates in the elaboration of the larval endoskeleton.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000557</oboInOwl:id>
        <rdfs:label>larval skeletogenic mesenchyme</rdfs:label>
    </owl:Class>
    


