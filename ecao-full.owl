    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000155">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000056"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#develops_from"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000152"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A cell tier derived from the veg1 tier through cell division. The veg1 lower tier is composed of the vegetal-most daughter cells of the veg1 tier and is located adjacent to and on the vegetal side of the veg1 upper tier of euechinoid embryos.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>veg1 lower</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>veg1L</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000155</oboInOwl:id>
        <rdfs:label>vegetal tier 1 lower</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000156 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000156">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000056"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#develops_from"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000153"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A cell tier derived from the veg2 tier through cell division. The veg2 upper tier is composed of the animal-most daughter cells of the veg2 tier and is located adjacent to and on the vegetal side of the veg1 lower tier of euechinoid embryos.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>veg2 upper</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>veg2U</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000156</oboInOwl:id>
        <rdfs:label>vegetal tier 2 upper</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000157 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000157">
