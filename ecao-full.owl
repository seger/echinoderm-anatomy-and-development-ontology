            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The portion of a cell bearing surface projections such as axons, filopodia, dendrites, cilia, or flagella that includes the nucleus, but excludes all cell projections.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GO:0044297</oboInOwl:hasDbXref>
        <oboInOwl:id>ECAO:2000057</oboInOwl:id>
        <rdfs:label>cell body</rdfs:label>
    </owl:Class>
    


