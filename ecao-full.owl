            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An organ or anatomical element consisting of skeletal tissue. In echinoderms, skeletal elements include for example ossicles, spicules, skeletal rods, teeth, and plates of the adult shell.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UBERON:0004765</oboInOwl:hasDbXref>
        <oboInOwl:id>ECAO:2000049</oboInOwl:id>
