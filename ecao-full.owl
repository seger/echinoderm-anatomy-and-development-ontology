        <rdfs:label>skeletogenic mesoderm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000552 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000552">
