        <oboInOwl:hasRelatedSynonym>vegetal blastomere tier</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000056</oboInOwl:id>
        <rdfs:label>vegetal cell tier</rdfs:label>
    </owl:Class>
    


