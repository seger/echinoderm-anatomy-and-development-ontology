            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Echinoderm developmental stage at which the embryo is undergoing the middle phase of archenteron extension (mid-gastrula stage).</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000060</oboInOwl:id>
        <rdfs:label>stage 14</rdfs:label>
    </owl:Class>
    


