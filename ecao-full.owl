        <oboInOwl:hasRelatedSynonym>anterior archenteron</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>archenteron roof</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>tip of archetron</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000495</oboInOwl:id>
        <rdfs:label>archenteron tip</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000496 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000496">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000026"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
