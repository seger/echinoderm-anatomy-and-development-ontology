            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A circular band of muscles that regulates the constriction or relaxation of a natural body passage or orifice for normal physiological functions.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UBERON:0004590</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>gastrointestinal sphincter</oboInOwl:hasRelatedSynonym>
