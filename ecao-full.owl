            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The portion of the mesenchyme tissue that constitutes the endoskeleton.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000553</oboInOwl:id>
        <rdfs:label>skeletogenic mesenchyme</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000554 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000554">
