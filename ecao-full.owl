            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The dorsoventral connecting rod that forms on the right side of the pre-metamorphic organism.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>rDvcR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000381</oboInOwl:id>
