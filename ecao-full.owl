            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000174"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The ectoderm that is part of the animal ectoderm and is specifically restricted to the apical pole domain.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>apical ectoderm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000175</oboInOwl:id>
        <rdfs:label>apical pole domain ectoderm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000176 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000176">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000018"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000163"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The portion of the presumptive ectoderm that is located on the oral side of the embryo (which will later generate the ventral side of the larva).</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000176</oboInOwl:id>
        <rdfs:label>presumptive oral ectoderm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000177 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000177">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000163"/>
