            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000555"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A cell that is part of the embryonic skeletogenic mesenchyme and constitutes the embryonic endoskeleton.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>PMC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SM cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>primary mesenchyme cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>skeletogenic mesenchyme cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>skeletogenic primary mesenchyme cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000556</oboInOwl:id>
        <rdfs:label>embryonic skeletogenic mesenchyme cell</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000557 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000557">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000553"/>
