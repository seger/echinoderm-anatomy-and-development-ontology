            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000163"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The portion of the presumptive ectoderm that is located on the aboral side of the embryo (which will later generate the dorsal side of the larva).</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>lateral-aboral pre-state ectoderm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000179</oboInOwl:id>
        <rdfs:label>presumptive aboral ectoderm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000180 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000180">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000163"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#develops_from"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000179"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The portion of the embryonic ectoderm that is located on the aboral side of the embryo and will give rise to dorsal ectoderm of the larva.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000180</oboInOwl:id>
        <rdfs:label>aboral ectoderm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000181 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000181">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000019"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#develops_from"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000181"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
