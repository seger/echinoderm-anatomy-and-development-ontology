        </rdfs:subClassOf>
        <obo:IAO_0000115>A cell tier derived from the macromere daughter tier through cell division. The veg2 tier is composed of the vegetal-most daughter cells of the macromere daughter tier and is located adjacent to and on the vegetal side of the veg1 tier of the euechinoid 56- and 64-cell stage embryo.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>endomesoderm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>veg2</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000153</oboInOwl:id>
        <rdfs:label>vegetal tier 2</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000154 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000154">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000056"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#develops_from"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000152"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A cell tier derived from the veg1 tier through cell division. The veg1 upper tier is composed of the animal-most daughter cells of the veg1 tier and is located adjacent to and on the vegetal side of the an2 tier of euechinoid embryos.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>veg1 upper</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>veg1U</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000154</oboInOwl:id>
        <rdfs:label>vegetal tier 1 upper</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000155 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000155">
