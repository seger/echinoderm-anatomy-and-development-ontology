            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Echinoderm developmental stage at which the embryo has paired coelomic evaginations at the tip of the archenteron but lacks a stomodeal invagination and gut constrictions (includes late prism and mid-organogenesis stages).</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000063</oboInOwl:id>
        <rdfs:label>stage 17</rdfs:label>
    </owl:Class>
    


