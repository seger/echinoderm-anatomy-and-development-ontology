                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000088"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A polymer of tubulin that forms part of the cytoskeleton and provides structure and shape to cells.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GO:0005874</oboInOwl:hasDbXref>
        <oboInOwl:id>ECAO:2000091</oboInOwl:id>
