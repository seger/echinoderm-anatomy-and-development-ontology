        <oboInOwl:hasRelatedSynonym>equatorial oral ectoderm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>oral BE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>veg1 oral ectoderm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ventral BE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000187</oboInOwl:id>
        <rdfs:label>oral border ectoderm</rdfs:label>
    </owl:Class>
    


