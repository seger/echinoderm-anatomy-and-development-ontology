        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000087"/>
        <obo:IAO_0000115>The part of the cytoskeleton composed of microtubules and associated proteins.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GO:0015630</oboInOwl:hasDbXref>
        <oboInOwl:id>ECAO:2000088</oboInOwl:id>
