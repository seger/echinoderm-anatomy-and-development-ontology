            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The portion of the oral ectoderm where the stomodeum forms.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UBERON_0014781</oboInOwl:hasDbXref>
