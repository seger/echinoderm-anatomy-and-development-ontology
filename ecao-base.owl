                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000066"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Stage at which the female gamete is small in size, i.e. about 10 micrometer in diameter, and is in the previtellogenic state.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000068</oboInOwl:id>
        <rdfs:label>previtellogenic primary oocyte stage</rdfs:label>
    </owl:Class>
    


