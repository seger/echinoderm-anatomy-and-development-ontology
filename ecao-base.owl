                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000008"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A transient so-called germ layer of the early embryo that will give rise to both endoderm and mesoderm, but not to ectoderm.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>XAO:0003044</oboInOwl:hasDbXref>
