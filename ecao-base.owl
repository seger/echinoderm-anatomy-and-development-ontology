                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000064"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Echinoderm developmental stage at which the embryo has an open mouth (open mouth stage).</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000065</oboInOwl:id>
        <rdfs:label>stage 19</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_1000066 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000066">
