            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Stage at which the embryo is composed of 28 cells and is surrounded by a fertilization envelope.</obo:IAO_0000115>
        <obo:RO_0002161 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_46514"/>
        <obo:RO_0002161 rdf:resource="http://purl.obolibrary.org/obo/NCBITaxon_7632"/>
