        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000081"/>
        <obo:IAO_0000115>A membrane-bounded organelle of in which chromosomes are housed and replicated.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GO:0005634</oboInOwl:hasDbXref>
        <oboInOwl:id>ECAO:2000093</oboInOwl:id>
        <rdfs:label>nucleus</rdfs:label>
    </owl:Class>
    


