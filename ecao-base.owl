            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A cytoskeletal structure that forms during meiotic cell division.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GO:0072687</oboInOwl:hasDbXref>
        <oboInOwl:id>ECAO:2000098</oboInOwl:id>
        <rdfs:label>meiotic spindle</rdfs:label>
    </owl:Class>
    


