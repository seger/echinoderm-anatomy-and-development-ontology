        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000055"/>
        <obo:IAO_0000115>A group of four cells of equal size forming the animal hemisphere of an 8-cell stage embryo.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>quartet of animal cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000148</oboInOwl:id>
        <rdfs:label>animal quartet</rdfs:label>
    </owl:Class>
    


