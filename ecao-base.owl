            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>An intracellular anatomical structure in which the male chromosomes are housed.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GO_0001673</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>male germ cell nucleus</oboInOwl:hasRelatedSynonym>
