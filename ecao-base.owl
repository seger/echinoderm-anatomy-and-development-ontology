            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A layer of cells produced during the early development of an embryo and that is distinct from other such layers of cells, as an early step of cell differentiation.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UBERON_0000923</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>primary germ layer</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000162</oboInOwl:id>
        <rdfs:label>germ layer</rdfs:label>
    </owl:Class>
    


