            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A strand of mesenchyme cells that extends from the left (or left anterior) coelom towards the ectoderm and will give rise to the primary pore canal.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>hydropore canal rudiment</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>presumptive hydropore canal</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000543</oboInOwl:id>
        <rdfs:label>primary pore canal rudiment</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000544 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000544">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000001"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#develops_from"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000543"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
