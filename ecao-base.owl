                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000549"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A multinculeated cell formed by the fusion of individual cells.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>CL:0000228</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>multinucleate cell</oboInOwl:hasRelatedSynonym>
