            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A cell tier derived from the veg2 tier through cell division. The veg2 upper tier is composed of the animal-most daughter cells of the veg2 tier and is located adjacent to and on the vegetal side of the veg1 lower tier of euechinoid embryos.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>veg2 upper</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>veg2U</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000156</oboInOwl:id>
        <rdfs:label>vegetal tier 2 upper</rdfs:label>
    </owl:Class>
    


