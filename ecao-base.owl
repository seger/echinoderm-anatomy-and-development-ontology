                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000561"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The circumferential, syncytial network of embryonic skeletogenic mesenchyme cells that forms between the equator and the vegetal pole of the embryo during gastrulation and surrounds the developing digestive tract.</obo:IAO_0000115>
