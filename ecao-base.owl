    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000050">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000021"/>
        <rdfs:subClassOf>
