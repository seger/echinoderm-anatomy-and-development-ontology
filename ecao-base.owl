        <rdfs:label>oocyte nucleus</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000080 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000080">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000001"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000058"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Any constituent part of a cell that is either an immaterial entity or a material entity with granularity above the level of a protein complex but below that of an anatomical structure.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GO:0110165</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>cell part</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000080</oboInOwl:id>
        <rdfs:label>cellular anatomical entity</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000081 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000081">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000080"/>
        <obo:IAO_0000115>A component of a cell contained within (but not including) the plasma membrane. It includes as examples the nucleus, mitochondria, vesicles, and the cytoskeleton.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GO:0005622</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>intracellular part</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>organelle</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000081</oboInOwl:id>
        <rdfs:label>intracellular anatomical structure</rdfs:label>
    </owl:Class>
    


