    <!-- http://purl.obolibrary.org/obo/ECAO_1000000 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000000">
        <oboInOwl:id>ECAO:1000000</oboInOwl:id>
        <rdfs:label>Echinoderm anatomy and development</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_1000001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000000"/>
        <obo:IAO_0000115>A temporal interval that defines echinoderm life from unfertilized egg to adult stage.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000001</oboInOwl:id>
        <rdfs:label>developmental stage</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_1000002 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000001"/>
        <obo:IAO_0000115>The entire span of an organism&apos;s life.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000002</oboInOwl:id>
        <rdfs:label>life cycle</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_1000003 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000001"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000002"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A temporal phase encompassing some part of the life cycle of an organism.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000003</oboInOwl:id>
        <rdfs:label>life cycle phase</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_1000004 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000001"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000003"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A temporal period included in a life cycle phase.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000004</oboInOwl:id>
        <rdfs:label>life cycle period</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_1000005 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000005">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000001"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000004"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A temporal episode encompassing some part of a life cycle period.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000005</oboInOwl:id>
        <rdfs:label>life cycle episode</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_1000006 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000006">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000001"/>
        <obo:IAO_0000115>A spatiotemporal region encompassing some part of the life cycle of an organism.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000006</oboInOwl:id>
        <rdfs:label>life cycle stage</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_1000007 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000007">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000003"/>
        <obo:IAO_0000115>The phase of the life cycle characterized by the biological process in which certain cells of a female or male individual (parent) are transformed into specialized reproductive cells (gametes) that will initiate development of a progeny individual (offspring) upon fertilization.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000007</oboInOwl:id>
        <rdfs:label>gametogenesis phase</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_1000008 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000008">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000003"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000062"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000007"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The phase of the life cycle that begins with fertilization, continues with the formation and maturation of the embryo, and ends with the opening of the mouth, the onset of feeding, and the beginning of the growth of the organism.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UBERON:0000105</oboInOwl:hasDbXref>
        <oboInOwl:id>ECAO:1000008</oboInOwl:id>
        <rdfs:label>embryogenesis phase</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_1000009 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000009">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000003"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000062"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000008"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The phase of the life cycle that begins when the mouth opens and the larva starts to feed, continues through the growth and maturation of the larva, and ends with metamorphosis.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000009</oboInOwl:id>
        <rdfs:label>larval development phase</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_1000010 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000010">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000003"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000062"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000009"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The phase of the life cycle that begins after metamorphosis, continues through the growth and maturation of the juvenile, and culminates in the formation of a sexually mature adult that produces functional gametes.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000010</oboInOwl:id>
        <rdfs:label>adulthood phase</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_1000011 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000011">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000008"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000062"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000017"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The period that immediately follows fertilization. It is characterized by rapid, synchronous mitotic cell divisions in the absence of cell growth. This period culminates in the formation of a hollow, spherical, multicellular, monolayered embryo (a blastula) with a hollow cavity (the blastocoel) in the center.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UBERON:0000107</oboInOwl:hasDbXref>
        <oboInOwl:id>ECAO:1000011</oboInOwl:id>
        <rdfs:label>cleavage period</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_1000012 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000012">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000008"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000062"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000011"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The period that immediately follows cleavage and precedes gastrulation. It is characterized by the progressive maturation of the embryo into a hollow sphere, which is one cell layer thick and encompasses a central, fluid-filled cavity (the blastocoel). This period culminates in the formation of the vegetal plate, a placode of elongated, presumptive endomesoderm cells.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UBERON:0000307</oboInOwl:hasDbXref>
        <oboInOwl:id>ECAO:1000012</oboInOwl:id>
        <rdfs:label>blastula period</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_1000013 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000013">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000008"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000062"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000012"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The period that immediately follows the blastula period and precedes organogenesis. It is characterized by extensive movements of cells in the vegetal region of the embryo. This period culminates in the formation of a multilayered embryo composed of three primary germ layers (ectoderm, mesoderm, and endoderm).</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UBERON:0000109</oboInOwl:hasDbXref>
        <oboInOwl:id>ECAO:1000013</oboInOwl:id>
        <rdfs:label>gastrula period</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_1000014 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000014">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000008"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000062"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000013"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The period that immediately follows the gastrula period. It is characterized by the progressive maturation of tissues and organs. This period culminates in the opening of the mouth.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000014</oboInOwl:id>
        <rdfs:label>organogenesis period</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_1000015 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000015">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000005"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000013"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000062"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000031"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The first episode of the gastrulation period, characterized by the ingression into the blastocoel of the skeletogenic primary mesenchyme cells (PMCs), prior to the invagination of the vegetal plate.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000015</oboInOwl:id>
        <rdfs:label>mesenchyme blastula episode</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_1000016 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000016">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000005"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000013"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000062"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000015"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The second episode of the gastrulation period, characterized by the invagination of the vegetal plate into the blastocoel to form the primitive digestive tract (archenteron).</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000016</oboInOwl:id>
        <rdfs:label>invagination episode</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_1000017 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000017">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000006"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000047"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000062"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000007"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Stage at which fertilization has occurred, but the zygote has not undergone cell division. The embryo is a single diploid cell surrounded by a fertilization envelope.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UBERON:0000106</oboInOwl:hasDbXref>
        <oboInOwl:id>ECAO:1000017</oboInOwl:id>
        <rdfs:label>1-cell stage</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_1000018 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000018">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000006"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000048"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000062"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000017"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Stage at which the embryo is composed of two cells and is surrounded by a fertilization envelope. The first cleavage division has taken place meridionally (i.e. along the animal-vegetal axis), thereby generating two blastomeres of equal size, each containing both animal and vegetal cytoplasm.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UBERON:0007232</oboInOwl:hasDbXref>
        <oboInOwl:id>ECAO:1000018</oboInOwl:id>
        <rdfs:label>2-cell stage</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_1000019 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000019">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000006"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000049"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000062"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000018"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Stage at which the embryo is composed of four cells and is surrounded by a fertilization envelope. The second cleavage division has taken place meridional and perpendicular to the first cleavage division. This has produced four blastomeres of equal size, all of which contain both animal and vegetal cytoplasm.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UBERON:0007233</oboInOwl:hasDbXref>
        <oboInOwl:id>ECAO:1000019</oboInOwl:id>
        <rdfs:label>4-cell stage</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_1000020 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000006"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000050"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
