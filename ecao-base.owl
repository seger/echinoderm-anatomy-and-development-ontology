        <oboInOwl:hasRelatedSynonym>skeletogenic primary mesenchyme cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000556</oboInOwl:id>
        <rdfs:label>embryonic skeletogenic mesenchyme cell</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000557 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000557">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000553"/>
