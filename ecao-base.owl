                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000048"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A skeletal rod that forms initially from one of the three radii of the embryonic triradiate spicule rudiment and extends toward the animal pole along the oral side of the embryo, before bending or branching to form an anterolateral rod and, in some echinoid species, the recurrent rod.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>DvcR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000380</oboInOwl:id>
        <rdfs:label>dorsoventral connecting rod</rdfs:label>
    </owl:Class>
    


