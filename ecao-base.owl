                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000008"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The inner, extracellular cavity of the embryo that arises at the blastula stage.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>XAO:0000294</oboInOwl:hasDbXref>
        <oboInOwl:id>ECAO:2000159</oboInOwl:id>
