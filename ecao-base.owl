        <rdfs:label>endomesoderm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000194 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000194">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000003"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
