        <oboInOwl:id>ECAO:2000094</oboInOwl:id>
        <rdfs:label>germinal vesicle</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000095 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000095">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000081"/>
        <obo:IAO_0000115>All the contents of a cell excluding the plasma membrane and nucleus, but including all other subcellular structures.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GO:0005737</oboInOwl:hasDbXref>
        <oboInOwl:id>ECAO:2000095</oboInOwl:id>
        <rdfs:label>cytoplasm</rdfs:label>
    </owl:Class>
    


