            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The coelomic pouch present on the left side of the embryo or the larva.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>left coelomic sac</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000531</oboInOwl:id>
        <rdfs:label>left coelomic pouch</rdfs:label>
    </owl:Class>
    


