            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The portion of the presumptive ectoderm and then of the embryonic ectoderm that is located on the most anterior side of the embryo, i.e., within the apical pole domain, and in which neurons will form.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>XAO:0005263</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>ANE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>apical organ</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>presumptive neuroectoderm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000194</oboInOwl:id>
        <rdfs:label>anterior neuroectoderm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000195 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000195">
