    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000082">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000080"/>
        <obo:IAO_0000115>A cell junction that forms a connection between two or more cells of a multicellular organism.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GO:0005911</oboInOwl:hasDbXref>
        <oboInOwl:id>ECAO:2000082</oboInOwl:id>
        <rdfs:label>cell-cell junction</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000083 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000083">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000082"/>
        <obo:IAO_0000115>A strong cell-cell junction usually found in tissue that experience intense mechanical stress.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GO:0030057</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>spot desmosome</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000083</oboInOwl:id>
        <rdfs:label>desmosome</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000084 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000084">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000082"/>
        <obo:IAO_0000115>A cell-cell junction that forms a continuous band around each cell in an epithelium.</obo:IAO_0000115>
