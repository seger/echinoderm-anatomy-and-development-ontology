        <obo:IAO_0000115>The membrane surrounding a cell and separating the cell from its external environment. It consists of a phospholipid bilayer and associated proteins.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GO:0005886</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>cell membrane</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000133</oboInOwl:id>
