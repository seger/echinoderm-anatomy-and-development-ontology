            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A continuous membrane structure present in the cytoplasm and that fulfills multiple functions.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GO:0005783</oboInOwl:hasDbXref>
        <oboInOwl:id>ECAO:2000132</oboInOwl:id>
