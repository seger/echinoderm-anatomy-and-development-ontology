        <oboInOwl:hasRelatedSynonym>unfertilized egg</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000068</oboInOwl:id>
        <rdfs:label>mature oocyte</rdfs:label>
    </owl:Class>
    


