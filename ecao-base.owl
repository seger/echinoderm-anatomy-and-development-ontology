        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000093"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A structure composed of a very long molecule of DNA and associated proteins (e.g. histones) that carries hereditary information.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GO:0005694</oboInOwl:hasDbXref>
        <oboInOwl:id>ECAO:2000131</oboInOwl:id>
        <rdfs:label>chromosome</rdfs:label>
    </owl:Class>
    


