        <oboInOwl:hasRelatedSynonym>quartet of vegetal cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000149</oboInOwl:id>
        <rdfs:label>vegetal quartet</rdfs:label>
    </owl:Class>
    


