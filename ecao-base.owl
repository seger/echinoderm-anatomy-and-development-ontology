            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Echinoderm developmental stage at which the embryo has paired coelomic pouches along with a stomodeal invagination and gut constrictions (includes late and very late organogenesis stages).</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000064</oboInOwl:id>
        <rdfs:label>stage 18</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_1000065 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_1000065">
