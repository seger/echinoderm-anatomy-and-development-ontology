            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A specialized form of connective tissue in which the extracellular matrix is mineralized and that functions in mechanical and structural support.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UBERON:0004755</oboInOwl:hasDbXref>
        <oboInOwl:id>ECAO:2000050</oboInOwl:id>
