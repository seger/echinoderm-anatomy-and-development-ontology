                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000007"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The point on the surface of the ovum where the spermatozoid enters.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>XAO:0000274</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>sperm entry point</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000077</oboInOwl:id>
        <rdfs:label>spermatozoid entry point</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000078 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000078">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000093"/>
