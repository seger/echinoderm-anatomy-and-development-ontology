                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000159"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The region of the blastocoel comprised in the middle region of the embryo, below the blastocoel roof.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000161</oboInOwl:id>
        <rdfs:label>blastocoel wall</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000162 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000162">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000021"/>
