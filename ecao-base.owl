            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The inner, extracellular space between blastomeres of the cleavage stage embryos that will gradually expand and form the blastocoel.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000158</oboInOwl:id>
        <rdfs:label>presumptive blastocoel</rdfs:label>
    </owl:Class>
    


