    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000160 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000160">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000018"/>
