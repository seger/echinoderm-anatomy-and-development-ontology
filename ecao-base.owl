                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_1000019"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Stage at which the embryo is composed of eight cells and is surrounded by a fertilization envelope. The third cleavage division has taken place equatorial and perpendicular to the first two cleavage divisions.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UBERON:0007236</oboInOwl:hasDbXref>
        <oboInOwl:id>ECAO:1000020</oboInOwl:id>
        <rdfs:label>8-cell stage</rdfs:label>
    </owl:Class>
    


