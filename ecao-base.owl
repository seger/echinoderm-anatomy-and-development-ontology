                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000147"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A cell tier derived from the macromere daughter tier through cell division. The veg1 tier is composed of the animal-most daughter cells of the macromere daughter tier and is located adjacent to and on the vegetal side of the an2 tier of the euechinoid 56- and 64-cell stage embryo.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>ectoendoderm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>veg1</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000152</oboInOwl:id>
        <rdfs:label>vegetal tier 1</rdfs:label>
    </owl:Class>
    


