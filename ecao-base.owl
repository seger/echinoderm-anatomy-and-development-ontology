                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000088"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A cytoskeletal structure that forms during mitotic cell division.</obo:IAO_0000115>
