        <oboInOwl:id>ECAO:2000526</oboInOwl:id>
        <rdfs:label>larval intestine</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000527 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000527">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000001"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000006"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A mesodermally lined cavity that in adult is positioned inside the body to surround and contain the digestive tract and other organs, while in embryos and larvae it forms from the tip of the archenteron and lie between the gut and the outer body wall.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>UBERON:0011997</oboInOwl:hasDbXref>
        <oboInOwl:id>ECAO:2000527</oboInOwl:id>
        <rdfs:label>coelom</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000528 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000528">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000001"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#develops_from"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000495"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000008"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The outpocketing of the mesoderm constituting the tip of the archenteron and forming a bilobed bag (or pouch) lying on the top of the archenteron roof.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>unpaire evagination of the coelom</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>unpaired coelomic evaginations</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>unpaired coelomic outpocketing</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>unpaired coelomic pouch</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>unpaired coelomic rudiment</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000528</oboInOwl:id>
        <rdfs:label>coelomic evagination</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000529 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000529">
