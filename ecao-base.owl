        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#develops_from"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000528"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The coelomic pouch present on the right side of the embryo or the larva.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>right coelomic sac</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000530</oboInOwl:id>
        <rdfs:label>right coelomic pouch</rdfs:label>
    </owl:Class>
    


