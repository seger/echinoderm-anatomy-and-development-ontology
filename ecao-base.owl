            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A cell part of the ectoderm germ layer.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>CL:0000221</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>ectodermal cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000165</oboInOwl:id>
        <rdfs:label>ectoderm cell</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000166 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000166">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000021"/>
