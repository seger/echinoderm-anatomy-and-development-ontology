        <oboInOwl:hasRelatedSynonym>syncytial cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>syncytial network</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000559</oboInOwl:id>
        <rdfs:label>syncytium</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000560 -->

