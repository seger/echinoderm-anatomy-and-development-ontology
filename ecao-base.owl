        <oboInOwl:hasRelatedSynonym>germ line stem cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>germline cell</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000059</oboInOwl:id>
        <rdfs:label>germ line cell</rdfs:label>
    </owl:Class>
    


