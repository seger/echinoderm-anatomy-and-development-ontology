        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000080"/>
        <obo:IAO_0000115>The region of a cell that lies just beneath the plasma membrane.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>GO:0005938</oboInOwl:hasDbXref>
        <oboInOwl:id>ECAO:2000100</oboInOwl:id>
        <rdfs:label>cell cortex</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000101 -->

