            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The epidermal tissue of the larva that is on the side opposite to the mouth.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>aboral epidermis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000542</oboInOwl:id>
        <rdfs:label>dorsal epidermis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000543 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000543">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000001"/>
