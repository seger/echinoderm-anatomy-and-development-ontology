                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000168"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000012"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The ectoderm that is specifically present in a larva.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000169</oboInOwl:id>
        <rdfs:label>larval ectoderm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000170 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000170">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000164"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000013"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The ectoderm that is specifically present in an embryo and a larva but not in an adult.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000170</oboInOwl:id>
        <rdfs:label>pre-metamorphic organism ectoderm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000171 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000171">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000163"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#develops_from"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000148"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The ectoderm that develops in the animal hemisphere of the embryo and is located above the ectoendoderm.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000171</oboInOwl:id>
        <rdfs:label>animal ectoderm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000172 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000172">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000163"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#develops_from"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000192"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The ectoderm that specifically derives from cells of the veg1 tier.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>veg1 ecto</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>veg1 ectoderm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000172</oboInOwl:id>
        <rdfs:label>vegetal tier 1  ectoderm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000173 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000173">
