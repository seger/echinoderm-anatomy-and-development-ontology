        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000171"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The ectoderm that is part of the animal ectoderm but located below the apical pole domain ectoderm.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000173</oboInOwl:id>
        <rdfs:label>non-apical ectoderm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000174 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000174">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000018"/>
        <obo:IAO_0000115>A thickened region at the animal hemisphere, located at the animal pole, and that contains developing neurons and cells with elongated cilia.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>animal plate</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>animal pole domain</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>apical plate</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000174</oboInOwl:id>
        <rdfs:label>apical pole domain</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000175 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000175">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000171"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000174"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The ectoderm that is part of the animal ectoderm and is specifically restricted to the apical pole domain.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>apical ectoderm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000175</oboInOwl:id>
        <rdfs:label>apical pole domain ectoderm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000176 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000176">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000018"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000163"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The portion of the presumptive ectoderm that is located on the oral side of the embryo (which will later generate the ventral side of the larva).</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000176</oboInOwl:id>
        <rdfs:label>presumptive oral ectoderm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000177 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000177">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000163"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#develops_from"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000176"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The portion of the embryonic ectoderm that is located on the oral side of the embryo and will give rise to ventral ectoderm of the larva.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000177</oboInOwl:id>
        <rdfs:label>oral ectoderm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000178 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000178">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000019"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#develops_from"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000177"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000169"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The portion of the ectoderm that is on the ventral side of the larva.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>oral animal ectoderm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>oral ectoderm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000178</oboInOwl:id>
        <rdfs:label>ventral ectoderm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000179 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000179">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000018"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#part_of"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000163"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The portion of the presumptive ectoderm that is located on the aboral side of the embryo (which will later generate the dorsal side of the larva).</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>lateral-aboral pre-state ectoderm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:id>ECAO:2000179</oboInOwl:id>
        <rdfs:label>presumptive aboral ectoderm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000180 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000180">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000163"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/ecao#develops_from"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECAO_2000179"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>The portion of the embryonic ectoderm that is located on the aboral side of the embryo and will give rise to dorsal ectoderm of the larva.</obo:IAO_0000115>
        <oboInOwl:id>ECAO:2000180</oboInOwl:id>
        <rdfs:label>aboral ectoderm</rdfs:label>
    </owl:Class>
    


