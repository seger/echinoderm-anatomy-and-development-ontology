            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>Echinoderm developmental stage at which the embryo has completed archenteron elongation and mesenchyme cell ingression is complete (includes early prism and early organogenesis stages).</obo:IAO_0000115>
        <oboInOwl:id>ECAO:1000062</oboInOwl:id>
        <rdfs:label>stage 16</rdfs:label>
    </owl:Class>
    


