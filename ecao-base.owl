            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A characteristic early embryonic cell with a bottle or flask shape.  In some echinoderms, bottle cells are found in the vegetal plate and initiate its invagination at the time of archenteron development.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>CL:0007020</oboInOwl:hasDbXref>
        <oboInOwl:id>ECAO:2000493</oboInOwl:id>
        <rdfs:label>bottle cell</rdfs:label>
    </owl:Class>
    


