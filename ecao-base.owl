        <oboInOwl:id>ECAO:2000086</oboInOwl:id>
        <rdfs:label>cleavage furrow</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/ECAO_2000087 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/ECAO_2000087">
